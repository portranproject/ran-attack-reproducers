+static bool auth_timeout_same_cell_gate_released[MAX_NUM_NR_UE_INST];
+
+static bool auth_timeout_same_cell_gate_open(void)
+{
+  const char *path = getenv("OAI_AUTH_TIMEOUT_GATE_FILE");
+  if (!path || path[0] == '\0')
+    return true;
+  FILE *gate = fopen(path, "r");
+  if (!gate)
+    return false;
+  char mode[6];
+  const bool open = fread(mode, 1, sizeof(mode), gate) == sizeof(mode)
+                    && memcmp(mode, "attack", sizeof(mode)) == 0;
+  fclose(gate);
+  return open;
+}
+
+static unsigned auth_timeout_same_cell_phase_ms(void)
+{
+  const char *value = getenv("OAI_AUTH_TIMEOUT_GATE_PHASE_MS");
+  if (!value || value[0] == '\0')
+    return 0;
+  char *end = NULL;
+  const long phase_ms = strtol(value, &end, 10);
+  return end && end[0] == '\0' && phase_ms >= 0 && phase_ms <= 200 ? (unsigned)phase_ms : 0;
+}
+
+static void auth_timeout_wait_same_cell_gate(int ue)
+{
+  if (ue >= 0 && ue < MAX_NUM_NR_UE_INST && auth_timeout_same_cell_gate_released[ue])
+    return;
+  while (!auth_timeout_same_cell_gate_open())
+    usleep(100000);
+  const unsigned phase_ms = auth_timeout_same_cell_phase_ms();
+  if (phase_ms > 0 && ue >= 0 && ue < 10)
+    usleep((useconds_t)phase_ms * (unsigned)(ue + 1) * 1000U);
+  if (ue >= 0 && ue < MAX_NUM_NR_UE_INST)
+    auth_timeout_same_cell_gate_released[ue] = true;
+}
