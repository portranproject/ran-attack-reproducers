#!/usr/bin/env bash
# rss-broker-witness — independent OAI processes behind an srsRAN GNU Radio
# broker: configurable attackers (or quiet controls) plus ordinary UE
# witness endpoints. Isolated, privately owned ZMQ testbeds only.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONF="${RSS_CONF:-$HERE/conf/rss.conf}"
if [[ -f $CONF ]]; then
  # shellcheck source=/dev/null
  . "$CONF" || { echo "cannot load $CONF" >&2; exit 1; }
fi
if [[ -n ${BROKER_NORMAL_CONF:-} ]]; then
  [[ $BROKER_NORMAL_CONF == /* && -r $BROKER_NORMAL_CONF && -f $BROKER_NORMAL_CONF \
     && ! -L $BROKER_NORMAL_CONF ]] \
    || { echo "BROKER_NORMAL_CONF must be an absolute readable regular non-symlink file" >&2; exit 1; }
  # shellcheck source=/dev/null
  . "$BROKER_NORMAL_CONF" || { echo "cannot load $BROKER_NORMAL_CONF" >&2; exit 1; }
fi

MODE=${1:-}
[[ $MODE == control || $MODE == attack ]] || {
  echo "usage: $0 control|attack -n RUN_ID [-d SECONDS]" >&2
  exit 1
}
shift

RUN_ID=""
DURATION_S=${DURATION_S:-60}
while getopts "n:d:h" opt; do case "$opt" in
  n) RUN_ID=$OPTARG;;
  d) DURATION_S=$OPTARG;;
  h) echo "usage: $0 control|attack -n RUN_ID [-d SECONDS]"; exit 0;;
  *) exit 1;;
esac; done

[[ $RUN_ID =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] \
  || { echo "-n must use letters, digits, '.', '_' or '-'" >&2; exit 1; }
[[ ${RUN_ID:1:1} != O ]] \
  || { echo "run_id second character must not be O (OAI -O parser bug)" >&2; exit 1; }
[[ $DURATION_S =~ ^[1-9][0-9]*$ ]] && (( DURATION_S <= 3600 )) \
  || { echo "-d must be 1..3600" >&2; exit 1; }

OAI=${OAI:-/root/OAI}
UE_BIN=${UE_BIN:-$OAI/cmake_targets/ran_build/build/nr-uesoftmodem}
BROKER_ATTACK_UE_BIN=${BROKER_ATTACK_UE_BIN:-$UE_BIN}
BROKER_WITNESS_UE_BIN=${BROKER_WITNESS_UE_BIN:-${NORMAL_UE_BIN:-$UE_BIN}}
UE_CFG=${UE_CFG:-/root/oai_nrue.conf}
BROKER_ATTACK_UE_CFG=${BROKER_ATTACK_UE_CFG:-$UE_CFG}
BROKER_WITNESS_UE_CFG=${BROKER_WITNESS_UE_CFG:-${NORMAL_UE_CFG:-$UE_CFG}}
UECAP=${UECAP:-$OAI/targets/PROJECTS/GENERIC-NR-5GC/CONF/uecap_ports1.xml}
BROKER_ATTACK_UECAP=${BROKER_ATTACK_UECAP:-$UECAP}
BROKER_WITNESS_UECAP=${BROKER_WITNESS_UECAP:-${NORMAL_UE_UECAP:-$UECAP}}
BROKER_ATTACK_PROCESSES=${BROKER_ATTACK_PROCESSES:-4}
BROKER_RECOVERY_WITNESS_DELAY_MS=${BROKER_RECOVERY_WITNESS_DELAY_MS:-}
BROKER_CONTROL_EXTRA_QUIET_WITNESS=${BROKER_CONTROL_EXTRA_QUIET_WITNESS:-0}
BROKER_SAME_WITNESS_CYCLE=${BROKER_SAME_WITNESS_CYCLE:-0}
RECOVERY_WITNESS_ENABLED=0
[[ -z $BROKER_RECOVERY_WITNESS_DELAY_MS ]] || RECOVERY_WITNESS_ENABLED=1
for value in BROKER_CONTROL_EXTRA_QUIET_WITNESS BROKER_SAME_WITNESS_CYCLE; do
  [[ ${!value} == 0 || ${!value} == 1 ]] \
    || { echo "$value must be 0 or 1" >&2; exit 1; }
done
if (( BROKER_CONTROL_EXTRA_QUIET_WITNESS )); then
  [[ $MODE == control && $BROKER_ATTACK_PROCESSES == 6 ]] \
    || { echo "BROKER_CONTROL_EXTRA_QUIET_WITNESS requires control mode with 6 load processes" >&2; exit 1; }
fi
if (( BROKER_SAME_WITNESS_CYCLE )); then
  [[ $MODE == attack && $BROKER_ATTACK_PROCESSES == 7 ]] \
    || { echo "BROKER_SAME_WITNESS_CYCLE requires attack mode with 7 attack processes" >&2; exit 1; }
  (( RECOVERY_WITNESS_ENABLED == 0 && BROKER_CONTROL_EXTRA_QUIET_WITNESS == 0 )) \
    || { echo "BROKER_SAME_WITNESS_CYCLE cannot use separate recovery or extra quiet witnesses" >&2; exit 1; }
fi
case $BROKER_ATTACK_PROCESSES:$RECOVERY_WITNESS_ENABLED:$BROKER_CONTROL_EXTRA_QUIET_WITNESS in
  1:0:0) DEFAULT_BROKER_PY=$HERE/tools/multi_ue_2ue.py;;
  4:1:0) DEFAULT_BROKER_PY=$HERE/tools/multi_ue_6ue.py;;
  6:0:0) DEFAULT_BROKER_PY=$HERE/tools/multi_ue_7ue.py;;
  6:1:0|6:0:1) DEFAULT_BROKER_PY=$HERE/tools/multi_ue_8ue.py;;
  7:0:0) DEFAULT_BROKER_PY=$HERE/tools/multi_ue_8ue.py;;
  *) DEFAULT_BROKER_PY=$HERE/tools/multi_ue_5ue.py;;
esac
BROKER_PY=${BROKER_PY:-$DEFAULT_BROKER_PY}
BROKER_CMD=${BROKER_CMD:-"exec env QT_QPA_PLATFORM=offscreen python3 '$BROKER_PY'"}
BROKER_LOGDIR=${BROKER_LOGDIR:-/root/rss-broker-runs}
GNB_CONFIG=${GNB_CONFIG:-/root/OCUDU/configs/du.yaml}
GNB_TX_PORT=${GNB_TX_PORT:-2000}
GNB_RX_PORT=${GNB_RX_PORT:-2001}
GNB_STOP_CMD=${GNB_STOP_CMD:-}
GNB_RESTART_CMD=${GNB_RESTART_CMD:-}
GNB_READY_CMD=${GNB_READY_CMD:-}
GNB_SETTLE_S=${GNB_SETTLE_S:-4}
GNB_READY_TIMEOUT_S=${GNB_READY_TIMEOUT_S:-30}
GNB_READY_INTERVAL_S=${GNB_READY_INTERVAL_S:-1}
GNB_READY_PROBE_TIMEOUT_S=${GNB_READY_PROBE_TIMEOUT_S:-5}
WITNESS_DELAY_MS=${WITNESS_DELAY_MS:-5000}
BROKER_ATTACK_MSG4_WAIT=${BROKER_ATTACK_MSG4_WAIT:-1}
BROKER_ATTACK_MAX_DURATION_S=${BROKER_ATTACK_MAX_DURATION_S:-0}
BROKER_ATTACK_START_DELAY_MS=${BROKER_ATTACK_START_DELAY_MS:-0}
BROKER_ATTACK_START_STRIDE_MS=${BROKER_ATTACK_START_STRIDE_MS:-0}
BROKER_ATTACK_PHASE_MS=${BROKER_ATTACK_PHASE_MS:-0}
BROKER_ATTACK_UES_PER_PROCESS=${BROKER_ATTACK_UES_PER_PROCESS:-1}
BROKER_WITNESS_UES=${BROKER_WITNESS_UES:-1}
BROKER_WITNESS_RSS=${BROKER_WITNESS_RSS:-1}
BROKER_WITNESS_MULTI_RU=${BROKER_WITNESS_MULTI_RU:-0}
BROKER_NORMAL_POOL_QUALIFICATION=${BROKER_NORMAL_POOL_QUALIFICATION:-0}
BROKER_NORMAL_HEALTH_TIMEOUT_S=${BROKER_NORMAL_HEALTH_TIMEOUT_S:-120}
BROKER_NORMAL_ATTACK_DURATION_S=${BROKER_NORMAL_ATTACK_DURATION_S:-30}
BROKER_NORMAL_PDU_SESSION_ID=${BROKER_NORMAL_PDU_SESSION_ID:-}
BROKER_WITNESS_PHASE_MS=${BROKER_WITNESS_PHASE_MS:-0}
BROKER_WITNESS_RETRY_MS=${BROKER_WITNESS_RETRY_MS:-1000}
BROKER_WITNESS_HONOR_REJECT=${BROKER_WITNESS_HONOR_REJECT:-0}
BROKER_START_GNB_LAST=${BROKER_START_GNB_LAST:-0}
MULTI_RU_CONFIG=${MULTI_RU_CONFIG:-$HERE/../authentication-timeout-exhaustion/analysis/multi_ru_config.py}
if (( BROKER_NORMAL_POOL_QUALIFICATION )); then
  BROKER_ATTACK_UE_BIN=${NORMAL_UE_ATTACK_BIN:-$BROKER_ATTACK_UE_BIN}
  GNB_CONFIG=${NORMAL_UE_GNB_CONFIG:-$GNB_CONFIG}
  GNB_STOP_CMD=${NORMAL_UE_GNB_STOP_CMD:-$GNB_STOP_CMD}
  GNB_RESTART_CMD=${NORMAL_UE_GNB_RESTART_CMD:-$GNB_RESTART_CMD}
  GNB_READY_CMD=${NORMAL_UE_GNB_READY_CMD:-$GNB_READY_CMD}
fi
UE_BEFORE_BROKER_S=${UE_BEFORE_BROKER_S:-3}
BROKER_ENDPOINT_READY_TIMEOUT_S=${BROKER_ENDPOINT_READY_TIMEOUT_S:-30}
BROKER_SYNC_TIMEOUT_S=${BROKER_SYNC_TIMEOUT_S:-30}
BAND=${BAND:-78}
DL_FREQ=${DL_FREQ:-3489420000}
NUMEROLOGY=${NUMEROLOGY:-1}
PRB=${PRB:-51}
DEVICE=${DEVICE:-oai_zmqdevif}
GW=${GW:-10.45.1.1}
IFACE=${IFACE:-oaitun_ue1}
PING_SIZE=${PING_SIZE:-64}
PING_INTERVAL=${PING_INTERVAL:-0.2}
FLOCK_BIN=${FLOCK_BIN:-flock}
IP_CMD=${IP_CMD:-ip}
PING_CMD=${PING_CMD:-ping}
TIMEOUT_BIN=${TIMEOUT_BIN:-timeout}
LOCK_FILE=${LOCK_FILE:-/tmp/rss-broker-witness.lock}
USE_SETSID=${USE_SETSID:-1}
SETSID_BIN=${SETSID_BIN:-setsid}

for value in WITNESS_DELAY_MS BROKER_ATTACK_MAX_DURATION_S BROKER_ATTACK_START_DELAY_MS BROKER_ATTACK_START_STRIDE_MS GNB_SETTLE_S UE_BEFORE_BROKER_S; do
  [[ ${!value} =~ ^[0-9]+$ ]] || { echo "$value must be a non-negative integer" >&2; exit 1; }
done
for value in BROKER_ATTACK_MSG4_WAIT BROKER_WITNESS_HONOR_REJECT BROKER_START_GNB_LAST; do
  [[ ${!value} == 0 || ${!value} == 1 ]] || { echo "$value must be 0 or 1" >&2; exit 1; }
done
for value in BROKER_WITNESS_RSS BROKER_WITNESS_MULTI_RU BROKER_NORMAL_POOL_QUALIFICATION; do
  [[ ${!value} == 0 || ${!value} == 1 ]] \
    || { echo "$value must be 0 or 1" >&2; exit 1; }
done
(( BROKER_ATTACK_MAX_DURATION_S <= 86400 )) \
  || { echo "BROKER_ATTACK_MAX_DURATION_S must be 0..86400" >&2; exit 1; }
[[ $BROKER_ATTACK_PHASE_MS =~ ^[0-9]+$ ]] && (( BROKER_ATTACK_PHASE_MS <= 5000 )) \
  || { echo "BROKER_ATTACK_PHASE_MS must be 0..5000" >&2; exit 1; }
[[ $BROKER_ATTACK_UES_PER_PROCESS =~ ^[1-9][0-9]*$ ]] && (( BROKER_ATTACK_UES_PER_PROCESS <= 16 )) \
  || { echo "BROKER_ATTACK_UES_PER_PROCESS must be 1..16" >&2; exit 1; }
[[ $BROKER_WITNESS_UES =~ ^[1-9][0-9]*$ ]] && (( BROKER_WITNESS_UES <= 16 )) \
  || { echo "BROKER_WITNESS_UES must be 1..16" >&2; exit 1; }
[[ $BROKER_WITNESS_PHASE_MS =~ ^[0-9]+$ ]] && (( BROKER_WITNESS_PHASE_MS <= 5000 )) \
  || { echo "BROKER_WITNESS_PHASE_MS must be 0..5000" >&2; exit 1; }
[[ $BROKER_WITNESS_RETRY_MS =~ ^[0-9]+$ ]] && (( BROKER_WITNESS_RETRY_MS >= 10 && BROKER_WITNESS_RETRY_MS <= 60000 )) \
  || { echo "BROKER_WITNESS_RETRY_MS must be 10..60000" >&2; exit 1; }
[[ $BROKER_ATTACK_PROCESSES == 1 || $BROKER_ATTACK_PROCESSES == 4 || $BROKER_ATTACK_PROCESSES == 6 \
   || $BROKER_ATTACK_PROCESSES == 7 ]] \
  || { echo "BROKER_ATTACK_PROCESSES must be 1, 4, 6 or 7" >&2; exit 1; }
if [[ $BROKER_ATTACK_PROCESSES == 7 && $MODE == attack ]] && (( BROKER_SAME_WITNESS_CYCLE == 0 )); then
  echo "7 attack processes require BROKER_SAME_WITNESS_CYCLE=1" >&2
  exit 1
fi
ATTACK_LAST_STOP_MS=$((BROKER_ATTACK_START_DELAY_MS + (BROKER_ATTACK_PROCESSES - 1) * BROKER_ATTACK_START_STRIDE_MS + BROKER_ATTACK_MAX_DURATION_S * 1000))
if (( RECOVERY_WITNESS_ENABLED )); then
  [[ $BROKER_ATTACK_PROCESSES == 4 || $BROKER_ATTACK_PROCESSES == 6 ]] \
    || { echo "recovery witness prelaunch requires 4 or 6 attack processes" >&2; exit 1; }
  [[ $MODE == attack ]] \
    || { echo "BROKER_RECOVERY_WITNESS_DELAY_MS requires attack mode" >&2; exit 1; }
  [[ $BROKER_RECOVERY_WITNESS_DELAY_MS =~ ^[0-9]+$ ]] \
    || { echo "BROKER_RECOVERY_WITNESS_DELAY_MS must be a non-negative integer" >&2; exit 1; }
  (( BROKER_ATTACK_MAX_DURATION_S > 0 )) \
    || { echo "BROKER_RECOVERY_WITNESS_DELAY_MS requires BROKER_ATTACK_MAX_DURATION_S > 0" >&2; exit 1; }
  (( BROKER_RECOVERY_WITNESS_DELAY_MS > ATTACK_LAST_STOP_MS )) \
    || { echo "BROKER_RECOVERY_WITNESS_DELAY_MS must be after every attacker stops" >&2; exit 1; }
  (( BROKER_RECOVERY_WITNESS_DELAY_MS < DURATION_S * 1000 )) \
    || { echo "BROKER_RECOVERY_WITNESS_DELAY_MS must fall within the run duration" >&2; exit 1; }
fi
if (( BROKER_SAME_WITNESS_CYCLE )); then
  (( BROKER_ATTACK_MAX_DURATION_S > 0 )) \
    || { echo "BROKER_SAME_WITNESS_CYCLE requires BROKER_ATTACK_MAX_DURATION_S > 0" >&2; exit 1; }
  (( BROKER_WITNESS_HONOR_REJECT == 1 )) \
    || { echo "BROKER_SAME_WITNESS_CYCLE requires BROKER_WITNESS_HONOR_REJECT=1" >&2; exit 1; }
fi
if (( !BROKER_WITNESS_RSS && (RECOVERY_WITNESS_ENABLED || BROKER_CONTROL_EXTRA_QUIET_WITNESS || BROKER_SAME_WITNESS_CYCLE) )); then
  echo "BROKER_WITNESS_RSS=0 supports only the primary normal-UE pool" >&2
  exit 1
fi
if (( BROKER_WITNESS_MULTI_RU )); then
  [[ $MODE == attack || $BROKER_ATTACK_PROCESSES == 1 || $BROKER_NORMAL_POOL_QUALIFICATION == 1 ]] \
    || { echo "BROKER_WITNESS_MULTI_RU control mode requires one quiet load process" >&2; exit 1; }
  (( RECOVERY_WITNESS_ENABLED == 0 && BROKER_CONTROL_EXTRA_QUIET_WITNESS == 0 && BROKER_SAME_WITNESS_CYCLE == 0 )) \
    || { echo "BROKER_WITNESS_MULTI_RU supports only the primary normal-UE pool" >&2; exit 1; }
fi
NORMAL_RECOVERY_DEADLINE_S=90
NORMAL_REQUIRED_DURATION_MS=0
if (( BROKER_NORMAL_POOL_QUALIFICATION )); then
  [[ $BROKER_ATTACK_PROCESSES == 6 && $BROKER_ATTACK_UES_PER_PROCESS == 2
     && $BROKER_WITNESS_MULTI_RU == 1 && $BROKER_WITNESS_UES == 5
     && $BROKER_WITNESS_RSS == 1 ]] \
    || { echo "normal-pool qualification requires 6x2 load UEs and one 5-UE independent-RU witness" >&2; exit 1; }
  [[ $BROKER_NORMAL_HEALTH_TIMEOUT_S =~ ^[1-9][0-9]*$ ]] \
    || { echo "BROKER_NORMAL_HEALTH_TIMEOUT_S must be a positive integer" >&2; exit 1; }
  [[ $BROKER_NORMAL_ATTACK_DURATION_S =~ ^[1-9][0-9]*$ ]] && (( BROKER_NORMAL_ATTACK_DURATION_S <= 300 )) \
    || { echo "BROKER_NORMAL_ATTACK_DURATION_S must be 1..300" >&2; exit 1; }
  grep -Faq OAI_NORMAL_TUN_SUFFIX "$BROKER_WITNESS_UE_BIN" \
    || { echo "normal-pool qualification requires normal-tun-suffix.patch in the witness UE binary" >&2; exit 1; }
  NORMAL_REQUIRED_DURATION_MS=$(((BROKER_NORMAL_HEALTH_TIMEOUT_S + BROKER_NORMAL_ATTACK_DURATION_S + NORMAL_RECOVERY_DEADLINE_S) * 1000))
  (( DURATION_S * 1000 >= NORMAL_REQUIRED_DURATION_MS )) || {
    required_s=$(((NORMAL_REQUIRED_DURATION_MS + 999) / 1000))
    echo "normal-pool qualification requires -d >= $required_s seconds for 5/5 startup, attack, and 90-second recovery" >&2
    exit 1
  }
fi
ROLE_ATTACK_MAX_DURATION_S=$BROKER_ATTACK_MAX_DURATION_S
ROLE_ATTACK_START_DELAY_MS=$BROKER_ATTACK_START_DELAY_MS
ROLE_ATTACK_START_STRIDE_MS=$BROKER_ATTACK_START_STRIDE_MS
if (( BROKER_NORMAL_POOL_QUALIFICATION )); then
  ROLE_ATTACK_MAX_DURATION_S=0
  ROLE_ATTACK_START_DELAY_MS=0
  ROLE_ATTACK_START_STRIDE_MS=0
fi
WITNESS_PROCESSES=$((1 + RECOVERY_WITNESS_ENABLED + BROKER_CONTROL_EXTRA_QUIET_WITNESS))
TOTAL_UE_PROCESSES=$((BROKER_ATTACK_PROCESSES + WITNESS_PROCESSES))
BROKER_ENDPOINTS=$TOTAL_UE_PROCESSES
(( BROKER_WITNESS_MULTI_RU == 0 )) || BROKER_ENDPOINTS=$((BROKER_ENDPOINTS + BROKER_WITNESS_UES - 1))
PLANNED_UE_PROCESS_STARTS=$TOTAL_UE_PROCESSES
WITNESS_INDEX=$((BROKER_ATTACK_PROCESSES + 1))
RECOVERY_WITNESS_INDEX=-1
(( RECOVERY_WITNESS_ENABLED == 0 )) || RECOVERY_WITNESS_INDEX=$TOTAL_UE_PROCESSES
CONTROL_EXTRA_QUIET_WITNESS_INDEX=-1
(( BROKER_CONTROL_EXTRA_QUIET_WITNESS == 0 )) || CONTROL_EXTRA_QUIET_WITNESS_INDEX=$TOTAL_UE_PROCESSES
ATTACK_LOGICAL_UES=$((BROKER_ATTACK_PROCESSES * BROKER_ATTACK_UES_PER_PROCESS))
WITNESS_LOGICAL_UES=$((BROKER_WITNESS_UES + RECOVERY_WITNESS_ENABLED + BROKER_CONTROL_EXTRA_QUIET_WITNESS))
SAME_WITNESS_MIN_MSG3_TX=10
SAME_WITNESS_MIN_DISTINCT_TC_RNTI=10
SAME_WITNESS_MIN_MSG3_SPAN_MS=30000
SAME_WITNESS_RECOVERY_DEADLINE_S=30
SAME_WITNESS_MIN_PING_TX=20
SAME_WITNESS_PING_BUDGET_MS=0
SAME_WITNESS_REQUIRED_DURATION_MS=0
if (( BROKER_SAME_WITNESS_CYCLE )); then
  if ! PING_INTERVAL_MS=$(awk -v value="$PING_INTERVAL" 'BEGIN {
      if (value !~ /^([0-9]+([.][0-9]*)?|[.][0-9]+)$/ || value + 0 <= 0) exit 1
      milliseconds = (value + 0) * 1000
      rounded = int(milliseconds)
      if (rounded < milliseconds) rounded++
      if (rounded < 1) rounded = 1
      print rounded
    }'); then
    echo "PING_INTERVAL must be a positive decimal in same-witness-cycle mode" >&2
    exit 1
  fi
  SAME_WITNESS_PING_BUDGET_MS=$((SAME_WITNESS_MIN_PING_TX * PING_INTERVAL_MS))
  SAME_WITNESS_REQUIRED_DURATION_MS=$((ATTACK_LAST_STOP_MS + SAME_WITNESS_RECOVERY_DEADLINE_S * 1000 + SAME_WITNESS_PING_BUDGET_MS))
  (( DURATION_S * 1000 >= SAME_WITNESS_REQUIRED_DURATION_MS )) || {
    required_s=$(((SAME_WITNESS_REQUIRED_DURATION_MS + 999) / 1000))
    echo "same-witness-cycle requires -d >= $required_s seconds for attacker stop, recovery, and ping evidence" >&2
    exit 1
  }
fi
for value in GNB_READY_TIMEOUT_S GNB_READY_INTERVAL_S GNB_READY_PROBE_TIMEOUT_S BROKER_ENDPOINT_READY_TIMEOUT_S BROKER_SYNC_TIMEOUT_S; do
  [[ ${!value} =~ ^[1-9][0-9]*$ ]] || { echo "$value must be a positive integer" >&2; exit 1; }
done
[[ $DEVICE == oai_zmqdevif ]] \
  || { echo "DEVICE=$DEVICE is unsupported: the broker witness is ZMQ-only" >&2; exit 1; }
[[ -x $BROKER_ATTACK_UE_BIN && -x $BROKER_WITNESS_UE_BIN ]] \
  || { echo "missing attack or witness UE binary" >&2; exit 1; }
[[ -f $BROKER_ATTACK_UE_CFG && -f $BROKER_WITNESS_UE_CFG && -f $BROKER_ATTACK_UECAP \
   && -f $BROKER_WITNESS_UECAP && -f $BROKER_PY && -f $GNB_CONFIG ]] \
  || { echo "missing UE config, capability, broker, or gNB config" >&2; exit 1; }
(( BROKER_WITNESS_MULTI_RU == 0 )) || [[ -f $MULTI_RU_CONFIG && ! -L $MULTI_RU_CONFIG ]] \
  || { echo "missing multi-RU runtime config generator" >&2; exit 1; }
BROKER_LAST_TX=$((2001 + 100 * BROKER_ENDPOINTS))
BROKER_LAST_RX=$((2000 + 100 * BROKER_ENDPOINTS))
if ! { grep -q ":$BROKER_LAST_TX" "$BROKER_PY" && grep -q ":$BROKER_LAST_RX" "$BROKER_PY"; } \
   && ! grep -q "NORMAL_UE_BROKER_ENDPOINTS" "$BROKER_PY"; then
  if (( BROKER_WITNESS_MULTI_RU )); then
    echo "broker does not expose endpoint $BROKER_ENDPOINTS ports $BROKER_LAST_TX/$BROKER_LAST_RX" >&2
  else
    echo "broker does not expose UE $TOTAL_UE_PROCESSES ports $BROKER_LAST_TX/$BROKER_LAST_RX" >&2
  fi
  exit 1
fi
[[ -n $GNB_STOP_CMD && -n $GNB_RESTART_CMD && -n $GNB_READY_CMD ]] \
  || { echo "GNB_STOP_CMD, GNB_RESTART_CMD and GNB_READY_CMD are required" >&2; exit 1; }
command -v "$FLOCK_BIN" >/dev/null || { echo "missing flock: $FLOCK_BIN" >&2; exit 1; }
command -v "$IP_CMD" >/dev/null || { echo "missing ip command: $IP_CMD" >&2; exit 1; }
command -v "$PING_CMD" >/dev/null || { echo "missing ping: $PING_CMD" >&2; exit 1; }
command -v "$TIMEOUT_BIN" >/dev/null || { echo "missing timeout: $TIMEOUT_BIN" >&2; exit 1; }
if (( USE_SETSID )); then
  command -v "$SETSID_BIN" >/dev/null || { echo "missing setsid: $SETSID_BIN" >&2; exit 1; }
fi

grep -Eq "tx_port=tcp://[^, ]*:${GNB_TX_PORT}([, ]|$)" "$GNB_CONFIG" \
  || { echo "gNB TX must use broker port $GNB_TX_PORT" >&2; exit 1; }
grep -Eq "rx_port=tcp://[^, ]*:${GNB_RX_PORT}([, ]|$)" "$GNB_CONFIG" \
  || { echo "gNB RX must use broker port $GNB_RX_PORT" >&2; exit 1; }

if (( BROKER_NORMAL_POOL_QUALIFICATION )); then
  if [[ -z $BROKER_NORMAL_PDU_SESSION_ID ]]; then
    BROKER_NORMAL_PDU_SESSION_ID=$(python3 - "$BROKER_WITNESS_UE_CFG" "$BROKER_WITNESS_UES" <<'PY'
import pathlib
import re
import sys

text = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8")
blocks = re.findall(r"(?ms)^\s*uicc\d+\s*=\s*\{.*?(?=^\s*uicc\d+\s*=|\Z)", text)[:int(sys.argv[2])]
ids = []
for block in blocks:
    sessions = re.search(r"(?s)pdu_sessions\s*=\s*\((.*?)\)\s*;", block)
    match = sessions and re.search(r"\bid\s*=\s*(\d+)", sessions.group(1))
    if not match:
        raise SystemExit("normal UE PDU session id를 읽지 못했습니다")
    ids.append(int(match.group(1)))
if len(ids) != int(sys.argv[2]) or len(set(ids)) != 1:
    raise SystemExit("normal UE 5대의 PDU session id가 없거나 서로 다릅니다")
print(ids[0])
PY
    ) || { echo "normal UE PDU session id 검증에 실패했습니다" >&2; exit 1; }
  fi
  [[ $BROKER_NORMAL_PDU_SESSION_ID =~ ^[1-9][0-9]*$ && $BROKER_NORMAL_PDU_SESSION_ID -le 255 ]] \
    || { echo "BROKER_NORMAL_PDU_SESSION_ID must be 1..255" >&2; exit 1; }
fi

mkdir -p -- "$BROKER_LOGDIR"
exec 9>"$LOCK_FILE"
"$FLOCK_BIN" -n 9 || { echo "another broker witness run is active" >&2; exit 1; }
OUT="$BROKER_LOGDIR/$RUN_ID"
mkdir -- "$OUT" \
  || { echo "cannot create $OUT — existing results are never overwritten" >&2; exit 1; }
BROKER_CONTROL_FILE=$OUT/broker-control
if (( BROKER_NORMAL_POOL_QUALIFICATION )); then
  printf 'standby\n' >"$BROKER_CONTROL_FILE"
fi

RECOVERY_ROLE_JSON=""
if (( RECOVERY_WITNESS_ENABLED )); then
  RECOVERY_ROLE_JSON=",\"recovery_witness\":{\"processes\":1,\"ues_per_process\":1,\"msg4_wait\":1,\"max_duration_s\":0,\"delay_ms\":$BROKER_RECOVERY_WITNESS_DELAY_MS,\"phase_ms\":0,\"honor_reject\":1,\"prelaunched\":true,\"endpoint_index\":$RECOVERY_WITNESS_INDEX}"
fi
CONTROL_EXTRA_ROLE_JSON=""
if (( BROKER_CONTROL_EXTRA_QUIET_WITNESS )); then
  CONTROL_EXTRA_ROLE_JSON=",\"control_extra_quiet_witness\":{\"processes\":1,\"ues_per_process\":1,\"prelaunched\":true,\"quiet_for_whole_run\":true,\"endpoint_index\":$CONTROL_EXTRA_QUIET_WITNESS_INDEX}"
fi
SAME_WITNESS_ROLE_JSON=""
if (( BROKER_SAME_WITNESS_CYCLE )); then
  SAME_WITNESS_ROLE_JSON=",\"same_witness_cycle\":{\"enabled\":true,\"endpoint_index\":$WITNESS_INDEX,\"min_msg3_tx\":$SAME_WITNESS_MIN_MSG3_TX,\"min_distinct_nonzero_tc_rnti\":$SAME_WITNESS_MIN_DISTINCT_TC_RNTI,\"min_msg3_span_ms\":$SAME_WITNESS_MIN_MSG3_SPAN_MS,\"recovery_deadline_s\":$SAME_WITNESS_RECOVERY_DEADLINE_S,\"min_ping_transmitted\":$SAME_WITNESS_MIN_PING_TX,\"required_ping_loss_pct\":0,\"expected_last_attacker_stop_ms\":$ATTACK_LAST_STOP_MS,\"ping_budget_ms\":$SAME_WITNESS_PING_BUDGET_MS,\"required_duration_ms\":$SAME_WITNESS_REQUIRED_DURATION_MS}"
fi
MULTI_RU_TOPOLOGY_JSON=""
(( BROKER_WITNESS_MULTI_RU == 0 )) || MULTI_RU_TOPOLOGY_JSON=",\"zmq_endpoints\":$BROKER_ENDPOINTS"
NORMAL_POOL_ROLE_JSON=""
if (( BROKER_NORMAL_POOL_QUALIFICATION )); then
  NORMAL_POOL_ROLE_JSON=",\"normal_pool\":{\"enabled\":true,\"ues\":5,\"same_du_cell\":true,\"pdu_session_id\":$BROKER_NORMAL_PDU_SESSION_ID,\"health_timeout_s\":$BROKER_NORMAL_HEALTH_TIMEOUT_S,\"attack_duration_s\":$BROKER_NORMAL_ATTACK_DURATION_S,\"recovery_deadline_s\":$NORMAL_RECOVERY_DEADLINE_S,\"required_duration_ms\":$NORMAL_REQUIRED_DURATION_MS,\"clocked_attack_slots\":true,\"uplink_gate\":\"broker\",\"direct_detector_input\":false,\"ue_to_ran_path_required\":true}"
fi

PIDS=()
GROUPED=()
CHILD_REAPED=()
INITIAL_UE_PIDS=()
UE_CHILD_INDEXES=()
CHILD_EXIT_STATUS=()
CHILD_FORCED_KILL=()
BROKER_INDEX=-1
STOPPED=0
PING_PID=""
MULTI_RU_RUNTIME_CFG=""

start_child() {
  local log=$1
  shift
  if (( USE_SETSID )); then
    "$SETSID_BIN" "$@" 9>&- >"$log" 2>&1 </dev/null &
    GROUPED+=(1)
  else
    "$@" 9>&- >"$log" 2>&1 </dev/null &
    GROUPED+=(0)
  fi
  LAST_PID=$!
  PIDS+=("$LAST_PID")
  LAST_CHILD_INDEX=$((${#PIDS[@]} - 1))
  CHILD_REAPED[$LAST_CHILD_INDEX]=0
}

is_running() {
  local pid=$1 state
  kill -0 "$pid" 2>/dev/null || return 1
  state=$(ps -o stat= -p "$pid" 2>/dev/null | tr -d ' ')
  [[ -n $state && $state != Z* ]]
}

count() {
  local pattern=$1 file=$2 value
  value=$(grep -c -- "$pattern" "$file" 2>/dev/null || true)
  echo "${value:-0}"
}

boundary_metrics() {
  python3 - "$1" <<'PY'
import json
import sys

attempt_times = []
identities = set()
msg3_times = []
tc_rntis = set()
with open(sys.argv[1], encoding="utf-8") as source:
    for line in source:
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        event = row.get("event")
        timestamp = row.get("t_ns")
        if event == "attempt_start":
            if isinstance(timestamp, int) and timestamp > 0:
                attempt_times.append(timestamp)
            identity = row.get("ue_identity")
            if isinstance(identity, str) and identity:
                identities.add(identity)
        elif event == "msg3_tx":
            if isinstance(timestamp, int) and timestamp > 0:
                msg3_times.append(timestamp)
            tc_rnti = row.get("tc_rnti")
            try:
                tc_rnti = int(tc_rnti, 0) if isinstance(tc_rnti, str) else int(tc_rnti)
            except (TypeError, ValueError):
                tc_rnti = 0
            if tc_rnti:
                tc_rntis.add(tc_rnti)

def timing(values):
    first = min(values) if values else 0
    last = max(values) if values else 0
    span_ms = (last - first) // 1_000_000 if len(values) > 1 else 0
    return first, last, span_ms

attempt_first, attempt_last, attempt_span_ms = timing(attempt_times)
msg3_first, msg3_last, msg3_span_ms = timing(msg3_times)
print(len(attempt_times), len(identities), attempt_first, attempt_last, attempt_span_ms,
      len(msg3_times), len(tc_rntis), msg3_first, msg3_last, msg3_span_ms)
PY
}

count_sync_ues() {
  local i synced=0 current expected
  for ((i=1; i<=TOTAL_UE_PROCESSES; i++)); do
    expected=1
    (( BROKER_WITNESS_MULTI_RU == 0 || i != WITNESS_INDEX )) || expected=$BROKER_WITNESS_UES
    current=$(count "Initial sync successful" "$OUT/ue${i}.log")
    (( current <= expected )) || current=$expected
    synced=$((synced + current))
  done
  echo "$synced"
}

count_quiet_attackers() {
  local i quiet=0
  for ((i=1; i<=BROKER_ATTACK_PROCESSES; i++)); do
    if (( $(count '"event":"kill_switch"' "$OUT/ue${i}.jsonl") > 0 )); then
      quiet=$((quiet + 1))
    fi
  done
  echo "$quiet"
}

count_attacker_attempts() {
  local i attempts=0
  for ((i=1; i<=BROKER_ATTACK_PROCESSES; i++)); do
    attempts=$((attempts + $(count '"event":"attempt_start"' "$OUT/ue${i}.jsonl")))
  done
  echo "$attempts"
}

count_attacker_msg3() {
  local i msg3=0
  for ((i=1; i<=BROKER_ATTACK_PROCESSES; i++)); do
    msg3=$((msg3 + $(count '"event":"msg3_tx"' "$OUT/ue${i}.jsonl")))
  done
  echo "$msg3"
}

normal_pool_health() {
  local i iface ok=0
  for ((i=1; i<=BROKER_WITNESS_UES; i++)); do
    iface="oaitun_ue${i}p${BROKER_NORMAL_PDU_SESSION_ID}"
    "$IP_CMD" -4 -o addr show "$iface" >/dev/null 2>&1 \
      && "$PING_CMD" -n -I "$iface" -c 1 -W 1 "$GW" >/dev/null 2>&1 \
      && ok=$((ok + 1)) || true
  done
  echo "$ok"
}

record_normal_pool_health() {
  local phase=$1 i iface tun_ok ping_ok timestamp
  timestamp=$(date +%s%N)
  for ((i=1; i<=BROKER_WITNESS_UES; i++)); do
    iface="oaitun_ue${i}p${BROKER_NORMAL_PDU_SESSION_ID}"
    tun_ok=false
    ping_ok=false
    if "$IP_CMD" -4 -o addr show "$iface" >/dev/null 2>&1; then
      tun_ok=true
      "$PING_CMD" -n -I "$iface" -c 1 -W 1 "$GW" >/dev/null 2>&1 && ping_ok=true || true
    fi
    printf '{"schema":"same-cell.normal-health.v1","run_id":"%s","phase":"%s","realtime_ns":%s,"ue":%d,"interface":"%s","tun_ok":%s,"ping_ok":%s}\n' \
      "$RUN_ID" "$phase" "$timestamp" "$i" "$iface" "$tun_ok" "$ping_ok" \
      >>"$OUT/normal-health.jsonl"
  done
}

select_persistent_attack() {
  local mode=$1 before started=$SECONDS count slots="1,2,3,4,5,6"
  [[ $mode == standby || $mode == warmup || $mode == attack ]] || return 1
  if [[ $mode == standby ]]; then
    printf 'standby\n' >"$BROKER_CONTROL_FILE"
  else
    printf '%s %s\n' "$mode" "$slots" >"$BROKER_CONTROL_FILE"
  fi
  before=$(count '^SAME_CELL_SLOT_SELECTION ' "$OUT/broker.log")
  kill -USR1 "$BROKER_PID" || return 1
  while :; do
    grep -q '^SAME_CELL_SLOT_SELECTION_FAILED ' "$OUT/broker.log" 2>/dev/null && return 1
    count=$(count '^SAME_CELL_SLOT_SELECTION ' "$OUT/broker.log")
    (( count > before )) && return 0
    is_running "$BROKER_PID" || return 1
    (( SECONDS - started < BROKER_ENDPOINT_READY_TIMEOUT_S )) || return 1
    sleep .1
  done
}

ping_received_now() {
  local file=$1 received
  received=$(awk '/packets transmitted/{value=$4} END{print value}' "$file" 2>/dev/null || true)
  if [[ -n $received ]]; then
    echo "$received"
  else
    received=$(grep -Ec 'bytes from' "$file" 2>/dev/null || true)
    echo "${received:-0}"
  fi
}

ping_metrics() {
  local file=$1 ok=0 tx=0 rx=0 loss=null rtt=null
  if [[ -s $file ]] && grep -Eq '[1-9][0-9]* received' "$file"; then
    ok=1
  fi
  if [[ -s $file ]]; then
    tx=$(awk '/packets transmitted/{print $1; exit}' "$file")
    rx=$(awk '/packets transmitted/{print $4; exit}' "$file")
    loss=$(awk -F', ' '/packet loss/{for(i=1;i<=NF;i++) if($i ~ /packet loss/){sub(/% packet loss.*/, "", $i); print $i; exit}}' "$file")
    rtt=$(awk -F'= ' '/min\/avg\/max/{split($2, a, "/"); gsub(/[[:space:]]/, "", a[2]); print a[2]; exit}' "$file")
  fi
  printf '%s %s %s %s %s\n' "$ok" "${tx:-0}" "${rx:-0}" "${loss:-null}" "${rtt:-null}"
}

all_active_ues_running() {
  local pid
  for pid in "${INITIAL_UE_PIDS[@]}"; do
    is_running "$pid" || return 1
  done
}

GNB_RESTARTED=0
stop_gnb() {
  (( GNB_RESTARTED )) || return 0
  bash -c "$GNB_STOP_CMD" 9>&- >>"$OUT/gnb_stop.txt" 2>&1 </dev/null || true
  GNB_RESTARTED=0
}
stop_children() {
  (( STOPPED == 0 )) || return 0
  STOPPED=1
  if [[ -n $PING_PID ]]; then
    kill -INT "$PING_PID" 2>/dev/null || true
    wait "$PING_PID" 2>/dev/null || true
  fi
  local i pid target status forced alive
  for ((i=${#PIDS[@]}-1; i>=0; i--)); do
    (( ${CHILD_REAPED[$i]:-0} == 0 )) || continue
    pid=${PIDS[$i]}
    target=$pid
    (( GROUPED[$i] )) && target="-$pid"
    kill -INT -- "$target" 2>/dev/null || true
  done
  # OAI w38 deliberately uses the first INT/TERM for NAS deregistration and
  # prints "Press ^C again".  A second signal is its supported immediate-stop
  # path.  The old one-signal/one-second sequence either crashed in init_RA or
  # forced every UE through SIGKILL.  The GNU Radio broker needs only one INT.
  sleep 0.2
  for i in "${UE_CHILD_INDEXES[@]}"; do
    (( ${CHILD_REAPED[$i]:-0} == 0 )) || continue
    pid=${PIDS[$i]}
    target=$pid
    (( GROUPED[$i] )) && target="-$pid"
    is_running "$pid" && kill -INT -- "$target" 2>/dev/null || true
  done
  for _ in {1..25}; do
    alive=0
    for i in "${!PIDS[@]}"; do
      (( ${CHILD_REAPED[$i]:-0} == 0 )) || continue
      pid=${PIDS[$i]}
      if is_running "$pid"; then
        alive=1
        break
      fi
    done
    (( alive )) || break
    sleep 0.2
  done
  for ((i=${#PIDS[@]}-1; i>=0; i--)); do
    (( ${CHILD_REAPED[$i]:-0} == 0 )) || continue
    pid=${PIDS[$i]}
    target=$pid
    (( GROUPED[$i] )) && target="-$pid"
    forced=0
    if is_running "$pid"; then
      forced=1
      kill -KILL -- "$target" 2>/dev/null || true
    fi
    if wait "$pid" 2>/dev/null; then
      status=0
    else
      status=$?
    fi
    CHILD_EXIT_STATUS[$i]=$status
    CHILD_FORCED_KILL[$i]=$forced
    CHILD_REAPED[$i]=1
  done
}
cleanup() {
  local status=$?
  trap - EXIT INT TERM
  stop_children
  stop_gnb
  [[ -z $MULTI_RU_RUNTIME_CFG ]] || unlink "$MULTI_RU_RUNTIME_CFG" 2>/dev/null || true
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

if pgrep -x nr-uesoftmodem >/dev/null 2>&1; then
  echo "an existing nr-uesoftmodem is running; refusing to touch it" >&2
  exit 1
fi

cat >"$OUT/run.json" <<EOF
{"type":"broker_witness_run","run_id":"$RUN_ID","mode":"$MODE",
 "duration_s":$DURATION_S,"witness_delay_ms":$WITNESS_DELAY_MS,"broker_sync_timeout_s":$BROKER_SYNC_TIMEOUT_S,
 "topology":{"attack_or_quiet_processes":$BROKER_ATTACK_PROCESSES,"attack_or_quiet_ues":$ATTACK_LOGICAL_UES,"witness_processes":$WITNESS_PROCESSES,"witness_ues":$WITNESS_LOGICAL_UES,"ue_processes":$TOTAL_UE_PROCESSES,"planned_ue_process_starts":$PLANNED_UE_PROCESS_STARTS$MULTI_RU_TOPOLOGY_JSON,"gnb_tx_port":$GNB_TX_PORT,"gnb_rx_port":$GNB_RX_PORT},
 "roles":{"attacker":{"processes":$BROKER_ATTACK_PROCESSES,"ues_per_process":$BROKER_ATTACK_UES_PER_PROCESS,"msg4_wait":$BROKER_ATTACK_MSG4_WAIT,"max_duration_s":$ROLE_ATTACK_MAX_DURATION_S,"start_delay_ms":$ROLE_ATTACK_START_DELAY_MS,"start_stride_ms":$ROLE_ATTACK_START_STRIDE_MS,"phase_ms":$BROKER_ATTACK_PHASE_MS,"honor_reject":0},
          "control_load":{"processes":$BROKER_ATTACK_PROCESSES,"ues_per_process":$BROKER_ATTACK_UES_PER_PROCESS,"msg4_wait":1,"max_duration_s":0,"phase_ms":0,"honor_reject":0},
          "witness":{"processes":1,"ues_per_process":$BROKER_WITNESS_UES,"msg4_wait":1,"max_duration_s":0,"phase_ms":0,"honor_reject":$BROKER_WITNESS_HONOR_REJECT}$RECOVERY_ROLE_JSON$CONTROL_EXTRA_ROLE_JSON$SAME_WITNESS_ROLE_JSON$NORMAL_POOL_ROLE_JSON},
 "t_start_utc":"$(date -u +%FT%TZ)"}
EOF

echo "== stopping gNB"
if ! bash -c "$GNB_STOP_CMD" 9>&- >"$OUT/gnb_stop.txt" 2>&1 </dev/null; then
  echo "gNB stop failed" >&2
  exit 1
fi
(( GNB_SETTLE_S == 0 )) || sleep "$GNB_SETTLE_S"

"$IP_CMD" addr flush dev "$IFACE" >/dev/null 2>&1 || true

restart_gnb() {
  echo "== restarting gNB"
  if ! bash -c "$GNB_RESTART_CMD" 9>&- >"$OUT/gnb_boot.txt" 2>&1 </dev/null; then
    echo "gNB restart failed" >&2
    return 1
  fi
  GNB_RESTARTED=1
  local ready=0 ready_started=$SECONDS
  : >"$OUT/gnb_ready.txt"
  while (( SECONDS - ready_started < GNB_READY_TIMEOUT_S )); do
    if "$TIMEOUT_BIN" --signal=TERM --kill-after=1 "${GNB_READY_PROBE_TIMEOUT_S}s" \
         bash -c "$GNB_READY_CMD" 9>&- >>"$OUT/gnb_ready.txt" 2>&1 </dev/null; then
      ready=1
      break
    fi
    sleep "$GNB_READY_INTERVAL_S"
  done
  (( ready )) || { echo "gNB readiness failed" >&2; return 1; }
}

(( BROKER_START_GNB_LAST )) || restart_gnb || exit 1

COMMON=(--band "$BAND" -C "$DL_FREQ" --numerology "$NUMEROLOGY" -r "$PRB"
        -E --ue-scan-carrier --device.name "$DEVICE")
RSS_COMMON=(--rss.enable 1 --rss.interval_ms 0 --rss.completion_pct 0
        --rss.ack_gate 1 --rss.ra_gate 1 --rss.gate_timeout_ms 500
        --rss.target_occupancy 0 --rss.hold_ms 2000 --rss.msg4_ack 1
        )
# Keep control load UEs quiet across both the startup gate and observation.
QUIET_DELAY_MS=$(((BROKER_SYNC_TIMEOUT_S + DURATION_S + 60) * 1000))

if (( BROKER_WITNESS_MULTI_RU )); then
  MULTI_RU_RUNTIME_CFG="$OUT/witness-runtime.conf"
  python3 "$MULTI_RU_CONFIG" "$BROKER_WITNESS_UE_CFG" "$MULTI_RU_RUNTIME_CFG" \
    "$BROKER_WITNESS_UES" "$((WITNESS_INDEX - 1))"
fi

echo "== launching $BROKER_ATTACK_PROCESSES $MODE processes and $WITNESS_PROCESSES ordinary witness process(es)"
UE_LAUNCH_STARTED=$SECONDS
for ((i=1; i<=TOTAL_UE_PROCESSES; i++)); do
  tx=$((2001 + 100 * i))
  rx=$((2000 + 100 * i))
  ROLE_ARGS=()
  ROLE_NUM_UES=$BROKER_ATTACK_UES_PER_PROCESS
  ROLE_CFG=$BROKER_ATTACK_UE_CFG
  ROLE_BIN=$BROKER_ATTACK_UE_BIN
  ROLE_UECAP=$BROKER_ATTACK_UECAP
  ROLE_USES_RSS=1
  if (( i == WITNESS_INDEX )); then
    ROLE_NUM_UES=$BROKER_WITNESS_UES
    ROLE_CFG=$BROKER_WITNESS_UE_CFG
    ROLE_BIN=$BROKER_WITNESS_UE_BIN
    ROLE_UECAP=$BROKER_WITNESS_UECAP
    ROLE_USES_RSS=$BROKER_WITNESS_RSS
    [[ -z $MULTI_RU_RUNTIME_CFG ]] || ROLE_CFG=$MULTI_RU_RUNTIME_CFG
    if (( ROLE_USES_RSS )); then
      ROLE_ARGS=(--num-ues "$ROLE_NUM_UES" --rss.max_duration_s 0 --rss.honor_reject "$BROKER_WITNESS_HONOR_REJECT"
                 --rss.msg4_wait 1 --rss.probe_ues "$ROLE_NUM_UES" --rss.probe_delay_ms "$WITNESS_DELAY_MS"
                 --rss.probe_ra_only 0 --rss.probe_interval_ms "$BROKER_WITNESS_RETRY_MS"
                 --rss.phase_ms "$BROKER_WITNESS_PHASE_MS")
    else
      ROLE_ARGS=(--num-ues "$ROLE_NUM_UES")
    fi
  elif (( RECOVERY_WITNESS_ENABLED && i == RECOVERY_WITNESS_INDEX )); then
    ROLE_NUM_UES=1
    ROLE_CFG=$BROKER_WITNESS_UE_CFG
    ROLE_BIN=$BROKER_WITNESS_UE_BIN
    ROLE_UECAP=$BROKER_WITNESS_UECAP
    ROLE_ARGS=(--num-ues 1 --rss.max_duration_s 0 --rss.honor_reject 1
               --rss.msg4_wait 1 --rss.probe_ues 1 --rss.probe_delay_ms "$BROKER_RECOVERY_WITNESS_DELAY_MS"
               --rss.probe_ra_only 0 --rss.probe_interval_ms 1000 --rss.phase_ms 0)
  elif (( BROKER_CONTROL_EXTRA_QUIET_WITNESS && i == CONTROL_EXTRA_QUIET_WITNESS_INDEX )); then
    ROLE_NUM_UES=1
    ROLE_CFG=$BROKER_WITNESS_UE_CFG
    ROLE_BIN=$BROKER_WITNESS_UE_BIN
    ROLE_UECAP=$BROKER_WITNESS_UECAP
    ROLE_ARGS=(--num-ues 1 --rss.max_duration_s 0 --rss.honor_reject 0 --rss.msg4_wait 1
               --rss.probe_ues 1 --rss.probe_delay_ms "$QUIET_DELAY_MS"
               --rss.probe_ra_only 0 --rss.probe_interval_ms 1000 --rss.phase_ms 0)
  elif [[ $MODE == control ]]; then
    ROLE_ARGS=(--num-ues "$ROLE_NUM_UES" --rss.max_duration_s 0 --rss.honor_reject 0 --rss.msg4_wait 1
               --rss.probe_ues "$ROLE_NUM_UES" --rss.probe_delay_ms "$QUIET_DELAY_MS"
               --rss.probe_ra_only 0 --rss.probe_interval_ms 1000 --rss.phase_ms 0)
  else
    ATTACK_DELAY_MS=$((ROLE_ATTACK_START_DELAY_MS + (i - 1) * ROLE_ATTACK_START_STRIDE_MS))
    ROLE_ARGS=(--num-ues "$ROLE_NUM_UES" --rss.max_duration_s "$ROLE_ATTACK_MAX_DURATION_S" --rss.honor_reject 0
               --rss.msg4_wait "$BROKER_ATTACK_MSG4_WAIT" --rss.probe_ues "$ROLE_NUM_UES"
               --rss.probe_delay_ms "$ATTACK_DELAY_MS" --rss.probe_ra_only 1 --rss.probe_interval_ms 10
               --rss.phase_ms "$BROKER_ATTACK_PHASE_MS")
  fi
  ROLE_RUN_ID="u${i}-$RUN_ID"
  (( i != RECOVERY_WITNESS_INDEX )) || ROLE_RUN_ID+=-recovery
  (( i != CONTROL_EXTRA_QUIET_WITNESS_INDEX )) || ROLE_RUN_ID+=-control-extra-quiet
  ROLE_TAIL=()
  ROLE_RSS_ARGS=()
  ROLE_ZMQ_ARGS=('--zmq.[0].tx_channels' "tcp://127.0.0.1:$tx"
                 '--zmq.[0].rx_channels' "tcp://127.0.0.1:$rx")
  if (( ROLE_USES_RSS )); then
    ROLE_RSS_ARGS=("${RSS_COMMON[@]}")
    ROLE_TAIL=(--rss.run_id "$ROLE_RUN_ID" --rss.log_file "$OUT/ue${i}.jsonl")
  else
    : >"$OUT/ue${i}.jsonl"
  fi
  (( BROKER_WITNESS_MULTI_RU == 0 || i != WITNESS_INDEX )) || ROLE_ZMQ_ARGS=()
  ROLE_ENV=(env RSS_SHARE_NUE="$ROLE_NUM_UES")
  if (( BROKER_NORMAL_POOL_QUALIFICATION && i <= BROKER_ATTACK_PROCESSES )); then
    ROLE_ENV+=(RSS_BROKER_CONTROL_FILE="$BROKER_CONTROL_FILE")
  fi
  if (( BROKER_NORMAL_POOL_QUALIFICATION && i == WITNESS_INDEX )); then
    ROLE_ENV+=(OAI_NORMAL_TUN_SUFFIX=1)
  fi
  start_child "$OUT/ue${i}.log" "${ROLE_ENV[@]}" "$ROLE_BIN" -O "$ROLE_CFG" "${COMMON[@]}" \
    --uecap_file "$ROLE_UECAP" \
    "${ROLE_RSS_ARGS[@]}" "${ROLE_ZMQ_ARGS[@]}" "${ROLE_ARGS[@]}" "${ROLE_TAIL[@]}"
  INITIAL_UE_PIDS+=("$LAST_PID")
  UE_CHILD_INDEXES+=("$LAST_CHILD_INDEX")
done

# OAI's ZMQ TX side is a REP endpoint.  If the flowgraph starts first, its
# REQ source can still be completing the handshake when OAI makes its first
# write, leaving OAI with zero configured TX channels and an assertion.  The
# proven-stable order is to let every UE bind its REP endpoint first; without
# downlink samples they wait safely until the broker starts.
(( UE_BEFORE_BROKER_S == 0 )) || sleep "$UE_BEFORE_BROKER_S"
ENDPOINT_READY_DEADLINE=$((SECONDS + BROKER_ENDPOINT_READY_TIMEOUT_S))
ENDPOINT_EARLY_EXIT=0
while :; do
  ENDPOINTS_READY=0
  for ((i=1; i<=TOTAL_UE_PROCESSES; i++)); do
    expected=1
    (( BROKER_WITNESS_MULTI_RU == 0 || i != WITNESS_INDEX )) || expected=$BROKER_WITNESS_UES
    ready=$(count "TX socket for antenna 0 bound to" "$OUT/ue${i}.log")
    (( ready < expected )) || ENDPOINTS_READY=$((ENDPOINTS_READY + expected))
  done
  (( ENDPOINTS_READY == BROKER_ENDPOINTS )) && break
  if ! all_active_ues_running; then
    echo "UE exited before its ZMQ endpoint was ready" >&2
    ENDPOINT_EARLY_EXIT=1
    break
  fi
  (( SECONDS < ENDPOINT_READY_DEADLINE )) \
    || { echo "$ENDPOINTS_READY/$BROKER_ENDPOINTS UE ZMQ endpoints ready after ${BROKER_ENDPOINT_READY_TIMEOUT_S}s" >&2; exit 1; }
  sleep 0.2
done
echo "== starting the broker after all $TOTAL_UE_PROCESSES OAI endpoints"
if (( BROKER_NORMAL_POOL_QUALIFICATION )); then
  start_child "$OUT/broker.log" env NORMAL_UE_BROKER_ATTACK_SLOTS=6 \
    NORMAL_UE_BROKER_PERSISTENT_ATTACK=1 NORMAL_UE_BROKER_CONTROL="$BROKER_CONTROL_FILE" \
    bash -c "$BROKER_CMD"
else
  start_child "$OUT/broker.log" bash -c "$BROKER_CMD"
fi
BROKER_PID=$LAST_PID
BROKER_INDEX=$((${#PIDS[@]} - 1))

if (( BROKER_START_GNB_LAST )); then
  restart_gnb || exit 1
fi

EARLY_EXIT=$ENDPOINT_EARLY_EXIT
BROKER_EARLY_EXIT=0
for pid in "${INITIAL_UE_PIDS[@]}"; do
  if ! is_running "$pid"; then
    echo "UE exited during startup" >&2
    EARLY_EXIT=1
  fi
done

SYNC_READY=0
SYNC_TIMED_OUT=0
SYNC_COUNT=0
SYNC_WAIT_STARTED=$SECONDS
SYNC_DEADLINE=$((SYNC_WAIT_STARTED + BROKER_SYNC_TIMEOUT_S))
while :; do
  if ! is_running "$BROKER_PID"; then
    BROKER_EARLY_EXIT=1
  fi
  for pid in "${INITIAL_UE_PIDS[@]}"; do
    if ! is_running "$pid"; then
      EARLY_EXIT=1
    fi
  done
  SYNC_COUNT=$(count_sync_ues)
  if (( SYNC_COUNT == BROKER_ENDPOINTS )); then
    SYNC_READY=1
    break
  fi
  if (( BROKER_EARLY_EXIT || EARLY_EXIT )); then
    break
  fi
  if (( SECONDS >= SYNC_DEADLINE )); then
    SYNC_TIMED_OUT=1
    echo "$BROKER_ENDPOINTS-endpoint sync timed out after ${BROKER_SYNC_TIMEOUT_S}s" >&2
    break
  fi
  sleep 1
done
SYNC_AT_GATE=$SYNC_COUNT
SYNC_WAIT_S=$((SECONDS - SYNC_WAIT_STARTED))

STARTED=$SECONDS
DEADLINE=$((STARTED + DURATION_S))
WITNESS_ATTACHED=0
WITNESS_ATTACH_S=-1
RECOVERY_ATTACHED=0
RECOVERY_ATTACH_S=-1
RECOVERY_STARTED=0
RECOVERY_START_S=-1
RECOVERY_QUIET_MISSING=0
RECOVERY_ATTACKERS_QUIET=0
RECOVERY_PRE_ATTACK_ATTEMPTS=0
RECOVERY_PRE_PHASE_ATTEMPTS=0
PRIMARY_ATTACK_WINDOW_FROZEN=0
PRIMARY_ATTACK_WINDOW_END_S=-1
PRIMARY_ATTACK_WINDOW_ATTACHED=0
PRIMARY_ATTACK_WINDOW_RRC=0
PRIMARY_ATTACK_WINDOW_REG=0
PRIMARY_ATTACK_WINDOW_PDU=0
PRIMARY_ATTACK_WINDOW_REJECT=0
PRIMARY_ATTACK_WINDOW_PING_RX=0
PRIMARY_ATTACK_WINDOW_ATTEMPTS=0
PRIMARY_ATTACK_WINDOW_DISTINCT_IDENTITIES=0
PRIMARY_ATTACK_WINDOW_FIRST_ATTEMPT_NS=0
PRIMARY_ATTACK_WINDOW_LAST_ATTEMPT_NS=0
PRIMARY_ATTACK_WINDOW_ATTEMPT_SPAN_MS=0
PRIMARY_ATTACK_WINDOW_MSG3_TX=0
PRIMARY_ATTACK_WINDOW_DISTINCT_TC_RNTI=0
PRIMARY_ATTACK_WINDOW_FIRST_MSG3_NS=0
PRIMARY_ATTACK_WINDOW_LAST_MSG3_NS=0
PRIMARY_ATTACK_WINDOW_MSG3_SPAN_MS=0
ATTACK_ATTEMPTS_AT_BOUNDARY=0
ATTACK_MSG3_AT_BOUNDARY=0
SAME_WITNESS_RECOVERY_ATTACH_S=-1
SAME_WITNESS_RECOVERY_WINDOW_CLOSED=0
SAME_WITNESS_BOUNDARY_GATE_OK=0
NORMAL_BEFORE_HEALTHY=0
NORMAL_BEFORE_HEALTHY_UES=0
NORMAL_DURING_SAMPLES=0
NORMAL_DURING_MIN_HEALTHY=$BROKER_WITNESS_UES
NORMAL_DURING_LAST_HEALTHY=0
NORMAL_RECOVERY_HEALTHY=0
NORMAL_RECOVERY_HEALTHY_UES=0
NORMAL_RECOVERY_ELAPSED_S=-1
NORMAL_PRE_ATTACK_FAILED=0
NORMAL_GATE_OK=0
NORMAL_GATE_ATTACK_NS=0
NORMAL_GATE_STANDBY_NS=0
NORMAL_UE_MSG3_BEFORE=0
NORMAL_UE_MSG3_AFTER=0
NORMAL_UE_MSG3_DELTA=0

if (( BROKER_NORMAL_POOL_QUALIFICATION && SYNC_READY && !BROKER_EARLY_EXIT && !EARLY_EXIT )); then
  NORMAL_HEALTH_STARTED=$SECONDS
  while :; do
    NORMAL_BEFORE_HEALTHY_UES=$(normal_pool_health)
    if (( NORMAL_BEFORE_HEALTHY_UES == BROKER_WITNESS_UES )); then
      NORMAL_BEFORE_HEALTHY=1
      record_normal_pool_health before
      break
    fi
    if (( SECONDS - NORMAL_HEALTH_STARTED >= BROKER_NORMAL_HEALTH_TIMEOUT_S )); then
      NORMAL_PRE_ATTACK_FAILED=1
      break
    fi
    sleep 1
  done
fi

if (( BROKER_NORMAL_POOL_QUALIFICATION && SYNC_READY && !BROKER_EARLY_EXIT
      && !EARLY_EXIT && !NORMAL_PRE_ATTACK_FAILED )); then
  if [[ $MODE == attack ]]; then
    NORMAL_UE_MSG3_BEFORE=$(count_attacker_msg3)
    if select_persistent_attack warmup && select_persistent_attack attack; then
      NORMAL_GATE_OK=1
      NORMAL_GATE_ATTACK_NS=$(date +%s%N)
      NORMAL_ATTACK_STARTED=$SECONDS
      while (( SECONDS - NORMAL_ATTACK_STARTED < BROKER_NORMAL_ATTACK_DURATION_S )); do
        is_running "$BROKER_PID" || { BROKER_EARLY_EXIT=1; break; }
        all_active_ues_running || { EARLY_EXIT=1; break; }
        NORMAL_CURRENT_HEALTHY=$(normal_pool_health)
        NORMAL_DURING_SAMPLES=$((NORMAL_DURING_SAMPLES + 1))
        NORMAL_DURING_LAST_HEALTHY=$NORMAL_CURRENT_HEALTHY
        (( NORMAL_CURRENT_HEALTHY >= NORMAL_DURING_MIN_HEALTHY )) \
          || NORMAL_DURING_MIN_HEALTHY=$NORMAL_CURRENT_HEALTHY
        record_normal_pool_health during
        sleep 1
      done
      if (( !BROKER_EARLY_EXIT && !EARLY_EXIT )) && select_persistent_attack standby; then
        NORMAL_GATE_STANDBY_NS=$(date +%s%N)
        PRIMARY_ATTACK_WINDOW_FROZEN=1
        PRIMARY_ATTACK_WINDOW_END_S=$((SECONDS - STARTED))
        ATTACK_ATTEMPTS_AT_BOUNDARY=$(count_attacker_attempts)
        ATTACK_MSG3_AT_BOUNDARY=$(count_attacker_msg3)
        NORMAL_UE_MSG3_AFTER=$(count_attacker_msg3)
        NORMAL_UE_MSG3_DELTA=$((NORMAL_UE_MSG3_AFTER - NORMAL_UE_MSG3_BEFORE))
        NORMAL_RECOVERY_STARTED=$SECONDS
        while (( SECONDS - NORMAL_RECOVERY_STARTED <= NORMAL_RECOVERY_DEADLINE_S )); do
          NORMAL_CURRENT_HEALTHY=$(normal_pool_health)
          NORMAL_RECOVERY_HEALTHY_UES=$NORMAL_CURRENT_HEALTHY
          if (( NORMAL_CURRENT_HEALTHY == BROKER_WITNESS_UES )); then
            NORMAL_RECOVERY_HEALTHY=1
            NORMAL_RECOVERY_ELAPSED_S=$((SECONDS - NORMAL_RECOVERY_STARTED))
            record_normal_pool_health after
            break
          fi
          (( SECONDS < DEADLINE )) || break
          sleep 1
        done
        (( NORMAL_RECOVERY_HEALTHY )) || record_normal_pool_health after
      fi
    fi
  else
    NORMAL_CONTROL_STARTED=$SECONDS
    while (( SECONDS - NORMAL_CONTROL_STARTED < BROKER_NORMAL_ATTACK_DURATION_S )); do
      is_running "$BROKER_PID" || { BROKER_EARLY_EXIT=1; break; }
      all_active_ues_running || { EARLY_EXIT=1; break; }
      NORMAL_CURRENT_HEALTHY=$(normal_pool_health)
      NORMAL_DURING_SAMPLES=$((NORMAL_DURING_SAMPLES + 1))
      NORMAL_DURING_LAST_HEALTHY=$NORMAL_CURRENT_HEALTHY
      (( NORMAL_CURRENT_HEALTHY >= NORMAL_DURING_MIN_HEALTHY )) \
        || NORMAL_DURING_MIN_HEALTHY=$NORMAL_CURRENT_HEALTHY
      record_normal_pool_health during
      sleep 1
    done
  fi
elif (( SYNC_READY && !BROKER_EARLY_EXIT && !EARLY_EXIT && !NORMAL_PRE_ATTACK_FAILED )); then
  while (( SECONDS < DEADLINE )); do
    if ! is_running "$BROKER_PID"; then
      BROKER_EARLY_EXIT=1
      break
    fi
    if ! all_active_ues_running; then
      EARLY_EXIT=1
      break
    fi
    if (( (RECOVERY_WITNESS_ENABLED || BROKER_SAME_WITNESS_CYCLE || BROKER_NORMAL_POOL_QUALIFICATION)
          && !PRIMARY_ATTACK_WINDOW_FROZEN
          && $(count_quiet_attackers) == BROKER_ATTACK_PROCESSES )); then
      PRIMARY_ATTACK_WINDOW_FROZEN=1
      PRIMARY_ATTACK_WINDOW_END_S=$((SECONDS - STARTED))
      PRIMARY_ATTACK_WINDOW_ATTACHED=$WITNESS_ATTACHED
      if [[ -n $("$IP_CMD" -4 -o addr show "$IFACE" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 || true) ]]; then
        PRIMARY_ATTACK_WINDOW_ATTACHED=1
      fi
      PRIMARY_ATTACK_WINDOW_RRC=$(count "Generating RRCSetupComplete" "$OUT/ue${WITNESS_INDEX}.log")
      PRIMARY_ATTACK_WINDOW_REG=$(count "Registration Accept" "$OUT/ue${WITNESS_INDEX}.log")
      PRIMARY_ATTACK_WINDOW_PDU=$(count "PDU Session Establishment Accept" "$OUT/ue${WITNESS_INDEX}.log")
      PRIMARY_ATTACK_WINDOW_REJECT=$(count "rrc_reject" "$OUT/ue${WITNESS_INDEX}.jsonl")
      PRIMARY_ATTACK_WINDOW_PING_RX=$(ping_received_now "$OUT/witness_ping.txt")
      read -r PRIMARY_ATTACK_WINDOW_ATTEMPTS PRIMARY_ATTACK_WINDOW_DISTINCT_IDENTITIES \
        PRIMARY_ATTACK_WINDOW_FIRST_ATTEMPT_NS PRIMARY_ATTACK_WINDOW_LAST_ATTEMPT_NS \
        PRIMARY_ATTACK_WINDOW_ATTEMPT_SPAN_MS PRIMARY_ATTACK_WINDOW_MSG3_TX \
        PRIMARY_ATTACK_WINDOW_DISTINCT_TC_RNTI PRIMARY_ATTACK_WINDOW_FIRST_MSG3_NS \
        PRIMARY_ATTACK_WINDOW_LAST_MSG3_NS PRIMARY_ATTACK_WINDOW_MSG3_SPAN_MS \
        < <(boundary_metrics "$OUT/ue${WITNESS_INDEX}.jsonl")
      ATTACK_ATTEMPTS_AT_BOUNDARY=$(count_attacker_attempts)
      ATTACK_MSG3_AT_BOUNDARY=$(count_attacker_msg3)
      if (( RECOVERY_WITNESS_ENABLED )); then
        RECOVERY_PRE_ATTACK_ATTEMPTS=$(count '"event":"attempt_start"' "$OUT/ue${RECOVERY_WITNESS_INDEX}.jsonl")
      fi
      if [[ -n $PING_PID ]]; then
        kill -INT "$PING_PID" 2>/dev/null || true
        wait "$PING_PID" 2>/dev/null || true
        PING_PID=""
      fi
      if (( BROKER_SAME_WITNESS_CYCLE )); then
        if (( PRIMARY_ATTACK_WINDOW_MSG3_TX >= SAME_WITNESS_MIN_MSG3_TX
              && PRIMARY_ATTACK_WINDOW_DISTINCT_TC_RNTI >= SAME_WITNESS_MIN_DISTINCT_TC_RNTI
              && PRIMARY_ATTACK_WINDOW_MSG3_SPAN_MS >= SAME_WITNESS_MIN_MSG3_SPAN_MS
              && PRIMARY_ATTACK_WINDOW_ATTACHED == 0 && PRIMARY_ATTACK_WINDOW_RRC == 0
              && PRIMARY_ATTACK_WINDOW_REG == 0 && PRIMARY_ATTACK_WINDOW_PDU == 0
              && PRIMARY_ATTACK_WINDOW_PING_RX == 0 )); then
          SAME_WITNESS_BOUNDARY_GATE_OK=1
        else
          break
        fi
      fi
    fi
    if (( BROKER_NORMAL_POOL_QUALIFICATION )); then
      NORMAL_CURRENT_HEALTHY=$(normal_pool_health)
      if [[ $MODE == control ]] || (( $(count_attacker_attempts) > 0 && !PRIMARY_ATTACK_WINDOW_FROZEN )); then
        NORMAL_DURING_SAMPLES=$((NORMAL_DURING_SAMPLES + 1))
        NORMAL_DURING_LAST_HEALTHY=$NORMAL_CURRENT_HEALTHY
        (( NORMAL_CURRENT_HEALTHY >= NORMAL_DURING_MIN_HEALTHY )) \
          || NORMAL_DURING_MIN_HEALTHY=$NORMAL_CURRENT_HEALTHY
        record_normal_pool_health during
      fi
      if [[ $MODE == attack ]] && (( PRIMARY_ATTACK_WINDOW_FROZEN )); then
        (( NORMAL_DURING_SAMPLES > 0 )) || {
          NORMAL_DURING_SAMPLES=1
          NORMAL_DURING_LAST_HEALTHY=$NORMAL_CURRENT_HEALTHY
          NORMAL_DURING_MIN_HEALTHY=$NORMAL_CURRENT_HEALTHY
          record_normal_pool_health during
        }
        if (( NORMAL_CURRENT_HEALTHY == BROKER_WITNESS_UES )); then
          NORMAL_RECOVERY_HEALTHY=1
          NORMAL_RECOVERY_HEALTHY_UES=$NORMAL_CURRENT_HEALTHY
          NORMAL_RECOVERY_ELAPSED_S=$((SECONDS - STARTED - PRIMARY_ATTACK_WINDOW_END_S))
          record_normal_pool_health after
          break
        fi
        if (( SECONDS - STARTED - PRIMARY_ATTACK_WINDOW_END_S >= NORMAL_RECOVERY_DEADLINE_S )); then
          NORMAL_RECOVERY_HEALTHY_UES=$NORMAL_CURRENT_HEALTHY
          record_normal_pool_health after
          break
        fi
      fi
    fi
    RECOVERY_ELAPSED_MS=$(((SECONDS - UE_LAUNCH_STARTED) * 1000))
    if (( RECOVERY_WITNESS_ENABLED && !RECOVERY_STARTED
          && RECOVERY_ELAPSED_MS < BROKER_RECOVERY_WITNESS_DELAY_MS )); then
      RECOVERY_PRE_PHASE_ATTEMPTS=$(count '"event":"attempt_start"' "$OUT/ue${RECOVERY_WITNESS_INDEX}.jsonl")
    fi
    if (( RECOVERY_WITNESS_ENABLED && !RECOVERY_STARTED
          && RECOVERY_ELAPSED_MS >= BROKER_RECOVERY_WITNESS_DELAY_MS )); then
      if (( !PRIMARY_ATTACK_WINDOW_FROZEN )); then
        RECOVERY_QUIET_MISSING=1
        echo "recovery witness reached its delay before every attacker logged quiet-stop" >&2
        break
      fi
      RECOVERY_ATTACKERS_QUIET=1
      if (( RECOVERY_PRE_PHASE_ATTEMPTS != 0 )); then
        echo "recovery witness attempted access before its configured phase" >&2
      fi
      RECOVERY_STARTED=1
      RECOVERY_START_S=$((SECONDS - STARTED))
      echo "== recovery witness on UE $RECOVERY_WITNESS_INDEX reached its post-attack access phase"
    fi
    if (( BROKER_SAME_WITNESS_CYCLE && PRIMARY_ATTACK_WINDOW_FROZEN
          && !SAME_WITNESS_RECOVERY_WINDOW_CLOSED
          && SECONDS - STARTED - PRIMARY_ATTACK_WINDOW_END_S >= SAME_WITNESS_RECOVERY_DEADLINE_S )); then
      SAME_WITNESS_RECOVERY_WINDOW_CLOSED=1
    fi
    if (( RECOVERY_STARTED )); then
      ROLE_ATTACHED=$RECOVERY_ATTACHED
      PING_FILE=$OUT/recovery_witness_ping.txt
    elif (( BROKER_SAME_WITNESS_CYCLE && PRIMARY_ATTACK_WINDOW_FROZEN )); then
      ROLE_ATTACHED=$WITNESS_ATTACHED
      PING_FILE=$OUT/same_witness_recovery_ping.txt
    else
      ROLE_ATTACHED=$WITNESS_ATTACHED
      PING_FILE=$OUT/witness_ping.txt
    fi
    # The primary observation closes at attacker quiet-stop; do not mix settle traffic into its ping file.
    if (( !RECOVERY_STARTED && PRIMARY_ATTACK_WINDOW_FROZEN && !BROKER_SAME_WITNESS_CYCLE )); then
      ROLE_ATTACHED=1
    fi
    if (( ROLE_ATTACHED == 0 )); then
      ROLE_READY=1
      if (( RECOVERY_STARTED )); then
        ROLE_READY=0
        if (( $(count "Registration Accept" "$OUT/ue${RECOVERY_WITNESS_INDEX}.log") > 0
              && $(count "PDU Session Establishment Accept" "$OUT/ue${RECOVERY_WITNESS_INDEX}.log") > 0 )); then
          ROLE_READY=1
        fi
      elif (( BROKER_SAME_WITNESS_CYCLE && PRIMARY_ATTACK_WINDOW_FROZEN )); then
        ROLE_READY=0
        if (( !SAME_WITNESS_RECOVERY_WINDOW_CLOSED
              && $(count "Generating RRCSetupComplete" "$OUT/ue${WITNESS_INDEX}.log") > PRIMARY_ATTACK_WINDOW_RRC
              && $(count "Registration Accept" "$OUT/ue${WITNESS_INDEX}.log") > PRIMARY_ATTACK_WINDOW_REG
              && $(count "PDU Session Establishment Accept" "$OUT/ue${WITNESS_INDEX}.log") > PRIMARY_ATTACK_WINDOW_PDU )); then
          ROLE_READY=1
        fi
      fi
      IP=$("$IP_CMD" -4 -o addr show "$IFACE" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 || true)
      if (( ROLE_READY )) && [[ -n $IP ]]; then
        if (( RECOVERY_STARTED )); then
          RECOVERY_ATTACHED=1
          RECOVERY_ATTACH_S=$((SECONDS - STARTED))
        else
          WITNESS_ATTACHED=1
          WITNESS_ATTACH_S=$((SECONDS - STARTED))
          if (( BROKER_SAME_WITNESS_CYCLE && PRIMARY_ATTACK_WINDOW_FROZEN )); then
            SAME_WITNESS_RECOVERY_ATTACH_S=$WITNESS_ATTACH_S
          fi
        fi
        "$PING_CMD" -D -n -I "$IFACE" -s "$PING_SIZE" -i "$PING_INTERVAL" "$GW" \
          9>&- >"$PING_FILE" 2>&1 &
        PING_PID=$!
      fi
    fi
    if (( BROKER_SAME_WITNESS_CYCLE && PRIMARY_ATTACK_WINDOW_FROZEN )); then
      if (( SAME_WITNESS_RECOVERY_WINDOW_CLOSED && !WITNESS_ATTACHED )); then
        break
      fi
      if (( WITNESS_ATTACHED )) && [[ -n $PING_PID ]]; then
        SAME_WITNESS_PING_RX_NOW=$(ping_received_now "$OUT/same_witness_recovery_ping.txt")
        if (( SAME_WITNESS_PING_RX_NOW >= SAME_WITNESS_MIN_PING_TX )) || ! is_running "$PING_PID"; then
          kill -INT "$PING_PID" 2>/dev/null || true
          wait "$PING_PID" 2>/dev/null || true
          PING_PID=""
          break
        fi
      fi
    fi
    sleep 1
  done
fi

if (( BROKER_NORMAL_POOL_QUALIFICATION )) && [[ $MODE == control ]]; then
  NORMAL_RECOVERY_HEALTHY_UES=$(normal_pool_health)
  (( NORMAL_RECOVERY_HEALTHY_UES != BROKER_WITNESS_UES )) || NORMAL_RECOVERY_HEALTHY=1
  record_normal_pool_health after
fi

is_running "$BROKER_PID" || BROKER_EARLY_EXIT=1
all_active_ues_running || EARLY_EXIT=1

# Freeze crash evidence at the observation boundary.  Teardown faults belong in
# teardown.* below and must not retroactively invalidate an otherwise valid run.
CRASH=0
for ((i=1; i<=TOTAL_UE_PROCESSES; i++)); do
  CRASH=$((CRASH + $(count "Segmentation fault\|Assertion.*failed\|Backtrace" "$OUT/ue${i}.log")))
done

stop_children
stop_gnb
[[ -z $MULTI_RU_RUNTIME_CFG ]] || unlink "$MULTI_RU_RUNTIME_CFG"
MULTI_RU_RUNTIME_CFG=""
trap - EXIT

SYNC=$SYNC_AT_GATE
ATTACK_ATTEMPTS=0
ATTACK_MSG3=0
ATTACK_MSG5=0
for ((i=1; i<=TOTAL_UE_PROCESSES; i++)); do
  if (( i <= BROKER_ATTACK_PROCESSES )); then
    ATTACK_ATTEMPTS=$((ATTACK_ATTEMPTS + $(count '"event":"attempt_start"' "$OUT/ue${i}.jsonl")))
    ATTACK_MSG3=$((ATTACK_MSG3 + $(count '"event":"msg3_tx"' "$OUT/ue${i}.jsonl")))
    ATTACK_MSG5=$((ATTACK_MSG5 + $(count "Generating RRCSetupComplete" "$OUT/ue${i}.log")))
  fi
done
ATTACK_POST_BOUNDARY_ATTEMPTS=0
ATTACK_POST_BOUNDARY_MSG3=0
if (( BROKER_SAME_WITNESS_CYCLE && PRIMARY_ATTACK_WINDOW_FROZEN )); then
  ATTACK_POST_BOUNDARY_ATTEMPTS=$((ATTACK_ATTEMPTS - ATTACK_ATTEMPTS_AT_BOUNDARY))
  ATTACK_POST_BOUNDARY_MSG3=$((ATTACK_MSG3 - ATTACK_MSG3_AT_BOUNDARY))
fi

WITNESS_RRC=$(count "Generating RRCSetupComplete" "$OUT/ue${WITNESS_INDEX}.log")
WITNESS_REG=$(count "Registration Accept" "$OUT/ue${WITNESS_INDEX}.log")
WITNESS_PDU=$(count "PDU Session Establishment Accept" "$OUT/ue${WITNESS_INDEX}.log")
WITNESS_REJECT=$(count "rrc_reject" "$OUT/ue${WITNESS_INDEX}.jsonl")
RECOVERY_RRC=0
RECOVERY_REG=0
RECOVERY_PDU=0
RECOVERY_REJECT=0
if (( RECOVERY_STARTED )); then
  RECOVERY_RRC=$(count "Generating RRCSetupComplete" "$OUT/ue${RECOVERY_WITNESS_INDEX}.log")
  RECOVERY_REG=$(count "Registration Accept" "$OUT/ue${RECOVERY_WITNESS_INDEX}.log")
  RECOVERY_PDU=$(count "PDU Session Establishment Accept" "$OUT/ue${RECOVERY_WITNESS_INDEX}.log")
  RECOVERY_REJECT=$(count "rrc_reject" "$OUT/ue${RECOVERY_WITNESS_INDEX}.jsonl")
fi
CONTROL_EXTRA_QUIET_ATTEMPTS=0
if (( BROKER_CONTROL_EXTRA_QUIET_WITNESS )); then
  CONTROL_EXTRA_QUIET_ATTEMPTS=$(count '"event":"attempt_start"' "$OUT/ue${CONTROL_EXTRA_QUIET_WITNESS_INDEX}.jsonl")
fi
PRIMARY_POST_BOUNDARY_RRC=0
PRIMARY_POST_BOUNDARY_REG=0
PRIMARY_POST_BOUNDARY_PDU=0
PRIMARY_POST_BOUNDARY_ACTIVITY=0
RECOVERY_PING_ISOLATED=0
if (( (RECOVERY_WITNESS_ENABLED || BROKER_SAME_WITNESS_CYCLE || BROKER_NORMAL_POOL_QUALIFICATION)
      && PRIMARY_ATTACK_WINDOW_FROZEN )); then
  PRIMARY_POST_BOUNDARY_RRC=$((WITNESS_RRC - PRIMARY_ATTACK_WINDOW_RRC))
  PRIMARY_POST_BOUNDARY_REG=$((WITNESS_REG - PRIMARY_ATTACK_WINDOW_REG))
  PRIMARY_POST_BOUNDARY_PDU=$((WITNESS_PDU - PRIMARY_ATTACK_WINDOW_PDU))
  if (( PRIMARY_POST_BOUNDARY_RRC != 0 || PRIMARY_POST_BOUNDARY_REG != 0
        || PRIMARY_POST_BOUNDARY_PDU != 0 )); then
    PRIMARY_POST_BOUNDARY_ACTIVITY=1
  fi
  if (( RECOVERY_WITNESS_ENABLED && PRIMARY_ATTACK_WINDOW_REG == 0 && PRIMARY_ATTACK_WINDOW_PDU == 0
        && WITNESS_REG == 0 && WITNESS_PDU == 0 )); then
    RECOVERY_PING_ISOLATED=1
  fi
fi
WITNESS_PING_FILE=$OUT/witness_ping.txt
if (( BROKER_SAME_WITNESS_CYCLE )); then
  WITNESS_PING_FILE=$OUT/same_witness_recovery_ping.txt
fi
read -r WITNESS_PING_OK PING_TX PING_RX PING_LOSS_PCT PING_RTT_AVG_MS \
  < <(ping_metrics "$WITNESS_PING_FILE")
read -r RECOVERY_PING_OK RECOVERY_PING_TX RECOVERY_PING_RX RECOVERY_PING_LOSS_PCT RECOVERY_PING_RTT_AVG_MS \
  < <(ping_metrics "$OUT/recovery_witness_ping.txt")

SAME_WITNESS_ATTACK_DENIAL=0
SAME_WITNESS_PING_ISOLATED=0
SAME_WITNESS_RECOVERY_WITHIN_DEADLINE=0
SAME_WITNESS_RECOVERY_SERVICE=0
SAME_WITNESS_CYCLE_PASSED=0
SAME_WITNESS_PING_ZERO_LOSS=0
if [[ $PING_LOSS_PCT != null ]] && awk -v loss="$PING_LOSS_PCT" 'BEGIN { exit !((loss + 0) == 0) }'; then
  SAME_WITNESS_PING_ZERO_LOSS=1
fi
if (( BROKER_SAME_WITNESS_CYCLE && PRIMARY_ATTACK_WINDOW_FROZEN )); then
  if (( SAME_WITNESS_BOUNDARY_GATE_OK )); then
    SAME_WITNESS_ATTACK_DENIAL=1
    SAME_WITNESS_PING_ISOLATED=1
  fi
  if (( SAME_WITNESS_RECOVERY_ATTACH_S >= PRIMARY_ATTACK_WINDOW_END_S
        && SAME_WITNESS_RECOVERY_ATTACH_S - PRIMARY_ATTACK_WINDOW_END_S <= SAME_WITNESS_RECOVERY_DEADLINE_S )); then
    SAME_WITNESS_RECOVERY_WITHIN_DEADLINE=1
  fi
  if (( SAME_WITNESS_PING_ISOLATED && SAME_WITNESS_RECOVERY_WITHIN_DEADLINE
        && PRIMARY_POST_BOUNDARY_RRC > 0 && PRIMARY_POST_BOUNDARY_REG > 0
        && PRIMARY_POST_BOUNDARY_PDU > 0 && PING_TX >= SAME_WITNESS_MIN_PING_TX
        && PING_RX == PING_TX && SAME_WITNESS_PING_ZERO_LOSS )); then
    SAME_WITNESS_RECOVERY_SERVICE=1
  fi
  if (( SAME_WITNESS_ATTACK_DENIAL && SAME_WITNESS_RECOVERY_SERVICE
        && ATTACK_POST_BOUNDARY_ATTEMPTS == 0 && ATTACK_POST_BOUNDARY_MSG3 == 0 )); then
    SAME_WITNESS_CYCLE_PASSED=1
  fi
fi

VALID=1
REASON=ok
if (( !SYNC_READY || BROKER_EARLY_EXIT || EARLY_EXIT || SYNC != BROKER_ENDPOINTS || CRASH != 0
      || RECOVERY_WITNESS_ENABLED && (!RECOVERY_STARTED || RECOVERY_QUIET_MISSING
         || RECOVERY_PRE_ATTACK_ATTEMPTS != 0 || RECOVERY_PRE_PHASE_ATTEMPTS != 0) )); then
  VALID=0; REASON=infrastructure_failure
elif (( BROKER_NORMAL_POOL_QUALIFICATION && !NORMAL_BEFORE_HEALTHY )); then
  VALID=0; REASON=normal_pool_not_healthy_before_attack
elif (( BROKER_NORMAL_POOL_QUALIFICATION )) && [[ $MODE == attack ]] && (( !NORMAL_GATE_OK )); then
  VALID=0; REASON=normal_pool_attack_gate_failed
elif [[ $MODE == attack ]] && (( ATTACK_MSG5 != 0 )); then
  VALID=0; REASON=attacker_msg5_observed
elif [[ $MODE == attack ]] && (( ATTACK_ATTEMPTS == 0 )); then
  VALID=0; REASON=zero_attack_attempts
elif (( BROKER_NORMAL_POOL_QUALIFICATION && NORMAL_DURING_SAMPLES == 0 )); then
  VALID=0; REASON=normal_pool_during_attack_missing
elif (( BROKER_NORMAL_POOL_QUALIFICATION )) && [[ $MODE == attack ]] \
     && (( !PRIMARY_ATTACK_WINDOW_FROZEN )); then
  VALID=0; REASON=normal_pool_attack_boundary_missing
elif (( BROKER_NORMAL_POOL_QUALIFICATION )) && [[ $MODE == attack ]] \
     && (( NORMAL_UE_MSG3_DELTA <= 0 )); then
  VALID=0; REASON=normal_pool_ue_attack_oracle_missing
elif (( BROKER_NORMAL_POOL_QUALIFICATION && !NORMAL_RECOVERY_HEALTHY )); then
  VALID=0; REASON=normal_pool_recovery_missing
elif (( BROKER_SAME_WITNESS_CYCLE && !PRIMARY_ATTACK_WINDOW_FROZEN )); then
  VALID=0; REASON=same_witness_boundary_missing
elif (( BROKER_SAME_WITNESS_CYCLE
        && (ATTACK_POST_BOUNDARY_ATTEMPTS != 0 || ATTACK_POST_BOUNDARY_MSG3 != 0) )); then
  VALID=0; REASON=attacker_activity_after_boundary
elif (( BROKER_SAME_WITNESS_CYCLE && !SAME_WITNESS_ATTACK_DENIAL )); then
  VALID=0; REASON=same_witness_attack_denial_missing
elif (( BROKER_SAME_WITNESS_CYCLE && !SAME_WITNESS_RECOVERY_SERVICE )); then
  VALID=0; REASON=same_witness_recovery_missing
elif [[ $MODE == control ]] && (( ATTACK_ATTEMPTS > BROKER_ATTACK_PROCESSES )); then
  VALID=0; REASON=control_load_ue_activity_unexpected
elif [[ $MODE == control ]] && (( CONTROL_EXTRA_QUIET_ATTEMPTS != 0 )); then
  VALID=0; REASON=control_extra_quiet_witness_activity_unexpected
elif [[ $MODE == control ]] && (( !BROKER_NORMAL_POOL_QUALIFICATION \
     && (WITNESS_ATTACHED == 0 || WITNESS_RRC == 0 || WITNESS_REG == 0 || WITNESS_PDU == 0 || WITNESS_PING_OK == 0) )); then
  VALID=0; REASON=control_witness_service_missing
fi

SERVICE=0
(( WITNESS_ATTACHED && WITNESS_RRC > 0 && WITNESS_REG > 0 && WITNESS_PDU > 0 && WITNESS_PING_OK )) && SERVICE=1
RECOVERY_SERVICE=0
(( RECOVERY_ATTACHED && RECOVERY_RRC > 0 && RECOVERY_REG > 0 && RECOVERY_PDU > 0
   && RECOVERY_PING_OK && RECOVERY_PING_ISOLATED )) && RECOVERY_SERVICE=1
PRIMARY_ATTACK_WINDOW_SERVICE=0
(( PRIMARY_ATTACK_WINDOW_ATTACHED && PRIMARY_ATTACK_WINDOW_RRC > 0
   && PRIMARY_ATTACK_WINDOW_REG > 0 && PRIMARY_ATTACK_WINDOW_PDU > 0
   && PRIMARY_ATTACK_WINDOW_PING_RX > 0 )) && PRIMARY_ATTACK_WINDOW_SERVICE=1
MODE_ATTACK_ATTEMPTS=0
MODE_ATTACK_MSG3=0
MODE_ATTACK_MSG5=0
if [[ $MODE == attack ]]; then
  MODE_ATTACK_ATTEMPTS=$ATTACK_ATTEMPTS
  MODE_ATTACK_MSG3=$ATTACK_MSG3
  MODE_ATTACK_MSG5=$ATTACK_MSG5
fi
UE_EXIT_JSON="["
UE_PROCESS_STARTS=${#UE_CHILD_INDEXES[@]}
for i in "${!UE_CHILD_INDEXES[@]}"; do
  (( i == 0 )) || UE_EXIT_JSON+=,
  child_index=${UE_CHILD_INDEXES[$i]}
  UE_EXIT_JSON+=${CHILD_EXIT_STATUS[$child_index]:-null}
done
UE_EXIT_JSON+="]"
BROKER_EXIT_STATUS=${CHILD_EXIT_STATUS[$BROKER_INDEX]:-null}
BROKER_SIGSEGV=0
UE_SIGSEGV_COUNT=0
FORCED_KILL_COUNT=0
if [[ $BROKER_EXIT_STATUS == 139 ]]; then
  BROKER_SIGSEGV=1
fi
for child_index in "${UE_CHILD_INDEXES[@]}"; do
  if [[ ${CHILD_EXIT_STATUS[$child_index]:-null} == 139 ]]; then
    UE_SIGSEGV_COUNT=$((UE_SIGSEGV_COUNT + 1))
  fi
done
for i in "${!CHILD_FORCED_KILL[@]}"; do
  FORCED_KILL_COUNT=$((FORCED_KILL_COUNT + CHILD_FORCED_KILL[$i]))
done
bool() { (( $1 )) && echo true || echo false; }
RECOVERY_RESULT_JSON=""
CONTROL_EXTRA_RESULT_JSON=""
ATTACK_WINDOW_RESULT_JSON=""
SAME_WITNESS_RESULT_JSON=""
NORMAL_POOL_RESULT_JSON=""
if (( RECOVERY_WITNESS_ENABLED || BROKER_SAME_WITNESS_CYCLE || BROKER_NORMAL_POOL_QUALIFICATION )); then
  ATTACK_WINDOW_BOUNDARY=all_attacker_kill_switches_observed
  (( BROKER_NORMAL_POOL_QUALIFICATION == 0 )) || ATTACK_WINDOW_BOUNDARY=broker_uplink_gate_standby
  ATTACK_WINDOW_RESULT_JSON=",\"attack_window\":{\"boundary\":\"$ATTACK_WINDOW_BOUNDARY\",\"frozen\":$(bool "$PRIMARY_ATTACK_WINDOW_FROZEN"),\"end_s\":$PRIMARY_ATTACK_WINDOW_END_S,\"attempts\":$PRIMARY_ATTACK_WINDOW_ATTEMPTS,\"distinct_fresh_identities\":$PRIMARY_ATTACK_WINDOW_DISTINCT_IDENTITIES,\"first_attempt_ns\":$PRIMARY_ATTACK_WINDOW_FIRST_ATTEMPT_NS,\"last_attempt_ns\":$PRIMARY_ATTACK_WINDOW_LAST_ATTEMPT_NS,\"attempt_span_ms\":$PRIMARY_ATTACK_WINDOW_ATTEMPT_SPAN_MS,\"msg3_tx\":$PRIMARY_ATTACK_WINDOW_MSG3_TX,\"distinct_nonzero_tc_rnti\":$PRIMARY_ATTACK_WINDOW_DISTINCT_TC_RNTI,\"first_msg3_tx_ns\":$PRIMARY_ATTACK_WINDOW_FIRST_MSG3_NS,\"last_msg3_tx_ns\":$PRIMARY_ATTACK_WINDOW_LAST_MSG3_NS,\"msg3_span_ms\":$PRIMARY_ATTACK_WINDOW_MSG3_SPAN_MS,\"attached\":$(bool "$PRIMARY_ATTACK_WINDOW_ATTACHED"),\"rrc_setup_complete\":$PRIMARY_ATTACK_WINDOW_RRC,\"registration_accept\":$PRIMARY_ATTACK_WINDOW_REG,\"pdu_accept\":$PRIMARY_ATTACK_WINDOW_PDU,\"rrc_reject\":$PRIMARY_ATTACK_WINDOW_REJECT,\"ping_ok\":$(bool "$((PRIMARY_ATTACK_WINDOW_PING_RX > 0))"),\"ping_received\":$PRIMARY_ATTACK_WINDOW_PING_RX,\"service_ok\":$(bool "$PRIMARY_ATTACK_WINDOW_SERVICE")},\"post_boundary_activity\":{\"observed\":$(bool "$PRIMARY_POST_BOUNDARY_ACTIVITY"),\"rrc_setup_complete\":$PRIMARY_POST_BOUNDARY_RRC,\"registration_accept\":$PRIMARY_POST_BOUNDARY_REG,\"pdu_accept\":$PRIMARY_POST_BOUNDARY_PDU}"
fi
if (( BROKER_NORMAL_POOL_QUALIFICATION )); then
  NORMAL_POOL_RESULT_JSON=",\"normal_pool\":{\"enabled\":true,\"same_du_cell\":true,\"expected_ues\":$BROKER_WITNESS_UES,\"health_evidence\":\"normal-health.jsonl\",\"before\":{\"healthy_ues\":$NORMAL_BEFORE_HEALTHY_UES,\"all_healthy\":$(bool "$NORMAL_BEFORE_HEALTHY")},\"during\":{\"samples\":$NORMAL_DURING_SAMPLES,\"min_healthy_ues\":$NORMAL_DURING_MIN_HEALTHY,\"last_healthy_ues\":$NORMAL_DURING_LAST_HEALTHY},\"recovery\":{\"deadline_s\":$NORMAL_RECOVERY_DEADLINE_S,\"elapsed_s\":$NORMAL_RECOVERY_ELAPSED_S,\"healthy_ues\":$NORMAL_RECOVERY_HEALTHY_UES,\"all_healthy\":$(bool "$NORMAL_RECOVERY_HEALTHY")},\"broker_gate\":{\"attack_ns\":$NORMAL_GATE_ATTACK_NS,\"standby_ns\":$NORMAL_GATE_STANDBY_NS,\"activated\":$(bool "$NORMAL_GATE_OK")},\"ue_msg3_during_gate\":{\"before\":$NORMAL_UE_MSG3_BEFORE,\"after\":$NORMAL_UE_MSG3_AFTER,\"delta\":$NORMAL_UE_MSG3_DELTA},\"direct_detector_input\":false,\"ue_to_ran_path_required\":true}"
fi
if (( RECOVERY_WITNESS_ENABLED )); then
  RECOVERY_RESULT_JSON=",\"recovery_witness\":{\"prelaunched\":true,\"endpoint_index\":$RECOVERY_WITNESS_INDEX,\"started\":$(bool "$RECOVERY_STARTED"),\"start_s\":$RECOVERY_START_S,\"sync_ready\":$(bool "$SYNC_READY"),\"sync_wait_s\":$SYNC_WAIT_S,\"pre_attack_attempts\":$RECOVERY_PRE_ATTACK_ATTEMPTS,\"pre_phase_attempts\":$RECOVERY_PRE_PHASE_ATTEMPTS,\"attackers_quiet\":$(bool "$RECOVERY_ATTACKERS_QUIET"),\"attached\":$(bool "$RECOVERY_ATTACHED"),\"attach_s\":$RECOVERY_ATTACH_S,\"rrc_setup_complete\":$RECOVERY_RRC,\"registration_accept\":$RECOVERY_REG,\"pdu_accept\":$RECOVERY_PDU,\"rrc_reject\":$RECOVERY_REJECT,\"ping_ok\":$(bool "$RECOVERY_PING_OK"),\"ping_isolated\":$(bool "$RECOVERY_PING_ISOLATED"),\"ping\":{\"transmitted\":$RECOVERY_PING_TX,\"received\":$RECOVERY_PING_RX,\"loss_pct\":$RECOVERY_PING_LOSS_PCT,\"rtt_avg_ms\":$RECOVERY_PING_RTT_AVG_MS},\"service_ok\":$(bool "$RECOVERY_SERVICE")}"
fi
if (( BROKER_SAME_WITNESS_CYCLE )); then
  SAME_WITNESS_RESULT_JSON=",\"same_witness_cycle\":{\"enabled\":true,\"endpoint_index\":$WITNESS_INDEX,\"attack_denial_ok\":$(bool "$SAME_WITNESS_ATTACK_DENIAL"),\"attackers\":{\"attempts_at_boundary\":$ATTACK_ATTEMPTS_AT_BOUNDARY,\"post_boundary_attempts\":$ATTACK_POST_BOUNDARY_ATTEMPTS,\"msg3_tx_at_boundary\":$ATTACK_MSG3_AT_BOUNDARY,\"post_boundary_msg3_tx\":$ATTACK_POST_BOUNDARY_MSG3},\"recovery\":{\"attach_s\":$SAME_WITNESS_RECOVERY_ATTACH_S,\"deadline_s\":$SAME_WITNESS_RECOVERY_DEADLINE_S,\"within_deadline\":$(bool "$SAME_WITNESS_RECOVERY_WITHIN_DEADLINE"),\"rrc_setup_complete\":$PRIMARY_POST_BOUNDARY_RRC,\"registration_accept\":$PRIMARY_POST_BOUNDARY_REG,\"pdu_accept\":$PRIMARY_POST_BOUNDARY_PDU,\"ping_isolated\":$(bool "$SAME_WITNESS_PING_ISOLATED"),\"ping\":{\"transmitted\":$PING_TX,\"received\":$PING_RX,\"loss_pct\":$PING_LOSS_PCT,\"rtt_avg_ms\":$PING_RTT_AVG_MS},\"service_ok\":$(bool "$SAME_WITNESS_RECOVERY_SERVICE")},\"passed\":$(bool "$SAME_WITNESS_CYCLE_PASSED")}"
fi
if (( BROKER_CONTROL_EXTRA_QUIET_WITNESS )); then
  CONTROL_EXTRA_RESULT_JSON=",\"control_extra_quiet_witness\":{\"prelaunched\":true,\"endpoint_index\":$CONTROL_EXTRA_QUIET_WITNESS_INDEX,\"attempts\":$CONTROL_EXTRA_QUIET_ATTEMPTS,\"quiet\":$(bool "$((CONTROL_EXTRA_QUIET_ATTEMPTS == 0))")}"
fi
cat >"$OUT/result.json" <<EOF
{"type":"broker_witness_result","run_id":"$RUN_ID","mode":"$MODE",
 "valid":$(bool "$VALID"),"reason":"$REASON","sync_ues":$SYNC,"crash_markers":$CRASH,
 "topology":{"attack_or_quiet_processes":$BROKER_ATTACK_PROCESSES,"attack_or_quiet_ues":$ATTACK_LOGICAL_UES,"witness_processes":$WITNESS_PROCESSES,"witness_ues":$WITNESS_LOGICAL_UES,"ue_processes":$TOTAL_UE_PROCESSES,"ue_process_starts":$UE_PROCESS_STARTS$MULTI_RU_TOPOLOGY_JSON},
 "startup":{"sync_ready":$(bool "$SYNC_READY"),"sync_wait_s":$SYNC_WAIT_S,"sync_timeout":$(bool "$SYNC_TIMED_OUT")},
 "load_ue_attempts":$ATTACK_ATTEMPTS,"load_ue_msg5":$ATTACK_MSG5,
 "attacker_attempts":$MODE_ATTACK_ATTEMPTS,"attacker_msg3":$MODE_ATTACK_MSG3,"attacker_msg5":$MODE_ATTACK_MSG5,
 "witness":{"attached":$(bool "$WITNESS_ATTACHED"),"attach_s":$WITNESS_ATTACH_S,"rrc_setup_complete":$WITNESS_RRC,
            "registration_accept":$WITNESS_REG,"pdu_accept":$WITNESS_PDU,
            "rrc_reject":$WITNESS_REJECT,"ping_ok":$(bool "$WITNESS_PING_OK"),
            "ping":{"transmitted":$PING_TX,"received":$PING_RX,"loss_pct":$PING_LOSS_PCT,"rtt_avg_ms":$PING_RTT_AVG_MS},
            "service_ok":$(bool "$SERVICE")$ATTACK_WINDOW_RESULT_JSON}$RECOVERY_RESULT_JSON$SAME_WITNESS_RESULT_JSON$CONTROL_EXTRA_RESULT_JSON$NORMAL_POOL_RESULT_JSON,
 "teardown":{"ue_exit_statuses":$UE_EXIT_JSON,"broker_exit_status":$BROKER_EXIT_STATUS,
             "ue_stop_signal":"INTx2","broker_stop_signal":"INT","grace_s":5,
             "ue_sigsegv_count":$UE_SIGSEGV_COUNT,"broker_sigsegv":$(bool "$BROKER_SIGSEGV"),
             "forced_kill_count":$FORCED_KILL_COUNT},
 "t_stop_utc":"$(date -u +%FT%TZ)"}
EOF

if (( BROKER_NORMAL_POOL_QUALIFICATION )); then
  cat >"$OUT/same-cell-session.json" <<EOF
{"schema":"same-cell.session.v2","run_id":"$RUN_ID","attack":"rrc-storm","mode":"$MODE","normal_ues":5,"normal_shared_ru":false,"attack_slots":6,"cell_restarts":1,"cu_restarts":0,"clocked_attack_slots":true}
EOF
  cat >"$OUT/same-cell-run.json" <<EOF
{"schema":"same-cell.run.v3","run_id":"$RUN_ID","attack":"rrc-storm","mode":"$MODE","normal_ues":5,"normal_shared_ru":false,"attack_slots":6,"du_restarted_during_attack":false,"normal_healthy_before_attack_teardown":$(bool "$NORMAL_RECOVERY_HEALTHY"),"direct_detector_input":false,"ue_to_ran_path_required":true,"attack_exit_status":$((VALID ? 0 : 1)),"result":"result.json"}
EOF
fi

cat "$OUT/result.json"
(( VALID ))
echo "완료됨: mode=$MODE same_cell=true normal=$BROKER_WITNESS_UES output=$OUT"
