+static int blind_recovery_event_fd = -1;
+
+static void request_blind_victim_recovery(void)
+{
+  for (int ue_inst = 0; ue_inst < NB_UE_INST; ue_inst++) {
+    MessageDef *msg = itti_alloc_new_message(TASK_NAS_NRUE, ue_inst, NAS_DEREGISTRATION_REQ);
+    NAS_DEREGISTRATION_REQ(msg).cause = AS_AUTHENTICATION_FAILURE;
+    itti_send_msg_to_task(TASK_NAS_NRUE, ue_inst, msg);
+  }
+}
+
+static void *blind_victim_recovery_worker(void *arg)
+{
+  (void)arg;
+  uint64_t requests;
+  while (read(blind_recovery_event_fd, &requests, sizeof(requests)) == sizeof(requests)) {
+    while (requests-- > 0)
+      request_blind_victim_recovery();
+  }
+  return NULL;
+}
+
+static void trigger_blind_victim_recovery(int sig)
+{
+  (void)sig;
+  const int saved_errno = errno;
+  const uint64_t request = 1;
+  __attribute__((unused)) ssize_t unused = write(blind_recovery_event_fd, &request, sizeof(request));
+  errno = saved_errno;
+}
