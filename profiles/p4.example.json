{
  "schema": "ran-reproducer.profile.v1",
  "id": "p4",
  "backend": "p5",
  "configured": false,
  "lab_only": true,
  "run_root": "/var/lib/ran-reproducer/runs",
  "environment": {
    "OAI_BASE": "/root/OAI",
    "DETECTOR_BIN": "/root/detection/build/detector",
    "DETECTOR_CONFIG": "/root/detection/config/detector.json",
    "P5_CU_HOST": "replace-with-p4-cu-ssh-host",
    "P5_DU_HOST": "replace-with-p4-du-ssh-host",
    "P5_CU_PRIVATE_IP": "replace-with-p4-cu-private-ip",
    "P5_DU_PRIVATE_IP": "replace-with-p4-du-private-ip"
  },
  "credentials_file": "/root/.config/ran-reproducer/p4.env",
  "detector": {
    "binary": "/root/detection/build/detector",
    "config": "/root/detection/config/detector.json",
    "repository": "https://github.com/portranproject/detection",
    "commit": "766f5569d0ddb425c14bf210a31c38ac60eceef9"
  },
  "telemetry": {
    "binary": "/root/telemetry/build/portran",
    "period_ms": 100,
    "repository": "https://github.com/portranproject/telemetry",
    "commit": "7550153a58a993942303bd3d4a6cd635b664468b"
  },
  "limits": {"max_duration_s": 300, "max_ues": 20, "max_tx_gain_db": null},
  "target_allowlist": ["replace-with-p4-lab-target"],
  "rf": null
}
