+static bool capability_injection_enabled(void)
+{
+  const char *value = getenv("OAI_UE_CAPABILITY_INJECT");
+  return value != NULL && strcmp(value, "1") == 0;
+}
+
+static bool capability_trace_enabled(void)
+{
+  const char *value = getenv("OAI_UE_CAPABILITY_TRACE");
+  return value != NULL && strcmp(value, "1") == 0;
+}
+
+static void inject_pre_security_capability_information(NR_UE_RRC_INST_t *rrc)
+{
+  if (!capability_injection_enabled() || rrc->ue_id >= MAX_NUM_NR_UE_INST
+      || atomic_exchange(&capability_information_injected[rrc->ue_id], true))
+    return;
+
+  NR_UE_CapabilityRAT_Request_t request = {.rat_Type = NR_RAT_Type_nr};
+  NR_UE_CapabilityRAT_Request_t *requests[] = {&request};
+  NR_UECapabilityEnquiry_IEs_t ies = {
+      .ue_CapabilityRAT_RequestList = {.list = {.array = requests, .count = 1, .size = 1}}};
+  NR_UECapabilityEnquiry_t enquiry = {
+      .rrc_TransactionIdentifier = 0,
+      .criticalExtensions = {
+          .present = NR_UECapabilityEnquiry__criticalExtensions_PR_ueCapabilityEnquiry,
+          .choice = {.ueCapabilityEnquiry = &ies}}};
+
+  nr_rrc_ue_process_ueCapabilityEnquiry(rrc, &enquiry, true);
+}
