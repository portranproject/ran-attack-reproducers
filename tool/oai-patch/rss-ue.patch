@@ -444,6 +641,8 @@ void nr_rrc_set_sib1_timers_and_constants(NR_UE_Timers_Constants_t *tac, NR_SIB1
         AssertFatal(false, "Invalid T300 %ld\n", sib1->ue_TimersAndConstants->t300);
     }
     nr_timer_setup(&tac->T300, k, 10); // 10ms step
+    /* A-type reproducer timer, armed only when an attempt is actually skipped */
