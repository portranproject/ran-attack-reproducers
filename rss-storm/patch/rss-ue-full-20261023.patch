+/* RSS: PRACH occasion arbitration.
+   Box-measured 2026-10-22: 35.3% of attempt starts land within 1 ms of another,
+   even though the instances' cycle phases are already uniformly random
+   (circular concentration R = 0.01, cycle p50 69.3 ms, CV 0.5-0.6). The
+   clumping is not phase locking, it is the occasion grid: this cell offers one
+   RO per frame (slot 19, one FDM, confirmed in the UE log), so every instance
+   that is ready in a frame transmits in that same occasion and the following
+   occasions go unused.
+   Creations matter because releases are their 2.0 s delayed copy (cross
+   correlation r = +0.99 at lag 2000 ms, context lifetime 1999.4 +- 0.3 ms).
+   Release clumping sets how far occupancy drains below the cell ceiling
+   (releases-in-gap -> depth r = +0.60) and depth sets the reject gap
+   (36 ms per slot). So clumped creations are what produce the long gaps.
+   Spreading creations onto the 10 ms grid needs only ~45% occasion duty
+   (one creation per 22.3 ms at the 44.9/s the ceiling needs), so there is room.
+   Radio write timestamps are left alone: rewriting them is what broke the
+   refuted RSS_PHASE_STAGGER against the late-drop guard in nr-ue-ru.c. */
+static pthread_mutex_t rss_ro_mtx = PTHREAD_MUTEX_INITIALIZER;
+static frame_t rss_ro_frame;
+static int rss_ro_slot = -1;
+static int rss_ro_owner = -1;
+static unsigned long rss_ro_granted, rss_ro_deferred, rss_ro_cooled;
+/* Per-instance cooldown. "One instance per occasion" still lets a single
+   instance take consecutive occasions, and it does: claims run at 158/s
+   against 100 occasions/s (box-measured 2026-10-22), i.e. PRACH is retried
+   ~2.5x per successful attempt. Those retries re-clump the creations the
+   arbitration just spread. Holding an instance off for N frames after it is
+   granted forces the instances to rotate through the grid instead. */
+#define RSS_RO_MAX_UE 16
+static int rss_ro_last[RSS_RO_MAX_UE];
+static bool rss_ro_last_set[RSS_RO_MAX_UE];
+
+static bool rss_ro_arbitrate(void)
+{
+  static int cached = -1;
+  if (cached < 0) {
+    const char *env = getenv("RSS_RO_ARBITRATE");
+    cached = env ? (atoi(env) != 0) : 0;
+  }
+  return cached != 0;
+}
+
+/* Deterministic round robin: instance i may only use occasions where
+   frame % N == i % N, so consecutive creations land exactly one occasion
+   (10 ms) apart instead of piling into whichever frame comes next.
+   Box-measured 2026-10-22: first-come arbitration alone leaves 643-765 ms
+   below the ceiling, because a deferred instance simply retries in the very
+   next frame -- the clump moves, it does not spread. Per-instance cooldown was
+   refuted (765 / 1254 / 937 ms at N = 0 / 4 / 6) because the deferrals are
+   cross-instance collisions, not one instance repeating: at cooldown 2 the
+   counter never fired at all.
+   Capacity check: grants run at 61.7/s against 100 occasions/s, so each of 6
+   instances takes 10.3/s while round robin allows 16.7/s. No throttling.
+   0 = off; otherwise set it to the instance count. */
+static int rss_ro_rr(void)
+{
+  static int cached = -1;
+  if (cached < 0) {
+    const char *env = getenv("RSS_RO_RR");
+    cached = env ? atoi(env) : 0;
+    if (cached < 0)
+      cached = 0;
+  }
+  return cached;
+}
+
+/* Frames an instance must skip after it is granted an occasion. 0 = off. */
+static int rss_ro_cooldown(void)
+{
+  static int cached = -1;
+  if (cached < 0) {
+    const char *env = getenv("RSS_RO_COOLDOWN");
+    cached = env ? atoi(env) : 0;
+    if (cached < 0)
+      cached = 0;
+  }
+  return cached;
+}
+
+/* true = this instance may use the occasion at (frame, slot). */
+static bool rss_ro_claim(int ue, frame_t frame, int slot)
+{
+  if (!rss_ro_arbitrate())
+    return true;
+  const int rr = rss_ro_rr();
+  if (rr > 0 && ((int)frame % rr) != (ue % rr)) {
+    pthread_mutex_lock(&rss_ro_mtx);
+    rss_ro_cooled++;
+    pthread_mutex_unlock(&rss_ro_mtx);
+    return false; /* not this instance's occasion */
+  }
+  bool mine;
+  const int cool = rss_ro_cooldown();
+  const int u = (ue >= 0 && ue < RSS_RO_MAX_UE) ? ue : 0;
+  pthread_mutex_lock(&rss_ro_mtx);
+  if (rss_ro_slot == slot && rss_ro_frame == frame) {
+    mine = (rss_ro_owner == ue); /* occasion already claimed this frame */
+    if (!mine)
+      rss_ro_deferred++;
+  } else if (cool > 0 && rss_ro_last_set[u] && ((int)frame - rss_ro_last[u] + 1024) % 1024 < cool) {
+    mine = false; /* this instance is still cooling down */
+    rss_ro_cooled++;
+  } else {
+    rss_ro_frame = frame;
+    rss_ro_slot = slot;
+    rss_ro_owner = ue;
+    rss_ro_last[u] = (int)frame;
+    rss_ro_last_set[u] = true;
+    mine = true;
+  }
+  if (mine)
+    rss_ro_granted++;
+  const unsigned long tot = rss_ro_granted + rss_ro_deferred + rss_ro_cooled;
+  if ((tot % 500) == 0)
+    LOG_I(NR_MAC,
+          "[RSS] RO arbitration: %lu granted, %lu deferred, %lu skipped (cooldown %d, rr %d)\n",
+          rss_ro_granted, rss_ro_deferred, rss_ro_cooled, cool, rss_ro_rr());
+  pthread_mutex_unlock(&rss_ro_mtx);
+  return mine;
+}
