#!/usr/bin/env bash
# p5 direct ZMQ에서 단일 control 또는 식별자 응답 치환 에뮬레이션을 봉인한다.
set -euo pipefail
umask 077

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONF=${DOWNLINK_IMSI_CONF:-$ROOT/conf/downlink-imsi.conf}
[[ -f $CONF && ! -L $CONF ]] || { echo "안전한 DOWNLINK_IMSI_CONF가 필요합니다: $CONF" >&2; exit 2; }
. "$CONF"

MODE=${1:-}
[[ $MODE != control && $MODE != emulation ]] || shift
ENABLE=0
RUN_ID=
while getopts "e:n:h" option; do
  case $option in
    e) ENABLE=$OPTARG ;;
    n) RUN_ID=$OPTARG ;;
    h) echo "사용법: $0 control|emulation -n RUN_ID [-e 0|1]"; exit 0 ;;
    *) exit 2 ;;
  esac
done

RUN_ROOT=${DOWNLINK_IMSI_RUN_ROOT:-$ROOT/runs}
LOCK_FILE=${DOWNLINK_IMSI_LOCK_FILE:-/tmp/downlink-imsi.lock}
ATTACH_TIMEOUT_S=${ATTACH_TIMEOUT_S:-75}
OBSERVE_TIMEOUT_S=${OBSERVE_TIMEOUT_S:-8}
CU_LOG=${CU_LOG:-/tmp/ocu.log}
CORE_CONTAINER=${CORE_CONTAINER:-open5gs_5gc}
CORE_CONFIG_REMOTE=${CORE_CONFIG_REMOTE:-/root/OCUDU/docker/open5gs/open5gs-5gc.yml}
TUN=${TUN:-oaitun_ue1}
PING_TARGET=${PING_TARGET:-10.45.1.1}
REMOTE_PREFIX=/tmp/downlink-imsi-$RUN_ID
DOWNLINK_IMSI_MANAGE_RAN=${SAME_CELL_DOWNLINK_IMSI_MANAGE_RAN:-${DOWNLINK_IMSI_MANAGE_RAN:-1}}
DU_CFG=${SAME_CELL_GNB_CONFIG:-$DU_CFG}
UE_TX_ENDPOINT=${SAME_CELL_UE_TX_ENDPOINT:-tcp://127.0.0.1:4557}
UE_RX_ENDPOINT=${SAME_CELL_UE_RX_ENDPOINT:-tcp://127.0.0.1:4556}
SAME_CELL_READY_FILE=${SAME_CELL_READY_FILE:-}
SAME_CELL_RAN_READY_FILE=${SAME_CELL_RAN_READY_FILE:-}
SAME_CELL_READY_TIMEOUT_S=${SAME_CELL_READY_TIMEOUT_S:-120}
SAME_CELL_PRESTART=${SAME_CELL_PRESTART:-0}
SAME_CELL_ATTACK_READY_FILE=${SAME_CELL_ATTACK_READY_FILE:-}
SAME_CELL_ATTACK_DONE_FILE=${SAME_CELL_ATTACK_DONE_FILE:-}
SAME_CELL_RELEASE_FILE=${SAME_CELL_RELEASE_FILE:-}

fail() { echo "downlink-imsi-run: $*" >&2; exit 2; }
[[ $MODE == control || $MODE == emulation ]] || fail "mode는 control 또는 emulation이어야 합니다"
[[ $ENABLE == 0 || $ENABLE == 1 ]] || fail "-e는 0 또는 1이어야 합니다"
[[ $MODE == control && $ENABLE == 0 || $MODE == emulation && $ENABLE == 1 ]] || fail "control은 -e 0, emulation은 명시적 -e 1이 필요합니다"
[[ $RUN_ID =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,80}$ ]] || fail "안전한 RUN_ID가 필요합니다"
for value in "$ATTACH_TIMEOUT_S" "$OBSERVE_TIMEOUT_S"; do [[ $value =~ ^[1-9][0-9]*$ ]] || fail "시간 값은 양의 정수여야 합니다"; done
[[ $DOWNLINK_IMSI_MANAGE_RAN == 0 || $DOWNLINK_IMSI_MANAGE_RAN == 1 ]] || fail "DOWNLINK_IMSI_MANAGE_RAN은 0 또는 1이어야 합니다"
[[ $SAME_CELL_PRESTART == 0 || $SAME_CELL_PRESTART == 1 ]] || fail "SAME_CELL_PRESTART는 0 또는 1이어야 합니다"
(( SAME_CELL_PRESTART == 0 || DOWNLINK_IMSI_MANAGE_RAN == 0 )) || fail "prestart는 외부 RAN lifecycle이 필요합니다"
[[ $SAME_CELL_READY_TIMEOUT_S =~ ^[1-9][0-9]*$ ]] || fail "same-cell timeout은 양의 정수여야 합니다"
[[ $UE_TX_ENDPOINT == tcp://127.0.0.1:* && $UE_RX_ENDPOINT == tcp://127.0.0.1:* ]] || fail "UE endpoint는 로컬 tcp ZMQ 주소여야 합니다"
[[ -z $SAME_CELL_READY_FILE || $SAME_CELL_READY_FILE == /* ]] || fail "SAME_CELL_READY_FILE은 절대 경로여야 합니다"
[[ $SAME_CELL_PRESTART == 0 || $SAME_CELL_RAN_READY_FILE == /* ]] || fail "prestart에는 절대 RAN ready 경로가 필요합니다"
[[ $SAME_CELL_PRESTART == 0 || $SAME_CELL_ATTACK_READY_FILE == /* ]] || fail "prestart에는 절대 attack ready 경로가 필요합니다"
[[ $SAME_CELL_PRESTART == 0 || $SAME_CELL_ATTACK_DONE_FILE == /* ]] || fail "prestart에는 절대 attack done 경로가 필요합니다"
[[ $SAME_CELL_PRESTART == 0 || $SAME_CELL_RELEASE_FILE == /* ]] || fail "prestart에는 절대 release 경로가 필요합니다"
for file in "$OAI_BIN" "$UE_CFG" "$UECAP" "$DU_CFG" "$SSH_KEY" "$ROOT/patch/downlink-imsi-ue-w38.patch"; do
  [[ -f $file && ! -L $file ]] || fail "필수 일반 파일이 없습니다: $file"
done
[[ -x $OAI_BIN ]] || fail "OAI_BIN은 실행 가능해야 합니다"
if (( DOWNLINK_IMSI_MANAGE_RAN )); then
  [[ -f $DU_CTL && ! -L $DU_CTL && -x $DU_CTL ]] || fail "DU_CTL은 실행 가능한 일반 파일이어야 합니다"
fi
[[ -n ${CU_HOST:-} ]] || fail "CU_HOST가 필요합니다"
for command in flock ssh scp python3 sha256sum; do command -v "$command" >/dev/null || fail "$command가 필요합니다"; done

ssh_args=(-o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new -i "$SSH_KEY")
[[ -z ${KNOWN_HOSTS:-} ]] || ssh_args+=(-o "UserKnownHostsFile=$KNOWN_HOSTS")
cu() { local quoted; printf -v quoted '%q' "$1"; ssh "${ssh_args[@]}" "$CU_HOST" "sudo bash -lc $quoted"; }

exec 9>"$LOCK_FILE"
flock -n 9 || fail "다른 downlink IMSI 실행이 진행 중입니다"
[[ ! -L $RUN_ROOT ]] || fail "run root는 심볼릭 링크일 수 없습니다"
mkdir -p -m 700 "$RUN_ROOT"
OUT=$RUN_ROOT/$RUN_ID
mkdir -m 700 "$OUT" || fail "기존 실행 결과는 덮어쓰지 않습니다: $OUT"

EXPECTED_FP=$(python3 - "$UE_CFG" <<'PY'
import hashlib, pathlib, re, sys
text = pathlib.Path(sys.argv[1]).read_text()
match = re.search(r'\bimsi\s*=\s*"?([0-9]{14,16})"?', text, re.I)
if not match: raise SystemExit("UE config에서 IMSI 기반 SUPI를 찾지 못했습니다")
print(hashlib.sha256(match.group(1).encode()).hexdigest())
PY
) || fail "가입자 fingerprint를 만들지 못했습니다"
GNB_SHA=$(sha256sum "$DU_CFG" | awk '{print $1}')
CORE_SHA_LINE=$(cu "sha256sum '$CORE_CONFIG_REMOTE'") || fail "코어 설정 해시를 읽지 못했습니다"
CORE_SHA=${CORE_SHA_LINE%% *}
[[ $GNB_SHA =~ ^[0-9a-f]{64}$ && $CORE_SHA =~ ^[0-9a-f]{64}$ ]] || fail "기지국·코어 설정 해시가 잘못됐습니다"

UE_PID=
DU_STARTED=0
CAPTURE_STARTED=0
FORCED_KILL=0
UNEXPECTED_EXIT=0
FINISHED=0
stop_ue() {
  [[ -n $UE_PID ]] || return 0
  if ! kill -0 "$UE_PID" 2>/dev/null; then UNEXPECTED_EXIT=1; wait "$UE_PID" 2>/dev/null || true; return 0; fi
  kill -INT "$UE_PID" 2>/dev/null || true; sleep .2; kill -INT "$UE_PID" 2>/dev/null || true
  for _ in $(seq 1 50); do kill -0 "$UE_PID" 2>/dev/null || break; sleep .1; done
  if kill -0 "$UE_PID" 2>/dev/null; then FORCED_KILL=1; kill -KILL "$UE_PID" 2>/dev/null || true; fi
  wait "$UE_PID" 2>/dev/null || true
}
stop_capture() {
  (( CAPTURE_STARTED == 1 )) || return 0
  cu "kill -INT \$(cat '$REMOTE_PREFIX.tcpdump.pid') 2>/dev/null || true; sleep 1" >/dev/null || true
  CAPTURE_STARTED=0
}
start_capture() {
  cu "rm -f '$REMOTE_PREFIX.ngap.pcap' '$REMOTE_PREFIX.tcpdump.log' '$REMOTE_PREFIX.tcpdump.pid' '$REMOTE_PREFIX.start.utc' '$REMOTE_PREFIX.cu.offset'; date -u +%Y-%m-%dT%H:%M:%S.%NZ >'$REMOTE_PREFIX.start.utc'; stat -c %s '$CU_LOG' >'$REMOTE_PREFIX.cu.offset'; nohup tcpdump -i any -U -s 0 -w '$REMOTE_PREFIX.ngap.pcap' 'sctp port 38412' >'$REMOTE_PREFIX.tcpdump.log' 2>&1 </dev/null & echo \$! >'$REMOTE_PREFIX.tcpdump.pid'; sleep 1; kill -0 \$(cat '$REMOTE_PREFIX.tcpdump.pid')" \
    || fail "N2 capture를 시작하지 못했습니다"
  CAPTURE_STARTED=1
}
cleanup() {
  local status=$?
  set +e
  (( FINISHED == 1 )) || stop_ue
  (( DU_STARTED == 0 )) || "$DU_CTL" stop >/dev/null 2>&1
  stop_capture
  exit "$status"
}
trap cleanup EXIT INT TERM

cu "pgrep -x ocu >/dev/null && test \"\$(docker inspect -f '{{.State.Health.Status}}' '$CORE_CONTAINER')\" = healthy && command -v tshark >/dev/null" \
  || fail "CU·코어·tshark가 준비되지 않았습니다"
(( SAME_CELL_PRESTART )) || start_capture

if (( DOWNLINK_IMSI_MANAGE_RAN )); then
  pgrep -x nr-uesoftmodem >/dev/null && fail "기존 OAI UE가 실행 중입니다"
  "$DU_CTL" stop >/dev/null 2>&1 || true
  "$DU_CTL" start >"$OUT/du-start.log" 2>&1 || fail "DU 시작에 실패했습니다"
  DU_STARTED=1
elif (( SAME_CELL_PRESTART == 0 )); then
  pgrep -x odu >/dev/null || fail "external DU가 실행 중이 아닙니다"
fi

bin_dir=$(dirname "$OAI_BIN")
(
  cd "$bin_dir"
  OAI_DOWNLINK_IMSI_TRACE=1 OAI_DOWNLINK_IMSI_EMULATE=$ENABLE exec setsid stdbuf -oL -eL "$OAI_BIN" \
    -O "$UE_CFG" --band 78 -C 3489420000 --numerology 1 -r 51 -E --ue-scan-carrier \
    --uecap_file "$UECAP" --device.name oai_zmqdevif --num-ues 1 \
    '--zmq.[0].tx_channels' "$UE_TX_ENDPOINT" '--zmq.[0].rx_channels' "$UE_RX_ENDPOINT"
) >"$OUT/ue.log" 2>&1 </dev/null &
UE_PID=$!

if (( SAME_CELL_PRESTART )); then
  started=$SECONDS
  until [[ -f $SAME_CELL_RAN_READY_FILE && ! -L $SAME_CELL_RAN_READY_FILE ]]; do
    kill -0 "$UE_PID" 2>/dev/null || fail "UE가 RAN 준비 전에 종료됐습니다"
    (( SECONDS - started < SAME_CELL_READY_TIMEOUT_S )) || fail "same-cell RAN readiness가 시간 초과했습니다"
    sleep .2
  done
  pgrep -x odu >/dev/null || fail "external DU가 실행 중이 아닙니다"
fi
if [[ -n $SAME_CELL_READY_FILE ]]; then
  started=$SECONDS
  until [[ -f $SAME_CELL_READY_FILE && ! -L $SAME_CELL_READY_FILE ]]; do
    kill -0 "$UE_PID" 2>/dev/null || fail "UE가 normal UE 준비 전에 종료됐습니다"
    (( SECONDS - started < SAME_CELL_READY_TIMEOUT_S )) || fail "same-cell normal UE readiness가 시간 초과했습니다"
    sleep .2
  done
fi
if (( SAME_CELL_PRESTART )); then
  start_capture
  ( set -o noclobber; : >"$SAME_CELL_ATTACK_READY_FILE" ) || fail "same-cell attack readiness 게시 실패"
fi

marker='DOWNLINK_IMSI_EXTRACTOR event=authentication_response_submitted'
[[ $MODE == control ]] || marker='DOWNLINK_IMSI_EXTRACTOR event=identity_response_substituted'
started=$SECONDS
until grep -Fq "$marker" "$OUT/ue.log"; do
  kill -0 "$UE_PID" 2>/dev/null || fail "UE가 예정보다 일찍 종료됐습니다"
  (( SECONDS - started < ATTACH_TIMEOUT_S )) || fail "NAS 목표 메시지를 기다리다 시간 초과했습니다"
  sleep .2
done

REGISTRATION_OK=false; PDU_OK=false; PING_OK=false
if [[ $MODE == control ]]; then
  started=$SECONDS
  until ip -4 -o addr show "$TUN" >/dev/null 2>&1; do
    kill -0 "$UE_PID" 2>/dev/null || fail "control UE가 예정보다 일찍 종료됐습니다"
    (( SECONDS - started < ATTACH_TIMEOUT_S )) || fail "control PDU session이 시간 초과했습니다"
    sleep .2
  done
  REGISTRATION_OK=true; PDU_OK=true
  ping -I "$TUN" -c 3 -W 1 "$PING_TARGET" >/dev/null 2>&1 && PING_OK=true
else
  sleep "$OBSERVE_TIMEOUT_S"
  grep -Fq 'Received Registration Accept' "$OUT/ue.log" && REGISTRATION_OK=true || true
  ip -4 -o addr show "$TUN" >/dev/null 2>&1 && PDU_OK=true || true
  if [[ $PDU_OK == true ]] && ping -I "$TUN" -c 3 -W 1 "$PING_TARGET" >/dev/null 2>&1; then PING_OK=true; fi
fi

kill -0 "$UE_PID" 2>/dev/null || UNEXPECTED_EXIT=1
if (( SAME_CELL_PRESTART )); then
  ( set -o noclobber; : >"$SAME_CELL_ATTACK_DONE_FILE" ) || fail "same-cell attack 완료 게시 실패"
  started=$SECONDS
  until [[ -f $SAME_CELL_RELEASE_FILE && ! -L $SAME_CELL_RELEASE_FILE ]]; do
    kill -0 "$UE_PID" 2>/dev/null || fail "same-cell 종료 허가 전에 UE가 종료됐습니다"
    (( SECONDS - started < SAME_CELL_READY_TIMEOUT_S )) || fail "same-cell 종료 허가가 시간 초과했습니다"
    sleep .2
  done
fi
stop_ue
if (( DOWNLINK_IMSI_MANAGE_RAN )); then
  "$DU_CTL" stop >/dev/null 2>&1
  DU_STARTED=0
fi
stop_capture

cu "O=\$(cat '$REMOTE_PREFIX.cu.offset'); tail -c +\$((O+1)) '$CU_LOG'" >"$OUT/cu.log"
cu "S=\$(cat '$REMOTE_PREFIX.start.utc'); docker logs --timestamps --since \"\$S\" '$CORE_CONTAINER' 2>&1" >"$OUT/amf.log"
scp "${ssh_args[@]}" "$CU_HOST:$REMOTE_PREFIX.ngap.pcap" "$OUT/ngap.pcap" >/dev/null
printf 'frame\ttime_epoch\tsrc\tdst\tran_id\tamf_id\tmessage_type\tscheme_id\tmcc\tmnc\tmsin\n' >"$OUT/nas.raw.tsv"
cu "tshark -r '$REMOTE_PREFIX.ngap.pcap' -Y 'nas-5gs.mm.message_type' -T fields -E separator=/t -e frame.number -e frame.time_epoch -e ip.src -e ip.dst -e ngap.RAN_UE_NGAP_ID -e ngap.AMF_UE_NGAP_ID -e nas-5gs.mm.message_type -e nas-5gs.mm.suci.scheme_id -e e212.mcc -e e212.mnc -e nas-5gs.mm.suci.msin 2>/dev/null" >>"$OUT/nas.raw.tsv"
python3 "$ROOT/analysis/normalize_pcap.py" "$OUT/nas.raw.tsv" "$EXPECTED_FP" "$OUT"
unlink "$OUT/nas.raw.tsv"

printf '{"schema":"downlink-imsi.service.v1","registration_ok":%s,"pdu_session_ok":%s,"ping_ok":%s}\n' "$REGISTRATION_OK" "$PDU_OK" "$PING_OK" >"$OUT/service.json"
printf '{"schema":"downlink-imsi.process.v1","crash_count":%s,"forced_kill_count":%s}\n' "$UNEXPECTED_EXIT" "$FORCED_KILL" >"$OUT/process.json"

export RUN_ID MODE ENABLE ROOT OUT OAI_BIN UE_CFG UECAP GNB_SHA CORE_SHA DOWNLINK_IMSI_MANAGE_RAN
python3 - "$OUT/run.json" "$ROOT/patch/downlink-imsi-ue-w38.patch" "$OAI_BIN" "$UE_CFG" "$UECAP" "$OUT/ngap.pcap" <<'PY'
import hashlib, json, os, pathlib, sys
output, patch, binary, config, uecap, pcap = map(pathlib.Path, sys.argv[1:])
def sha(path): return hashlib.sha256(path.read_bytes()).hexdigest()
value = {
    "schema":"downlink-imsi.run.v1", "run_id":os.environ["RUN_ID"], "mode":os.environ["MODE"],
    "identity_response_substitution_emulated":os.environ["ENABLE"] == "1", "dl_overshadowing_observed":False,
    "source_commit":"6d6782b48484efd935c14e834832032743f9b138", "ue_patch_sha256":sha(patch),
    "ue_binary_sha256":sha(binary), "ue_config_sha256":sha(config), "uecap_sha256":sha(uecap),
    "gnb_config_sha256":os.environ["GNB_SHA"], "core_config_sha256":os.environ["CORE_SHA"],
    "ngap_pcap_sha256":sha(pcap),
    "ran_lifecycle":"managed" if os.environ.get("DOWNLINK_IMSI_MANAGE_RAN", "1") == "1" else "external-persistent",
}
output.write_text(json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n")
PY
python3 "$ROOT/analysis/verify_run.py" "$OUT"
FINISHED=1
echo "완료됨: mode=$MODE output=$OUT"
