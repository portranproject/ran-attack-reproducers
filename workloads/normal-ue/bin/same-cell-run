#!/usr/bin/env bash
# p5 ZMQ의 한 셀에서 공격 UE와 정상 UE 풀을 함께 cold-start한다.
set -euo pipefail
umask 077

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
NORMAL_CTL="$ROOT/workloads/normal-ue/bin/normal-ue"
ACTION=${1:-help}
[[ $# == 0 ]] || shift
STATE=${SAME_CELL_STATE_DIR:-/run/ran-reproducer/same-cell}
LOCK_FILE=${SAME_CELL_LOCK_FILE:-/run/ran-reproducer/same-cell.lock}
CONF=""
RUN_ID=""
COUNT=5
ATTACK=""
COMMAND=()
PLACEHOLDER_CFG=""
REMOTE=0
REMOTE_STATE=""
REMOTE_SSH=()
REMOTE_UE_HOSTS=()
REMOTE_HOST_COUNT=0
REMOTE_CHUNK=0
SLOT_HOST=()
ATTACK_PIDS=()

[[ $STATE == /* && $STATE != / ]] || { echo "same-cell-run: 안전한 절대 상태 경로가 필요합니다" >&2; exit 2; }

usage() {
  cat <<'EOF'
사용법:
  same-cell-run run blind|uplink|uplink-credential-flood|auth-timeout|downlink-imsi|ue-capability|nas-counter-desync -n RUN_ID [--count 5] [--config FILE] -- COMMAND...
  same-cell-run start -n SESSION_ID [--count 5] [--config FILE]  # 정상 UE 개발 세션
  same-cell-run status
  same-cell-run stop
EOF
}
fail() { echo "same-cell-run: $*" >&2; exit 2; }

case $ACTION in
  start)
    while [[ $# -gt 0 ]]; do
      case $1 in
        -n|--session-id) [[ $# -ge 2 ]] || fail "session id 값이 필요합니다"; RUN_ID=$2; shift 2 ;;
        -c|--count) [[ $# -ge 2 ]] || fail "count 값이 필요합니다"; COUNT=$2; shift 2 ;;
        --config) [[ $# -ge 2 ]] || fail "config 값이 필요합니다"; CONF=$2; shift 2 ;;
        *) fail "알 수 없는 옵션: $1" ;;
      esac
    done
    ;;
  run)
    ATTACK=${1:-}; [[ $# == 0 ]] || shift
    while [[ $# -gt 0 && $1 != -- ]]; do
      case $1 in
        -n|--run-id) [[ $# -ge 2 ]] || fail "run id 값이 필요합니다"; RUN_ID=$2; shift 2 ;;
        -c|--count) [[ $# -ge 2 ]] || fail "count 값이 필요합니다"; COUNT=$2; shift 2 ;;
        --config) [[ $# -ge 2 ]] || fail "config 값이 필요합니다"; CONF=$2; shift 2 ;;
        *) fail "알 수 없는 옵션: $1" ;;
      esac
    done
    [[ ${1:-} == -- ]] || fail "공격 command 앞에 --가 필요합니다"
    shift
    (( $# > 0 )) || fail "실행할 공격 command가 필요합니다"
    COMMAND=("$@")
    ;;
  status|stop) (( $# == 0 )) || fail "$ACTION에는 옵션을 받지 않습니다" ;;
  help|-h|--help) usage; exit 0 ;;
  *) usage; fail "알 수 없는 작업: $ACTION" ;;
esac

if [[ $ACTION == start || $ACTION == run ]]; then
  CONF=${CONF:-$ROOT/workloads/normal-ue/conf/p5.conf}
else
  [[ -f $STATE/config.path && ! -L $STATE/config.path ]] || fail "실행 중인 same-cell 세션이 없습니다"
  read -r CONF <"$STATE/config.path"
fi
[[ -f $CONF && ! -L $CONF ]] || fail "안전한 normal UE 설정이 필요합니다: $CONF"
CONF=$(cd "$(dirname "$CONF")" && printf '%s/%s\n' "$PWD" "$(basename "$CONF")")
# shellcheck source=/dev/null
. "$CONF"

NORMAL_UE_RUN_ROOT=${NORMAL_UE_RUN_ROOT:-/var/lib/ran-reproducer/normal-ue}
NORMAL_UE_BROKER_PY=${NORMAL_UE_BROKER_PY:-$ROOT/workloads/normal-ue/tools/same_cell_broker.py}
NORMAL_UE_PHASE_MS=${NORMAL_UE_PHASE_MS:-1000}
NORMAL_UE_RETRY_MS=${NORMAL_UE_RETRY_MS:-5000}
NORMAL_UE_PDU_SESSION_ID=${NORMAL_UE_PDU_SESSION_ID:-}
NORMAL_UE_GATEWAY=${NORMAL_UE_GATEWAY:-10.45.1.1}
NORMAL_UE_GNB_READY_CMD=${NORMAL_UE_GNB_READY_CMD:-}
NORMAL_UE_GNB_CONFIG=${NORMAL_UE_GNB_CONFIG:-}
NORMAL_UE_GNB_LOG=${NORMAL_UE_GNB_LOG:-/tmp/odu.log}
SAME_CELL_ENDPOINT_TIMEOUT_S=${SAME_CELL_ENDPOINT_TIMEOUT_S:-30}
SAME_CELL_HEALTH_TIMEOUT_S=${SAME_CELL_HEALTH_TIMEOUT_S:-120}
SAME_CELL_RECOVERY_TIMEOUT_S=${SAME_CELL_RECOVERY_TIMEOUT_S:-90}
SAME_CELL_GNB_SETTLE_S=${SAME_CELL_GNB_SETTLE_S:-2}
SAME_CELL_ATTACK_WARMUP_S=${SAME_CELL_ATTACK_WARMUP_S:-8}
SAME_CELL_ATTACK_TIMEOUT_S=${SAME_CELL_ATTACK_TIMEOUT_S:-300}
SAME_CELL_NORMAL_PRE_HOLD_S=${SAME_CELL_NORMAL_PRE_HOLD_S:-0}
SAME_CELL_NORMAL_POST_HOLD_S=${SAME_CELL_NORMAL_POST_HOLD_S:-0}
SAME_CELL_EXPERIMENTAL_SWITCH=${SAME_CELL_EXPERIMENTAL_SWITCH:-0}
BASELINE_READY_FILE=${LIVE_E2E_BASELINE_READY_FILE:-}
OBSERVATION_READY_FILE=${LIVE_E2E_OBSERVATION_READY_FILE:-}
if [[ $ACTION == run && $ATTACK == auth-timeout ]]; then
  SAME_CELL_RECOVERY_TIMEOUT_S=${SAME_CELL_AUTH_RECOVERY_TIMEOUT_S:-240}
  export SAME_CELL_AUTH_READY_TIMEOUT_S=${SAME_CELL_AUTH_READY_TIMEOUT_S:-300}
fi
IP_CMD=${IP_CMD:-ip}
PING_CMD=${PING_CMD:-ping}
SS_CMD=${SS_CMD:-ss}
if [[ $ACTION == run ]]; then
  case $ATTACK in
    blind) ATTACK_SLOTS=2 ;;
    uplink|downlink-imsi|ue-capability|nas-counter-desync) ATTACK_SLOTS=1 ;;
    uplink-credential-flood) ATTACK_SLOTS=1 ;;
    auth-timeout) ATTACK_SLOTS=10 ;;
    *) fail "지원하지 않는 same-cell 공격: $ATTACK" ;;
  esac
else
  ATTACK_SLOTS=${SAME_CELL_ATTACK_SLOTS:-4}
fi
if [[ -n ${SAME_CELL_DIAGNOSTIC_ATTACK_SLOTS:-} ]]; then
  [[ $ATTACK == auth-timeout && $SAME_CELL_DIAGNOSTIC_ATTACK_SLOTS =~ ^[1-9][0-9]*$ ]] \
    || fail "SAME_CELL_DIAGNOSTIC_ATTACK_SLOTS는 auth-timeout의 양의 정수여야 합니다"
  ATTACK_SLOTS=$SAME_CELL_DIAGNOSTIC_ATTACK_SLOTS
  export AUTH_STALL_CELL_DIAGNOSTIC_MAX_ENDPOINTS="${SAME_CELL_DIAGNOSTIC_MAX_ENDPOINTS:-120}"
  export NORMAL_UE_BROKER_MAX_ENDPOINTS="${SAME_CELL_DIAGNOSTIC_MAX_ENDPOINTS:-120}"
fi
TOTAL_ENDPOINTS=$((ATTACK_SLOTS + COUNT))

# 진단 옵션: 공격 UE 프로세스만 별도 호스트에서 실행하고 broker는 이 DU에 둔다.
# 여러 대를 쓰려면 SAME_CELL_ATTACK_SSH·SAME_CELL_REMOTE_UE_IP를 쉼표로 나열한다.
# 기본값은 비어 있어 기존 127.0.0.1 경로가 그대로 쓰인다.
ATTACK_SSH=${SAME_CELL_ATTACK_SSH:-}
REMOTE_UE_IP=${SAME_CELL_REMOTE_UE_IP:-}
REMOTE_BROKER_IP=${SAME_CELL_REMOTE_BROKER_IP:-}
REMOTE_STATE=${SAME_CELL_REMOTE_STATE_DIR:-}
if [[ -n $ATTACK_SSH || -n $REMOTE_UE_IP || -n $REMOTE_BROKER_IP ]]; then
  [[ $ATTACK == auth-timeout ]] || fail "원격 공격 UE는 auth-timeout 진단에만 지원합니다"
  [[ -n $ATTACK_SSH && -n $REMOTE_UE_IP && -n $REMOTE_BROKER_IP ]] \
    || fail "원격 공격에는 SAME_CELL_ATTACK_SSH·SAME_CELL_REMOTE_UE_IP·SAME_CELL_REMOTE_BROKER_IP가 모두 필요합니다"
  IFS=, read -r -a REMOTE_SSH <<<"$ATTACK_SSH"
  IFS=, read -r -a REMOTE_UE_HOSTS <<<"$REMOTE_UE_IP"
  REMOTE_HOST_COUNT=${#REMOTE_SSH[@]}
  [[ $REMOTE_HOST_COUNT == "${#REMOTE_UE_HOSTS[@]}" ]] \
    || fail "SAME_CELL_ATTACK_SSH와 SAME_CELL_REMOTE_UE_IP 개수가 같아야 합니다"
  python3 -c 'import ipaddress,sys; [ipaddress.IPv4Address(v) for v in sys.argv[1:]]' \
    "$REMOTE_BROKER_IP" "${REMOTE_UE_HOSTS[@]}" \
    || fail "원격 공격 UE/Broker 주소가 IPv4가 아닙니다"
  # 공격 슬롯을 호스트별로 균등 분배한다. UE 묶음이 5대이므로 나눈 값은 5의 배수여야 한다.
  REMOTE_CHUNK=$(( (ATTACK_SLOTS + REMOTE_HOST_COUNT - 1) / REMOTE_HOST_COUNT ))
  (( REMOTE_CHUNK > 0 && REMOTE_CHUNK % 5 == 0 )) \
    || fail "호스트당 공격 슬롯 수가 5의 배수여야 합니다: $REMOTE_CHUNK"
  REMOTE=1
fi

for command in flock python3 setsid "$IP_CMD" "$PING_CMD" "$SS_CMD"; do
  command -v "$command" >/dev/null || fail "$command가 필요합니다"
done
for path in "$NORMAL_UE_BIN" "$NORMAL_UE_ATTACK_BIN" "$NORMAL_UE_UECAP" \
            "$NORMAL_UE_CFG" "$NORMAL_UE_ATTACK_CFG" "$NORMAL_UE_BROKER_PY" "$NORMAL_UE_GNB_CONFIG"; do
  [[ -f $path && ! -L $path ]] || fail "필수 파일이 없거나 심볼릭 링크입니다: $path"
done
[[ -x $NORMAL_UE_BIN && -x $NORMAL_UE_ATTACK_BIN && -x $NORMAL_CTL ]] \
  || fail "normal/placeholder UE binary와 controller가 실행 가능해야 합니다"
grep -Faq OAI_NORMAL_TUN_SUFFIX "$NORMAL_UE_BIN" \
  || fail "normal UE binary에 normal-tun-suffix.patch가 없습니다"
grep -Faq NORMAL_UE_RECOVERY "$NORMAL_UE_BIN" \
  || fail "normal UE binary에 안전한 연결 회복 패치가 없습니다"
[[ -n $NORMAL_UE_GNB_STOP_CMD && -n $NORMAL_UE_GNB_RESTART_CMD && -n $NORMAL_UE_GNB_READY_CMD ]] \
  || fail "gNB stop/restart/ready 명령이 필요합니다"
grep -Eq 'tx_port=tcp://[^, ]*:2000([, ]|$)' "$NORMAL_UE_GNB_CONFIG" \
  || fail "DU TX가 broker port 2000을 사용해야 합니다"
grep -Eq 'rx_port=tcp://[^, ]*:2001([, ]|$)' "$NORMAL_UE_GNB_CONFIG" \
  || fail "DU RX가 broker port 2001을 사용해야 합니다"
for value in "$SAME_CELL_ENDPOINT_TIMEOUT_S" "$SAME_CELL_HEALTH_TIMEOUT_S" \
             "$SAME_CELL_RECOVERY_TIMEOUT_S" "$SAME_CELL_GNB_SETTLE_S" "$SAME_CELL_ATTACK_WARMUP_S" \
             "$SAME_CELL_NORMAL_PRE_HOLD_S" "$SAME_CELL_NORMAL_POST_HOLD_S"; do
  [[ $value =~ ^[0-9]+$ ]] || fail "timeout/settle/hold 값은 정수여야 합니다"
done
(( SAME_CELL_NORMAL_PRE_HOLD_S <= 600 && SAME_CELL_NORMAL_POST_HOLD_S <= 600 )) \
  || fail "SAME_CELL_NORMAL_PRE/POST_HOLD_S는 600초 이하여야 합니다"
[[ $SAME_CELL_ATTACK_TIMEOUT_S =~ ^[1-9][0-9]*$ && $SAME_CELL_ATTACK_TIMEOUT_S -le 600 ]] \
  || fail "SAME_CELL_ATTACK_TIMEOUT_S는 1..600초여야 합니다"
[[ $SAME_CELL_EXPERIMENTAL_SWITCH == 0 || $SAME_CELL_EXPERIMENTAL_SWITCH == 1 ]] \
  || fail "SAME_CELL_EXPERIMENTAL_SWITCH는 0 또는 1이어야 합니다"
[[ -z $BASELINE_READY_FILE && -z $OBSERVATION_READY_FILE \
   || $BASELINE_READY_FILE == /* && $OBSERVATION_READY_FILE == /* ]] \
  || fail "live E2E 기준선 marker는 둘 다 절대 경로여야 합니다"

mkdir -p "$(dirname "$LOCK_FILE")"
exec 9>"$LOCK_FILE"
flock -n 9 || fail "다른 same-cell 작업이 진행 중입니다"

pid_starttime() { awk '{print $22}' "/proc/$1/stat" 2>/dev/null || true; }
is_running() {
  local state
  [[ $1 =~ ^[1-9][0-9]*$ ]] && kill -0 "$1" 2>/dev/null || return 1
  state=$(ps -o stat= -p "$1" 2>/dev/null | tr -d ' ')
  [[ -n $state && $state != Z* ]]
}
record_pid() {
  printf '%s\n' "$2" >"$STATE/$1.pid"
  printf '%s\n' "$(pid_starttime "$2")" >"$STATE/$1.starttime"
}
clear_state() {
  if [[ -d $STATE/placeholders && ! -L $STATE/placeholders ]]; then
    find "$STATE/placeholders" -xdev -mindepth 1 -maxdepth 1 -type f -delete
    rmdir "$STATE/placeholders"
  fi
  find "$STATE" -xdev -mindepth 1 -maxdepth 1 -type f -delete
  rmdir "$STATE"
}
owned_pid() {
  local role=$1 pid expected actual
  [[ -f $STATE/$role.pid && -f $STATE/$role.starttime ]] || return 1
  read -r pid <"$STATE/$role.pid"; read -r expected <"$STATE/$role.starttime"
  is_running "$pid" || return 1
  actual=$(pid_starttime "$pid")
  [[ -n $actual && $actual == "$expected" ]] || return 1
  echo "$pid"
}
stop_normal_ue() {
  local pid=$1
  is_running "$pid" || return 0
  # normal UE 5대는 한 OAI 프로세스다. 첫 INT의 NAS deregistration이 끝날
  # 시간을 주고, 그래도 남으면 TERM, 마지막에만 KILL로 올린다.
  kill -INT -- "-$pid" 2>/dev/null || true
  for _ in {1..50}; do is_running "$pid" || return 0; sleep .2; done
  kill -TERM -- "-$pid" 2>/dev/null || true
  for _ in {1..50}; do is_running "$pid" || return 0; sleep .2; done
  kill -KILL -- "-$pid" 2>/dev/null || true
}
stop_group() {
  local pid=$1 signal=${2:-INT}
  is_running "$pid" || return 0
  kill -"$signal" -- "-$pid" 2>/dev/null || true
  sleep .2
  kill -"$signal" -- "-$pid" 2>/dev/null || true
  # runner trap이 UE·원격 telemetry까지 정리할 시간을 준 뒤에만 강제 종료한다.
  for _ in {1..300}; do is_running "$pid" || return 0; sleep .2; done
  kill -KILL -- "-$pid" 2>/dev/null || true
}
port_ready() { "$SS_CMD" -H -ltn 2>/dev/null | awk '{print $4}' | grep -Eq ":$1$"; }
# 원격 공격 호스트는 ssh 한 줄 명령만 받으므로 인자 하나짜리 문자열로 보낸다.
remote_sh() {
  local index=$1 command=$2
  local -a cmd
  read -r -a cmd <<<"${REMOTE_SSH[$index]}"
  "${cmd[@]}" "$command"
}
remote_port_ready() { remote_sh "$1" "ss -H -ltn 2>/dev/null | awk '{print \$4}' | grep -Eq ':$2\$'"; }
remote_marker() { remote_sh "$1" "test -f '$2' -a ! -L '$2'"; }
remote_publish() { remote_sh "$1" "bash -c 'set -o noclobber; : > \"\$1\"' _ '$2'"; }
remote_gate() { remote_sh "$1" "bash -c 'printf \"%s\\n\" \"\$1\" > \"\$2\"' _ '$2' '$REMOTE_STATE/attack-ue-gate'"; }
remote_stop_runner() {
  local host=0 pid
  for ((host=0; host<REMOTE_HOST_COUNT; host++)); do
    pid=$(remote_sh "$host" "cat '$REMOTE_STATE/runner.pid' 2>/dev/null" || true)
    [[ $pid =~ ^[1-9][0-9]*$ ]] || continue
    remote_sh "$host" "bash -c 'kill -TERM -- -\$1 2>/dev/null || true' _ '$pid'" || true
    for _ in {1..100}; do
      remote_sh "$host" "bash -c 'kill -0 -- -\$1 2>/dev/null' _ '$pid'" || break
      sleep .1
    done
    remote_sh "$host" "bash -c 'kill -KILL -- -\$1 2>/dev/null || true' _ '$pid'" || true
  done
}
wait_port() {
  local port=$1 started=$SECONDS
  until port_ready "$port"; do
    (( SECONDS - started < SAME_CELL_ENDPOINT_TIMEOUT_S )) || return 1
    sleep .2
  done
}
wait_process_port() {
  local pid=$1 port=$2 started=$SECONDS
  until port_ready "$port"; do
    is_running "$pid" || return 2
    (( SECONDS - started < SAME_CELL_ENDPOINT_TIMEOUT_S )) || return 1
    sleep .2
  done
}
wait_attack_port() { wait_process_port "${ATTACK_PIDS[0]}" "$1"; }
wait_remote_attack_port() {
  local host=$1 port=$2 started=$SECONDS
  until remote_port_ready "$host" "$port"; do
    attack_running || return 2
    (( SECONDS - started < SAME_CELL_ENDPOINT_TIMEOUT_S )) || return 1
    sleep .2
  done
}
attack_running() {
  local pid
  ((${#ATTACK_PIDS[@]})) || return 1
  for pid in "${ATTACK_PIDS[@]}"; do
    is_running "$pid" && return 0
  done
  return 1
}
wait_port_free() {
  local port=$1 started=$SECONDS
  while port_ready "$port"; do
    (( SECONDS - started < SAME_CELL_ENDPOINT_TIMEOUT_S )) || return 1
    sleep .2
  done
}
health() {
  local count=$1 ok=0 iface
  for ((i=1; i<=count; i++)); do
    iface="oaitun_ue${i}p${NORMAL_UE_PDU_SESSION_ID}"
    "$IP_CMD" -4 -o addr show "$iface" >/dev/null 2>&1 \
      && "$PING_CMD" -n -I "$iface" -c 1 -W 1 "$NORMAL_UE_GATEWAY" >/dev/null 2>&1 \
      && ok=$((ok + 1)) || true
  done
  printf '%s\n' "$ok"
}
record_health() {
  local phase=$1 output=${2:-$RUN_OUT/normal-health.jsonl} iface tun_ok ping_ok timestamp healthy=0
  timestamp=$(date +%s%N)
  for ((i=1; i<=COUNT; i++)); do
    iface="oaitun_ue${i}p${NORMAL_UE_PDU_SESSION_ID}"
    tun_ok=false; ping_ok=false
    if "$IP_CMD" -4 -o addr show "$iface" >/dev/null 2>&1; then
      tun_ok=true
      "$PING_CMD" -n -I "$iface" -c 1 -W 1 "$NORMAL_UE_GATEWAY" >/dev/null 2>&1 \
        && { ping_ok=true; healthy=$((healthy + 1)); } || true
    fi
    printf '{"schema":"same-cell.normal-health.v1","run_id":"%s","phase":"%s","realtime_ns":%s,"ue":%d,"interface":"%s","tun_ok":%s,"ping_ok":%s}\n' \
      "$RUN_ID" "$phase" "$timestamp" "$i" "$iface" "$tun_ok" "$ping_ok" \
      >>"$output"
  done
  (( healthy == COUNT ))
}
record_healthy() {
  local phase=$1 sample="$RUN_OUT/.normal-health-$1.jsonl"
  : >"$sample"
  if record_health "$phase" "$sample"; then
    cat "$sample" >>"$RUN_OUT/normal-health.jsonl"
    rm -f -- "$sample"
    return 0
  fi
  rm -f -- "$sample"
  return 1
}
normal_hold() {
  local seconds=$1 phase=$2 deadline healthy
  (( seconds > 0 )) || return 0
  deadline=$((SECONDS + seconds))
  while (( SECONDS < deadline )); do
    is_running "$NORMAL_PID" || return 1
    healthy=$(health "$COUNT")
    printf '%s\t%s\t%s\n' "$(date +%s%N)" "$phase" "$healthy" >>"$RUN_OUT/normal-hold.tsv"
    sleep 1
  done
}
embed_self_live_evidence() {
  python3 - "$CHILD_OUTPUT" "$RUN_OUT/run.json" "$RUN_OUT/session.json" \
    "$RUN_OUT/normal-health.jsonl" "$RUN_OUT/broker.log" "$RUN_OUT/normal-hold.tsv" <<'PY'
import hashlib
import json
import os
import pathlib
import sys

child, wrapper_path, session_path, health_path, broker_path, hold_path = map(pathlib.Path, sys.argv[1:])
paths = [child / name for name in ("run.json", "oracle.jsonl", "verdict.json", "report.md", "evidence_manifest.json")]
paths += [wrapper_path, session_path, health_path, broker_path]
if hold_path.is_symlink():
    raise SystemExit("same-cell normal-hold.tsv가 심볼릭 링크입니다")
if hold_path.is_file():
    paths.append(hold_path)
if any(path.is_symlink() or not path.is_file() for path in paths):
    raise SystemExit("same-cell 최종 증거 파일이 안전하지 않습니다")
health = [json.loads(line) for line in health_path.read_text(encoding="utf-8").splitlines() if line]
before = {row.get("ue") for row in health if row.get("phase") == "before" and row.get("ping_ok") is True}
after = {row.get("ue") for row in health if row.get("phase") == "after" and row.get("ping_ok") is True}
if before != set(range(1, 6)) or after != set(range(1, 6)):
    raise SystemExit("same-cell 정상 UE 전후 5/5 증거가 없습니다")
summary = {
    "wrapper": json.loads(wrapper_path.read_text(encoding="utf-8")),
    "session": json.loads(session_path.read_text(encoding="utf-8")),
    "normal_health": health,
    "broker_sha256": hashlib.sha256(broker_path.read_bytes()).hexdigest(),
}
hour_guard = {}
for variable, key in (("HOUR_GUARD_WAIT_STARTED_AT", "wait_started_at"),
                      ("HOUR_GUARD_WAIT_ENDED_AT", "wait_ended_at")):
    value = os.environ.get(variable, "")
    if value:
        hour_guard[key] = value
waited = os.environ.get("HOUR_GUARD_WAIT_S", "")
if waited:
    if not waited.isdigit():
        raise SystemExit("정각 대기 시간이 잘못됐습니다")
    hour_guard["waited_s"] = int(waited)
if hour_guard:
    summary["hour_guard"] = hour_guard
run = json.loads((child / "run.json").read_text(encoding="utf-8"))
run["same_cell"] = summary
(child / "run.json").write_text(json.dumps(run, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
oracle_rows = [json.loads(line) for line in (child / "oracle.jsonl").read_text(encoding="utf-8").splitlines() if line]
if len(oracle_rows) != 1:
    raise SystemExit("same-cell oracle은 객체 한 줄이어야 합니다")
oracle_rows[0]["same_cell"] = summary
(child / "oracle.jsonl").write_text(json.dumps(oracle_rows[0], sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8")
verdict = json.loads((child / "verdict.json").read_text(encoding="utf-8"))
verdict.setdefault("dimensions", {})["normal_ue_coexistence"] = "pass"
(child / "verdict.json").write_text(json.dumps(verdict, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
with (child / "report.md").open("a", encoding="utf-8") as output:
    output.write("- 같은 DU·셀 정상 UE 공격 전/후: `5/5`, `5/5`\n")
manifest = json.loads((child / "evidence_manifest.json").read_text(encoding="utf-8"))
if hold_path.is_file():
    target = child / "same-cell-normal-hold.tsv"
    if target.exists() or target.is_symlink():
        raise SystemExit("same-cell normal-hold.tsv 증거가 이미 있습니다")
    target.write_bytes(hold_path.read_bytes())
    manifest["files"][target.name] = {"size": target.stat().st_size,
                                      "sha256": hashlib.sha256(target.read_bytes()).hexdigest()}
for name in ("run.json", "oracle.jsonl", "verdict.json", "report.md"):
    path = child / name
    manifest["files"][name] = {"size": path.stat().st_size, "sha256": hashlib.sha256(path.read_bytes()).hexdigest()}
(child / "evidence_manifest.json").write_text(json.dumps(manifest, sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8")
PY
}
wait_healthy() {
  local count=$1 timeout=$2 started=$SECONDS
  while :; do
    [[ $(health "$count") == "$count" ]] && return 0
    (( SECONDS - started < timeout )) || return 1
    sleep 1
  done
}
normal_args() {
  NORMAL_ARGS=(--band 78 -C 3489420000 --numerology 1 -r 51 -E --ue-scan-carrier
    --uecap_file "$NORMAL_UE_UECAP" --device.name oai_zmqdevif)
}
rss_args() {
  RSS_ARGS=(--rss.enable 1 --rss.interval_ms 0 --rss.completion_pct 0 --rss.ack_gate 1
    --rss.ra_gate 1 --rss.gate_timeout_ms 500 --rss.target_occupancy 0 --rss.hold_ms 2000
    --rss.msg4_ack 1)
}
resolve_pdu_session_id() {
  if [[ -z $NORMAL_UE_PDU_SESSION_ID ]]; then
    NORMAL_UE_PDU_SESSION_ID=$(python3 - "$NORMAL_UE_CFG" "$COUNT" <<'PY'
import pathlib, re, sys
text = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8")
blocks = re.findall(r"(?ms)^\s*uicc\d+\s*=\s*\{.*?(?=^\s*uicc\d+\s*=|\Z)", text)[:int(sys.argv[2])]
ids = []
for block in blocks:
    sessions = re.search(r"(?s)pdu_sessions\s*=\s*\((.*?)\)\s*;", block)
    match = sessions and re.search(r"\bid\s*=\s*(\d+)", sessions.group(1))
    if not match: raise SystemExit("normal UE PDU session id를 읽지 못했습니다")
    ids.append(int(match.group(1)))
if not ids or len(set(ids)) != 1: raise SystemExit("normal UE PDU session id가 서로 다릅니다")
print(ids[0])
PY
    ) || fail "normal UE PDU session id 검증에 실패했습니다"
  fi
  [[ $NORMAL_UE_PDU_SESSION_ID =~ ^[1-9][0-9]*$ && $NORMAL_UE_PDU_SESSION_ID -le 255 ]] \
    || fail "NORMAL_UE_PDU_SESSION_ID는 1..255여야 합니다"
  printf '%s\n' "$NORMAL_UE_PDU_SESSION_ID" >"$STATE/pdu_session_id"
}
start_normal_group() {
  local runtime_cfg=$1 run_id=$2
  normal_args; rss_args
  setsid env RSS_SHARE_NUE="$COUNT" OAI_NORMAL_TUN_SUFFIX=1 "$NORMAL_UE_BIN" -O "$runtime_cfg" \
    "${NORMAL_ARGS[@]}" "${RSS_ARGS[@]}" --num-ues "$COUNT" --rss.max_duration_s 0 \
    --rss.honor_reject 0 --rss.msg4_wait 1 --rss.probe_ues "$COUNT" --rss.probe_delay_ms 0 \
    --rss.probe_ra_only 0 --rss.probe_interval_ms "$NORMAL_UE_RETRY_MS" \
    --rss.phase_ms "$NORMAL_UE_PHASE_MS" --rss.run_id "n-$run_id" \
    --rss.log_file "$RUN_OUT/normal.jsonl" >"$RUN_OUT/normal.log" 2>&1 </dev/null 9>&- &
  record_pid normal "$!"
}
start_persistent_broker() {
  local -a remote_broker=()
  local host first last map=""
  if (( REMOTE )); then
    # DL은 모든 인터페이스에 bind해 로컬 127.0.0.1 정상 UE와 원격 공격 UE를 함께 받는다.
    for ((host=0; host<REMOTE_HOST_COUNT; host++)); do
      first=$((host * REMOTE_CHUNK + 1))
      last=$(( (host + 1) * REMOTE_CHUNK ))
      (( last <= ATTACK_SLOTS )) || last=$ATTACK_SLOTS
      map+="${first}-${last}=${REMOTE_UE_HOSTS[$host]},"
    done
    remote_broker=(NORMAL_UE_BROKER_BIND_ADDR="${SAME_CELL_REMOTE_BIND_ADDR:-0.0.0.0}"
      NORMAL_UE_BROKER_REMOTE_HOSTS="${map%,}")
  fi
  setsid env NORMAL_UE_BROKER_ENDPOINTS="$TOTAL_ENDPOINTS" \
    NORMAL_UE_BROKER_ATTACK_SLOTS="$ATTACK_SLOTS" NORMAL_UE_BROKER_PERSISTENT_ATTACK=1 \
    NORMAL_UE_BROKER_CONTROL="$STATE/broker-control" "${remote_broker[@]}" python3 "$NORMAL_UE_BROKER_PY" \
    >>"$RUN_OUT/broker.log" 2>&1 </dev/null 9>&- &
  record_pid broker "$!"
  BROKER_PID=$(owned_pid broker) || fail "broker PID를 기록하지 못했습니다"
  sleep 2
  is_running "$BROKER_PID" || fail "broker가 준비 전에 종료됐습니다"
}
start_placeholder_group() {
  local generation=${1:-1} pid endpoint
  normal_args; rss_args
  setsid env RSS_SHARE_NUE="$ATTACK_SLOTS" "$NORMAL_UE_ATTACK_BIN" -O "$PLACEHOLDER_CFG" \
    "${NORMAL_ARGS[@]}" "${RSS_ARGS[@]}" --num-ues "$ATTACK_SLOTS" --rss.max_duration_s 0 \
    --rss.honor_reject 0 --rss.msg4_wait 1 --rss.probe_ues "$ATTACK_SLOTS" --rss.probe_delay_ms 86400000 \
    --rss.probe_ra_only 0 --rss.probe_interval_ms 1000 --rss.phase_ms 0 \
    --rss.run_id "pg-$generation" --rss.log_file "$RUN_OUT/placeholders/group-$generation.jsonl" \
    >>"$RUN_OUT/placeholders/group.log" 2>&1 </dev/null 9>&- &
  pid=$!
  record_pid placeholder-group "$pid"
  for ((endpoint=1; endpoint<=ATTACK_SLOTS; endpoint++)); do
    wait_process_port "$pid" "$((2001 + 100 * endpoint))" \
      || fail "placeholder group endpoint $endpoint가 준비되기 전에 프로세스가 종료되거나 시간 초과했습니다"
  done
}
stop_placeholder_group() {
  local pid endpoint
  pid=$(owned_pid placeholder-group) || fail "placeholder group 소유 PID가 없습니다"
  stop_group "$pid"
  for ((endpoint=1; endpoint<=ATTACK_SLOTS; endpoint++)); do
    wait_port_free "$((2001 + 100 * endpoint))" || fail "placeholder group endpoint $endpoint가 해제되지 않았습니다"
  done
  unlink "$STATE/placeholder-group.pid"
  unlink "$STATE/placeholder-group.starttime"
}
write_gate() {
  local host
  if (( REMOTE )); then
    for ((host=0; host<REMOTE_HOST_COUNT; host++)); do remote_gate "$host" "$1"; done
  else
    printf '%s\n' "$1" >"$STATE/attack-ue-gate"
  fi
}
marker_present() {
  local host
  if (( REMOTE )); then
    for ((host=0; host<REMOTE_HOST_COUNT; host++)); do
      remote_marker "$host" "$REMOTE_STATE/$1" || return 1
    done
    return 0
  fi
  [[ -f $STATE/$1 && ! -L $STATE/$1 ]]
}
marker_publish() {
  local host
  if (( REMOTE )); then
    for ((host=0; host<REMOTE_HOST_COUNT; host++)); do remote_publish "$host" "$REMOTE_STATE/$1"; done
  else
    ( set -o noclobber; : >"$STATE/$1" )
  fi
}
select_broker() {
  local mode=$1 before started=$SECONDS count slots=""
  shift
  [[ $mode == placeholder || $mode == standby || $mode == warmup || $mode == attack || $mode == retire ]] || return 1
  if [[ $mode == placeholder || $mode == standby || $mode == retire ]]; then
    write_gate standby
  fi
  if [[ $mode == warmup || $mode == attack ]]; then
    slots=$(IFS=,; echo "$*")
    printf '%s %s\n' "$mode" "$slots" >"$STATE/broker-control"
  else
    printf '%s\n' "$mode" >"$STATE/broker-control"
  fi
  before=$(grep -c '^SAME_CELL_SLOT_SELECTION ' "$RUN_OUT/broker.log" 2>/dev/null || true)
  kill -USR1 "$BROKER_PID" || return 1
  while :; do
    count=$(grep -c '^SAME_CELL_SLOT_SELECTION ' "$RUN_OUT/broker.log" 2>/dev/null || true)
    if (( count > before )); then
      [[ $mode != attack ]] || write_gate attack
      return 0
    fi
    is_running "$BROKER_PID" || return 1
    (( SECONDS - started < SAME_CELL_ENDPOINT_TIMEOUT_S )) || return 1
    sleep .1
  done
}

if [[ $ACTION == run ]]; then
  [[ $RUN_ID =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$ ]] || fail "안전한 run id가 필요합니다"
  [[ $COUNT =~ ^[1-9][0-9]*$ && $COUNT -le 7 ]] || fail "count는 1..7이어야 합니다"
  (( TOTAL_ENDPOINTS <= ${SAME_CELL_DIAGNOSTIC_MAX_ENDPOINTS:-15} )) \
    || fail "공격 UE endpoint와 normal UE 합계가 허용 한도를 넘었습니다: $TOTAL_ENDPOINTS"
  [[ ! -e $STATE ]] || fail "same-cell 상태 디렉터리가 이미 있습니다: $STATE"
  pgrep -x nr-uesoftmodem >/dev/null 2>&1 && fail "기존 OAI UE가 있습니다"
  mkdir -m 700 "$STATE"
  RUN_OUT="$NORMAL_UE_RUN_ROOT/same-cell/$RUN_ID"
  [[ ! -e $RUN_OUT ]] || fail "run id가 이미 존재합니다: $RUN_OUT"
  mkdir -m 700 -p "$RUN_OUT"
  printf '%s\n' "$CONF" >"$STATE/config.path"
  printf '%s\n' "$COUNT" >"$STATE/count"
  printf '%s\n' "$RUN_ID" >"$STATE/session_id"
  printf '%s\n' "$RUN_OUT" >"$STATE/run_root"
  RUNTIME_CFG=$(SAME_CELL_NORMAL_STATE_DIR="$STATE" NORMAL_UE_ZMQ_ENDPOINT_OFFSET="$ATTACK_SLOTS" \
    "$NORMAL_CTL" prepare --config "$CONF" --count "$COUNT")
  resolve_pdu_session_id

  ENDPOINTS_FILE="$STATE/attack-endpoints.txt"
  if (( REMOTE )); then
    REMOTE_STATE=${REMOTE_STATE:-/tmp/ran-reproducer/same-cell-$RUN_ID}
    [[ $REMOTE_STATE == /* && $REMOTE_STATE != / ]] || fail "원격 상태 경로는 절대 경로여야 합니다"
    for ((host=0; host<REMOTE_HOST_COUNT; host++)); do
      remote_sh "$host" "mkdir -p -m 700 '$REMOTE_STATE'" \
        || fail "원격 상태 디렉터리를 만들지 못했습니다: $((host + 1))번 호스트"
      first=$((host * REMOTE_CHUNK + 1))
      last=$(( (host + 1) * REMOTE_CHUNK ))
      (( last <= ATTACK_SLOTS )) || last=$ATTACK_SLOTS
      (( first <= last )) || fail "원격 공격 호스트에 배정된 슬롯이 없습니다: $((host + 1))번"
      host_endpoints="$RUN_OUT/attack-endpoints-$((host + 1)).txt"
      : >"$host_endpoints"
      for ((i=first; i<=last; i++)); do
        SLOT_HOST[$i]=$host
        printf 'tcp://%s:%d tcp://%s:%d\n' \
          "${REMOTE_UE_HOSTS[$host]}" "$((2001 + 100 * i))" "$REMOTE_BROKER_IP" "$((2000 + 100 * i))" \
          >>"$host_endpoints"
      done
      remote_sh "$host" "bash -c 'umask 077; cat > \"\$1\"' _ '$REMOTE_STATE/attack-endpoints.txt'" <"$host_endpoints" \
        || fail "원격 endpoint 목록을 전달하지 못했습니다: $((host + 1))번 호스트"
    done
  else
    for ((i=1; i<=ATTACK_SLOTS; i++)); do
      printf 'tcp://127.0.0.1:%d tcp://127.0.0.1:%d\n' \
        "$((2001 + 100 * i))" "$((2000 + 100 * i))" >>"$ENDPOINTS_FILE"
    done
  fi
  printf 'standby\n' >"$STATE/broker-control"
  write_gate standby

  ATTACK_PID=""
  ATTACK_PIDS=()
  BROKER_PID=""
  NORMAL_PID=""
  DU_PID=""
  GNB_RESTARTED=0
  cleanup_cold_run() {
    local status=$? pid
    trap - EXIT INT TERM
    (( REMOTE )) && remote_stop_runner
    for pid in "${ATTACK_PIDS[@]}"; do [[ -z $pid ]] || stop_group "$pid" TERM; done
    [[ -z $ATTACK_PID ]] || stop_group "$ATTACK_PID" TERM
    pid=$(owned_pid broker 2>/dev/null || true); [[ -z $pid ]] || stop_group "$pid"
    pid=$(owned_pid normal 2>/dev/null || true); [[ -z $pid ]] || stop_normal_ue "$pid"
    pid=$(owned_pid du 2>/dev/null || true); [[ -z $pid ]] || stop_group "$pid"
    (( GNB_RESTARTED == 0 )) || bash -c "$NORMAL_UE_GNB_STOP_CMD" >/dev/null 2>&1 || true
    clear_state 2>/dev/null || true
    exit "$status"
  }
  trap cleanup_cold_run EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  export SAME_CELL_PRESTART=1
  export SAME_CELL_RAN_READY_FILE="$STATE/ran.ready"
  export SAME_CELL_READY_FILE="$STATE/normal.ready"
  export SAME_CELL_ATTACK_READY_FILE="$STATE/attack.ready"
  export SAME_CELL_ATTACK_DONE_FILE="$STATE/attack.done"
  export SAME_CELL_RELEASE_FILE="$STATE/attack.release"
  export SAME_CELL_UE_GATE_FILE="$STATE/attack-ue-gate"
  export SAME_CELL_READY_TIMEOUT_S=$((SAME_CELL_HEALTH_TIMEOUT_S + 30 + SAME_CELL_NORMAL_PRE_HOLD_S + SAME_CELL_NORMAL_POST_HOLD_S))
  # blind control은 target 게이트를 열지 않으므로 공격 UE 기동~teardown을 게이트 기한이 덮어야 한다.
  export SAME_CELL_ATTACKER_GATE_TIMEOUT_S=$((240 + SAME_CELL_NORMAL_PRE_HOLD_S + SAME_CELL_NORMAL_POST_HOLD_S))
  export P5_EXTERNAL_RAN=1 SAME_CELL_UE_ENDPOINTS_FILE="$ENDPOINTS_FILE"
  export SAME_CELL_DU_LOG="$NORMAL_UE_GNB_LOG" SAME_CELL_GNB_CONFIG="$NORMAL_UE_GNB_CONFIG"
  export SAME_CELL_BLIND_MANAGE_DU=0 SAME_CELL_UPLINK_MANAGE_RAN=0 SAME_CELL_CREDENTIAL_FLOOD_MANAGE_RAN=0
  export SAME_CELL_AUTH_TIMEOUT_MANAGE_DU=0
  export SAME_CELL_DOWNLINK_IMSI_MANAGE_RAN=0 SAME_CELL_UE_CAPABILITY_MANAGE_RAN=0
  export SAME_CELL_NAS_DESYNC_MANAGE_RAN=0
  export SAME_CELL_VICTIM_TX_ENDPOINT="tcp://127.0.0.1:2101"
  export SAME_CELL_VICTIM_RX_ENDPOINT="tcp://127.0.0.1:2100"
  export SAME_CELL_VICTIM_TUN=oaitun_ue1
  export SAME_CELL_ATTACKER_TX_ENDPOINT="tcp://127.0.0.1:2201"
  export SAME_CELL_ATTACKER_RX_ENDPOINT="tcp://127.0.0.1:2200"
  export SAME_CELL_UE_TX_ENDPOINT="$SAME_CELL_VICTIM_TX_ENDPOINT"
  export SAME_CELL_UE_RX_ENDPOINT="$SAME_CELL_VICTIM_RX_ENDPOINT"

  if [[ -n ${SAME_CELL_DIAGNOSTIC_ATTACK_SLOTS:-} ]]; then
    export AUTH_STALL_CELL_SCALE_UE_COUNT="$ATTACK_SLOTS"
    export AUTH_STALL_CELL_SCALE_PROCESS_COUNT=$(((ATTACK_SLOTS + 4) / 5))
    export AUTH_STALL_CELL_SCALE_UES_PER_PROCESS=5
    export AUTH_STALL_CELL_DIAGNOSTIC_SCALE=1
  fi
  start_normal_group "$RUNTIME_CFG" "$RUN_ID"
  NORMAL_PID=$(owned_pid normal) || fail "normal UE PID를 기록하지 못했습니다"
  if (( REMOTE )); then
    # 호스트마다 자기 슬롯만 실행한다. 설정·endpoint는 전역 번호를 유지해 한 셀에 겹치지 않는다.
    for ((host=0; host<REMOTE_HOST_COUNT; host++)); do
      first=$((host * REMOTE_CHUNK + 1))
      last=$(( (host + 1) * REMOTE_CHUNK ))
      (( last <= ATTACK_SLOTS )) || last=$ATTACK_SLOTS
      host_ues=$((last - first + 1))
      remote_env=(SAME_CELL_PRESTART=1 SAME_CELL_REMOTE_ATTACK=1
        SAME_CELL_REMOTE_UE_IP="${REMOTE_UE_HOSTS[$host]}" SAME_CELL_REMOTE_BROKER_IP="$REMOTE_BROKER_IP"
        SAME_CELL_AUTH_TIMEOUT_MANAGE_DU=0
        SAME_CELL_RAN_READY_FILE="$REMOTE_STATE/ran.ready"
        SAME_CELL_READY_FILE="$REMOTE_STATE/normal.ready"
        SAME_CELL_ATTACK_READY_FILE="$REMOTE_STATE/attack.ready"
        SAME_CELL_ATTACK_DONE_FILE="$REMOTE_STATE/attack.done"
        SAME_CELL_RELEASE_FILE="$REMOTE_STATE/attack.release"
        SAME_CELL_UE_GATE_FILE="$REMOTE_STATE/attack-ue-gate"
        SAME_CELL_UE_ENDPOINTS_FILE="$REMOTE_STATE/attack-endpoints.txt"
        SAME_CELL_AUTH_READY_TIMEOUT_S=$((SAME_CELL_HEALTH_TIMEOUT_S + 30 + SAME_CELL_NORMAL_PRE_HOLD_S + SAME_CELL_NORMAL_POST_HOLD_S)))
      if [[ -n ${SAME_CELL_DIAGNOSTIC_ATTACK_SLOTS:-} ]]; then
        remote_env+=(AUTH_STALL_CELL_SCALE_UE_COUNT="$host_ues"
          AUTH_STALL_CELL_SCALE_PROCESS_COUNT=$((host_ues / 5))
          AUTH_STALL_CELL_SCALE_UES_PER_PROCESS=5 AUTH_STALL_CELL_DIAGNOSTIC_SCALE=1
          AUTH_STALL_CELL_SCALE_ENDPOINT_OFFSET=$((first - 1))
          AUTH_STALL_CELL_SCALE_CONFIG_OFFSET=$(((first - 1) / 5))
          AUTH_STALL_CELL_DIAGNOSTIC_MAX_ENDPOINTS="${SAME_CELL_DIAGNOSTIC_MAX_ENDPOINTS:-120}")
      fi
      # 원격 runner는 세션 리더로 띄우고 PID를 남긴다. 정리 때 그 프로세스 그룹을 종료한다.
      # setsid -w: ssh가 원격 runner의 종료 상태를 기다린다(포크 후 즉시 반환 방지).
      remote_sh "$host" "setsid -w sh -c 'echo \$\$ > \"\$1\"; shift; exec \"\$@\"' sh '$REMOTE_STATE/runner.pid' $(printf '%q ' env "${remote_env[@]}" "${COMMAND[@]}")" \
        >"$RUN_OUT/attack-$((host + 1)).stdout" 2>"$RUN_OUT/attack-$((host + 1)).stderr" </dev/null 9>&- &
      ATTACK_PIDS+=("$!")
    done
  else
    setsid "${COMMAND[@]}" >"$RUN_OUT/attack.stdout" 2>"$RUN_OUT/attack.stderr" </dev/null 9>&- &
    ATTACK_PIDS+=("$!")
  fi
  ATTACK_PID=${ATTACK_PIDS[0]}
  record_pid attack "$ATTACK_PID"

  for ((i=1; i<=TOTAL_ENDPOINTS; i++)); do
    if (( REMOTE && i <= ATTACK_SLOTS )); then
      ready=0; wait_remote_attack_port "${SLOT_HOST[$i]}" "$((2001 + 100 * i))" || ready=$?
    else
      ready=0; wait_attack_port "$((2001 + 100 * i))" || ready=$?
    fi
    if (( ready )); then
      attack_running || fail "공격 runner가 endpoint 준비 전에 종료됐습니다"
      fail "UE endpoint $i 준비가 시간 초과했습니다"
    fi
  done
  start_persistent_broker
  bash -c "$NORMAL_UE_GNB_STOP_CMD" >"$RUN_OUT/gnb-stop.log" 2>&1
  (( SAME_CELL_GNB_SETTLE_S == 0 )) || sleep "$SAME_CELL_GNB_SETTLE_S"
  bash -c "$NORMAL_UE_GNB_RESTART_CMD" >"$RUN_OUT/gnb-start.log" 2>&1 9>&-
  GNB_RESTARTED=1
  started=$SECONDS
  until bash -c "$NORMAL_UE_GNB_READY_CMD" >/dev/null 2>&1; do
    attack_running || fail "공격 runner가 DU 준비 전에 종료됐습니다"
    (( SECONDS - started < SAME_CELL_HEALTH_TIMEOUT_S )) || fail "DU readiness가 시간 초과했습니다"
    sleep 1
  done
  mapfile -t GNB_PIDS < <(pgrep -x odu)
  (( ${#GNB_PIDS[@]} == 1 )) || fail "세션이 소유할 DU PID를 하나로 확정하지 못했습니다"
  record_pid du "${GNB_PIDS[0]}"
  DU_PID=${GNB_PIDS[0]}
  marker_publish ran.ready || fail "same-cell RAN 준비 marker 게시에 실패했습니다"

  started=$SECONDS
  until record_healthy before; do
    attack_running || fail "공격 runner가 normal UE 준비 전에 종료됐습니다"
    (( SECONDS - started < SAME_CELL_HEALTH_TIMEOUT_S )) || fail "normal UE $COUNT/$COUNT 준비가 시간 초과했습니다"
    sleep 1
  done
  if [[ -n $BASELINE_READY_FILE ]]; then
    ( set -o noclobber; date +%s%N >"$BASELINE_READY_FILE" ) \
      || fail "정상 UE 기준선 marker 게시에 실패했습니다"
    started=$SECONDS
    until [[ -f $OBSERVATION_READY_FILE && ! -L $OBSERVATION_READY_FILE ]]; do
      attack_running || fail "관측 시작 전에 공격 runner가 종료됐습니다"
      (( SECONDS - started < SAME_CELL_HEALTH_TIMEOUT_S )) || fail "live E2E 관측 시작이 시간 초과했습니다"
      sleep .2
    done
  fi
  normal_hold "$SAME_CELL_NORMAL_PRE_HOLD_S" pre \
    || fail "전 유지 중 normal UE 프로세스가 종료됐습니다"
  marker_publish normal.ready || fail "same-cell 정상 UE 준비 marker 게시에 실패했습니다"
  started=$SECONDS
  until marker_present attack.ready; do
    attack_running || fail "공격 runner가 활성화 준비 전에 종료됐습니다"
    (( SECONDS - started < SAME_CELL_HEALTH_TIMEOUT_S )) || fail "공격 runner readiness가 시간 초과했습니다"
    sleep .2
  done
  ATTACK_SLOT_IDS=()
  for ((i=1; i<=ATTACK_SLOTS; i++)); do ATTACK_SLOT_IDS+=("$i"); done
  select_broker warmup "${ATTACK_SLOT_IDS[@]}" || fail "attack slot DL 준비에 실패했습니다"
  (( SAME_CELL_ATTACK_WARMUP_S == 0 )) || sleep "$SAME_CELL_ATTACK_WARMUP_S"
  select_broker attack "${ATTACK_SLOT_IDS[@]}" || fail "상시 attack slot 활성화에 실패했습니다"
  printf '{"schema":"same-cell.session.v2","run_id":"%s","attack":"%s","normal_ues":%d,"normal_shared_ru":false,"attack_slots":%d,"cell_restarts":1,"cu_restarts":0,"clocked_attack_slots":true}\n' \
    "$RUN_ID" "$ATTACK" "$COUNT" "$ATTACK_SLOTS" >"$RUN_OUT/session.json"

  NORMAL_HEALTH_BEFORE_TEARDOWN=null
  NORMAL_RECOVERY_SIGNAL_COUNT=0
  if [[ $ATTACK != uplink ]]; then
    attack_wait_started=$SECONDS
    until marker_present attack.done; do
      attack_running || fail "공격 runner가 완료 marker 전에 종료됐습니다"
      (( SECONDS - attack_wait_started < SAME_CELL_ATTACK_TIMEOUT_S )) \
        || fail "공격 runner 완료가 ${SAME_CELL_ATTACK_TIMEOUT_S}초를 초과했습니다"
      printf '%s\t%s\n' "$(date +%s%N)" "$(health "$COUNT")" >>"$RUN_OUT/normal-health.tsv"
      record_health during || true
      sleep 1
    done
    select_broker retire || fail "완료된 공격 slot 분리에 실패했습니다"
    started=$SECONDS
    next_recovery_signal=$((SECONDS + 15))
    until record_healthy after; do
      (( SECONDS - started < SAME_CELL_RECOVERY_TIMEOUT_S )) \
        || fail "공격 UE clock 유지 중 normal UE가 $COUNT/$COUNT가 아닙니다"
      if (( SECONDS >= next_recovery_signal )); then
        kill -USR1 "$NORMAL_PID" || fail "normal UE 안전 재등록 재시도 신호 전송에 실패했습니다"
        NORMAL_RECOVERY_SIGNAL_COUNT=$((NORMAL_RECOVERY_SIGNAL_COUNT + 1))
        next_recovery_signal=$((SECONDS + 30))
      fi
      sleep 1
    done
    NORMAL_HEALTH_BEFORE_TEARDOWN=true
    normal_hold "$SAME_CELL_NORMAL_POST_HOLD_S" post \
      || fail "후 유지 중 normal UE 프로세스가 종료됐습니다"
    marker_publish attack.release || fail "same-cell 종료 허가 marker 게시에 실패했습니다"
  fi
  attack_exit_started=$SECONDS
  while attack_running; do
    (( SECONDS - attack_exit_started < SAME_CELL_ATTACK_TIMEOUT_S )) \
      || fail "공격 runner 종료가 ${SAME_CELL_ATTACK_TIMEOUT_S}초를 초과했습니다"
    [[ $ATTACK != uplink ]] \
      || { printf '%s\t%s\n' "$(date +%s%N)" "$(health "$COUNT")" >>"$RUN_OUT/normal-health.tsv"; record_health during || true; }
    sleep 1
  done
  ATTACK_STATUS=0
  for pid in "${ATTACK_PIDS[@]}"; do
    if wait "$pid"; then :; else status=$?; (( ATTACK_STATUS == 0 )) && ATTACK_STATUS=$status; fi
  done
  ATTACK_PID=""
  ATTACK_PIDS=()
  select_broker standby || true
  (( ATTACK_STATUS == 0 )) || fail "공격 runner가 실패했습니다: status=$ATTACK_STATUS"
  child_output() {
    python3 - "$1" <<'PY'
import pathlib, re, sys
text = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8", errors="replace")
matches = re.findall(r"(?:^|\s)output=(/[^\s]+)", text)
print(matches[-1] if matches else "")
PY
  }
  : >"$RUN_OUT/child-output.txt"
  if (( REMOTE )); then
    for ((host=0; host<REMOTE_HOST_COUNT; host++)); do
      CHILD_OUTPUT=$(child_output "$RUN_OUT/attack-$((host + 1)).stdout") \
        || fail "공격 runner 출력 경로를 읽지 못했습니다"
      remote_sh "$host" "test -d '$CHILD_OUTPUT' -a ! -L '$CHILD_OUTPUT'" \
        || fail "원격 공격 runner가 안전한 output 경로를 남기지 않았습니다: $((host + 1))번 호스트"
      remote_sh "$host" "tar -C '$CHILD_OUTPUT' -cf - ." >"$RUN_OUT/remote-attacker-$((host + 1)).tar" \
        || fail "원격 공격 산출물을 가져오지 못했습니다: $((host + 1))번 호스트"
      (( $(stat -c %s "$RUN_OUT/remote-attacker-$((host + 1)).tar") > 0 )) \
        || fail "원격 공격 산출물이 비어 있습니다: $((host + 1))번 호스트"
      printf '%s\n' "$CHILD_OUTPUT" >>"$RUN_OUT/child-output.txt"
    done
  else
    CHILD_OUTPUT=$(child_output "$RUN_OUT/attack.stdout") \
      || fail "공격 runner 출력 경로를 읽지 못했습니다"
    [[ -n $CHILD_OUTPUT && -d $CHILD_OUTPUT && ! -L $CHILD_OUTPUT ]] \
      || fail "공격 runner가 안전한 output 경로를 남기지 않았습니다"
    printf '%s\n' "$CHILD_OUTPUT" >"$RUN_OUT/child-output.txt"
  fi
  printf '{"schema":"same-cell.run.v3","run_id":"%s","attack":"%s","normal_ues":%d,"normal_shared_ru":false,"attack_slots":%d,"du_restarted_during_attack":false,"normal_recovery_signal_count":%d,"normal_healthy_before_attack_teardown":%s,"direct_detector_input":false,"ue_to_ran_path_required":true,"attack_exit_status":%d}\n' \
    "$RUN_ID" "$ATTACK" "$COUNT" "$ATTACK_SLOTS" \
    "$NORMAL_RECOVERY_SIGNAL_COUNT" "$NORMAL_HEALTH_BEFORE_TEARDOWN" "$ATTACK_STATUS" >"$RUN_OUT/run.json"
  if [[ $ATTACK == uplink-credential-flood || $ATTACK == nas-counter-desync ]]; then
    embed_self_live_evidence || fail "self-live same-cell 증거 봉인에 실패했습니다"
  fi
  echo "완료됨: attack=$ATTACK same_cell=true normal=$COUNT output=$RUN_OUT"
  exit 0
fi

if [[ $ACTION == start ]]; then
  [[ $RUN_ID =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$ ]] || fail "안전한 session id가 필요합니다"
  [[ $COUNT =~ ^[1-9][0-9]*$ && $COUNT -le 7 ]] || fail "count는 1..7이어야 합니다"
  (( TOTAL_ENDPOINTS <= 11 )) || fail "attack slot과 normal UE 합계는 11 이하여야 합니다"
  [[ ! -e $STATE ]] || fail "same-cell 상태 디렉터리가 이미 있습니다: $STATE"
  pgrep -x nr-uesoftmodem >/dev/null 2>&1 && fail "기존 OAI UE가 있습니다"
  mkdir -m 700 "$STATE"
  START_COMPLETE=0
  GNB_RESTARTED=0
  cleanup_start() {
    local status=$? pid
    trap - EXIT INT TERM
    (( START_COMPLETE )) && return 0
    pid=$(owned_pid placeholder-group 2>/dev/null || true); [[ -z $pid ]] || stop_group "$pid"
    pid=$(owned_pid broker 2>/dev/null || true); [[ -z $pid ]] || stop_group "$pid"
    pid=$(owned_pid normal 2>/dev/null || true); [[ -z $pid ]] || stop_normal_ue "$pid"
    (( GNB_RESTARTED == 0 )) || bash -c "$NORMAL_UE_GNB_STOP_CMD" >/dev/null 2>&1 || true
    clear_state 2>/dev/null || true
    exit "$status"
  }
  trap cleanup_start EXIT INT TERM
  printf '%s\n' "$CONF" >"$STATE/config.path"
  printf '%s\n' "$COUNT" >"$STATE/count"
  printf '%s\n' "$ATTACK_SLOTS" >"$STATE/attack_slots"
  printf '%s\n' "$RUN_ID" >"$STATE/session_id"
  RUN_OUT="$NORMAL_UE_RUN_ROOT/same-cell/$RUN_ID"
  [[ ! -e $RUN_OUT ]] || fail "session id가 이미 존재합니다: $RUN_OUT"
  mkdir -m 700 -p "$RUN_OUT"
  mkdir -m 700 "$RUN_OUT/placeholders"
  printf '%s\n' "$RUN_OUT" >"$STATE/run_root"
  RUNTIME_CFG=$(SAME_CELL_NORMAL_STATE_DIR="$STATE" NORMAL_UE_ZMQ_ENDPOINT_OFFSET="$ATTACK_SLOTS" \
    "$NORMAL_CTL" prepare --config "$CONF" --count "$COUNT")
  if (( ATTACK_SLOTS > 0 )); then
    PLACEHOLDER_CFG=$(SAME_CELL_NORMAL_STATE_DIR="$STATE/placeholders" NORMAL_UE_ZMQ_ENDPOINT_OFFSET=0 \
      "$NORMAL_CTL" prepare --config "$CONF" --count "$ATTACK_SLOTS")
  fi
  printf '%s\n' "$PLACEHOLDER_CFG" >"$STATE/placeholder_config"
  printf 'placeholder\n' >"$STATE/broker-control"
  resolve_pdu_session_id
  if [[ -n ${SAME_CELL_DIAGNOSTIC_ATTACK_SLOTS:-} ]]; then
    export AUTH_STALL_CELL_SCALE_UE_COUNT="$ATTACK_SLOTS"
    export AUTH_STALL_CELL_SCALE_PROCESS_COUNT=$(((ATTACK_SLOTS + 4) / 5))
    export AUTH_STALL_CELL_SCALE_UES_PER_PROCESS=5
    export AUTH_STALL_CELL_DIAGNOSTIC_SCALE=1
  fi
  start_normal_group "$RUNTIME_CFG" "$RUN_ID"
  (( ATTACK_SLOTS == 0 )) || start_placeholder_group 1
  for ((i=1; i<=TOTAL_ENDPOINTS; i++)); do wait_port "$((2001 + 100 * i))" || fail "UE endpoint $i 준비가 시간 초과했습니다"; done
  setsid env NORMAL_UE_BROKER_ENDPOINTS="$TOTAL_ENDPOINTS" NORMAL_UE_BROKER_ATTACK_SLOTS="$ATTACK_SLOTS" \
    NORMAL_UE_BROKER_CONTROL="$STATE/broker-control" \
    python3 "$NORMAL_UE_BROKER_PY" \
    >"$RUN_OUT/broker.log" 2>&1 </dev/null 9>&- &
  record_pid broker "$!"
  sleep 2
  bash -c "$NORMAL_UE_GNB_STOP_CMD" >"$RUN_OUT/gnb-stop.log" 2>&1
  (( SAME_CELL_GNB_SETTLE_S == 0 )) || sleep "$SAME_CELL_GNB_SETTLE_S"
  bash -c "$NORMAL_UE_GNB_RESTART_CMD" >"$RUN_OUT/gnb-start.log" 2>&1 9>&-
  GNB_RESTARTED=1
  started=$SECONDS
  until bash -c "$NORMAL_UE_GNB_READY_CMD" >/dev/null 2>&1; do
    (( SECONDS - started < SAME_CELL_HEALTH_TIMEOUT_S )) || fail "DU readiness가 시간 초과했습니다"
    sleep 1
  done
  mapfile -t GNB_PIDS < <(pgrep -x odu)
  (( ${#GNB_PIDS[@]} == 1 )) || fail "세션이 소유할 DU PID를 하나로 확정하지 못했습니다"
  record_pid du "${GNB_PIDS[0]}"
  wait_healthy "$COUNT" "$SAME_CELL_HEALTH_TIMEOUT_S" || fail "normal UE $COUNT/$COUNT 준비가 시간 초과했습니다"
  ( set -o noclobber; : >"$STATE/normal.ready" )
  printf '{"schema":"same-cell.session.v1","session_id":"%s","normal_ues":%d,"attack_slots":%d,"cell_restarts":1,"cu_restarts":0}\n' \
    "$RUN_ID" "$COUNT" "$ATTACK_SLOTS" >"$RUN_OUT/session.json"
  START_COMPLETE=1
  trap - EXIT INT TERM
  echo "시작됨: session=$RUN_ID normal=$COUNT/$COUNT attack_slots=$ATTACK_SLOTS du_restart=initial-only"
  exit 0
fi

if [[ $ACTION == stop ]]; then
  for role in attack placeholder-group broker normal; do
    pid=$(owned_pid "$role" 2>/dev/null || true)
    [[ -z $pid ]] || if [[ $role == normal ]]; then stop_normal_ue "$pid"; else stop_group "$pid"; fi
  done
  bash -c "$NORMAL_UE_GNB_STOP_CMD" >/dev/null 2>&1 \
    || fail "DU 종료 명령이 실패했습니다; 상태를 보존합니다"
  stopped_at=$SECONDS
  while pgrep -x odu >/dev/null 2>&1; do
    (( SECONDS - stopped_at < SAME_CELL_ENDPOINT_TIMEOUT_S )) \
      || fail "DU가 종료되지 않아 상태를 보존합니다"
    sleep .2
  done
  for role in attack placeholder-group broker normal; do
    owned_pid "$role" >/dev/null 2>&1 && fail "$role 프로세스가 남아 상태를 보존합니다"
  done
  clear_state
  echo "종료됨: normal UE, placeholder/attack, broker, DU; CU/core는 유지"
  exit 0
fi

read -r COUNT <"$STATE/count"
read -r NORMAL_UE_PDU_SESSION_ID <"$STATE/pdu_session_id"
read -r RUN_OUT <"$STATE/run_root"
read -r PLACEHOLDER_CFG <"$STATE/placeholder_config"
[[ $COUNT =~ ^[1-9][0-9]*$ && $NORMAL_UE_PDU_SESSION_ID =~ ^[1-9][0-9]*$ ]] || fail "same-cell 세션 상태가 잘못됐습니다"
if [[ -n ${SAME_CELL_DIAGNOSTIC_ATTACK_SLOTS:-} ]]; then
  [[ $ATTACK == auth-timeout && $SAME_CELL_DIAGNOSTIC_ATTACK_SLOTS =~ ^[1-9][0-9]*$ ]] \
    || fail "SAME_CELL_DIAGNOSTIC_ATTACK_SLOTS는 auth-timeout의 양의 정수여야 합니다"
  ATTACK_SLOTS=$SAME_CELL_DIAGNOSTIC_ATTACK_SLOTS
  export AUTH_STALL_CELL_DIAGNOSTIC_MAX_ENDPOINTS="${SAME_CELL_DIAGNOSTIC_MAX_ENDPOINTS:-120}"
  export NORMAL_UE_BROKER_MAX_ENDPOINTS="${SAME_CELL_DIAGNOSTIC_MAX_ENDPOINTS:-120}"
fi
TOTAL_ENDPOINTS=$((ATTACK_SLOTS + COUNT))
NORMAL_PID=$(owned_pid normal 2>/dev/null || true)
BROKER_PID=$(owned_pid broker 2>/dev/null || true)
DU_PID=$(owned_pid du 2>/dev/null || true)

if [[ $ACTION == status ]]; then
  [[ ! -f $STATE/attack_slots ]] || read -r ATTACK_SLOTS <"$STATE/attack_slots"
  placeholders=0
  owned_pid placeholder-group >/dev/null 2>&1 && placeholders=$ATTACK_SLOTS
  ok=$(health "$COUNT")
  state=degraded
  [[ -n $NORMAL_PID && -n $BROKER_PID && -n $DU_PID ]] \
    && (( ok == COUNT && placeholders == ATTACK_SLOTS )) && state=healthy
  echo "state=$state normal=$ok/$COUNT placeholders=$placeholders/$ATTACK_SLOTS normal_pid=${NORMAL_PID:-down} broker_pid=${BROKER_PID:-down} du_pid=${DU_PID:-down}"
  exit 0
fi

[[ -n $NORMAL_PID ]] || fail "normal UE 세션이 실행 중이 아닙니다"
[[ -n $BROKER_PID ]] || fail "broker 세션이 실행 중이 아닙니다"
[[ -n $DU_PID ]] || fail "세션이 소유한 DU가 실행 중이 아닙니다"
(( SAME_CELL_EXPERIMENTAL_SWITCH )) \
  || fail "p5 hot-swap 자격 검증에 실패해 공격 전환은 기본 비활성입니다: workloads/normal-ue/docs/SAME-CELL-HOT-SWAP-20261113.md"
[[ $RUN_ID =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$ ]] || fail "안전한 run id가 필요합니다"
case $ATTACK in
  blind) USED_SLOTS=(1 2) ;;
  uplink) USED_SLOTS=(1) ;;
  auth-timeout) USED_SLOTS=(1 2 3 4) ;;
  *) fail "지원하지 않는 same-cell 공격: $ATTACK" ;;
esac
owned_pid placeholder-group >/dev/null || fail "placeholder group이 실행 중이 아닙니다"
RUN_DIR="$RUN_OUT/runs/$RUN_ID"
[[ ! -e $RUN_DIR ]] || fail "run id가 이미 존재합니다: $RUN_DIR"
mkdir -m 700 -p "$RUN_DIR"
ENDPOINTS_FILE="$RUN_DIR/attack-endpoints.txt"
for ((i=1; i<=ATTACK_SLOTS; i++)); do
  endpoint=$((TOTAL_ENDPOINTS + i))
  printf 'tcp://127.0.0.1:%d tcp://127.0.0.1:%d\n' "$((2001 + 100 * endpoint))" "$((2000 + 100 * endpoint))" >>"$ENDPOINTS_FILE"
done

restore_placeholders() {
  is_running "$BROKER_PID" && select_broker placeholder
}
ATTACK_PID=""
BROKER_ATTACK_ACTIVE=0
cleanup_run() {
  local status=$?
  trap - EXIT INT TERM
  [[ -z $ATTACK_PID ]] || stop_group "$ATTACK_PID" TERM
  (( BROKER_ATTACK_ACTIVE == 0 )) || restore_placeholders || true
  exit "$status"
}
trap cleanup_run EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
wait_healthy "$COUNT" "$SAME_CELL_HEALTH_TIMEOUT_S" || fail "공격 전 normal UE $COUNT/$COUNT가 healthy가 아닙니다"

export SAME_CELL_READY_FILE="$STATE/normal.ready" SAME_CELL_READY_TIMEOUT_S="$SAME_CELL_HEALTH_TIMEOUT_S"
export P5_EXTERNAL_RAN=1 SAME_CELL_UE_ENDPOINTS_FILE="$ENDPOINTS_FILE"
export SAME_CELL_DU_LOG="$NORMAL_UE_GNB_LOG" SAME_CELL_GNB_CONFIG="$NORMAL_UE_GNB_CONFIG"
export SAME_CELL_BLIND_MANAGE_DU=0 SAME_CELL_UPLINK_MANAGE_RAN=0 SAME_CELL_AUTH_TIMEOUT_MANAGE_DU=0
SLOT1_ENDPOINT=$((TOTAL_ENDPOINTS + 1)); SLOT2_ENDPOINT=$((TOTAL_ENDPOINTS + 2))
export SAME_CELL_VICTIM_TX_ENDPOINT="tcp://127.0.0.1:$((2001 + 100 * SLOT1_ENDPOINT))"
export SAME_CELL_VICTIM_RX_ENDPOINT="tcp://127.0.0.1:$((2000 + 100 * SLOT1_ENDPOINT))"
export SAME_CELL_ATTACKER_TX_ENDPOINT="tcp://127.0.0.1:$((2001 + 100 * SLOT2_ENDPOINT))"
export SAME_CELL_ATTACKER_RX_ENDPOINT="tcp://127.0.0.1:$((2000 + 100 * SLOT2_ENDPOINT))"
export SAME_CELL_UE_TX_ENDPOINT="$SAME_CELL_VICTIM_TX_ENDPOINT" SAME_CELL_UE_RX_ENDPOINT="$SAME_CELL_VICTIM_RX_ENDPOINT"
setsid "${COMMAND[@]}" >"$RUN_DIR/attack.stdout" 2>"$RUN_DIR/attack.stderr" </dev/null 9>&- &
ATTACK_PID=$!
for slot in "${USED_SLOTS[@]}"; do
  endpoint=$((TOTAL_ENDPOINTS + slot))
  wait_port "$((2001 + 100 * endpoint))" || fail "attack slot $slot endpoint가 준비되지 않았습니다"
done
select_broker warmup "${USED_SLOTS[@]}" || fail "broker attack slot DL 준비에 실패했습니다"
BROKER_ATTACK_ACTIVE=1
(( SAME_CELL_ATTACK_WARMUP_S == 0 )) || sleep "$SAME_CELL_ATTACK_WARMUP_S"
select_broker attack "${USED_SLOTS[@]}" || fail "broker attack slot 선택에 실패했습니다"
while is_running "$ATTACK_PID"; do printf '%s\t%s\n' "$(date +%s%N)" "$(health "$COUNT")" >>"$RUN_DIR/normal-health.tsv"; sleep 1; done
if wait "$ATTACK_PID"; then ATTACK_STATUS=0; else ATTACK_STATUS=$?; fi
ATTACK_PID=""
select_broker placeholder || fail "broker placeholder 복귀에 실패했습니다"
BROKER_ATTACK_ACTIVE=0
wait_healthy "$COUNT" "$SAME_CELL_RECOVERY_TIMEOUT_S" || fail "공격 종료 뒤 normal UE가 회복하지 못했습니다"
printf '{"schema":"same-cell.run.v1","run_id":"%s","attack":"%s","normal_ues":%d,"du_restarted":false,"attack_exit_status":%d}\n' \
  "$RUN_ID" "$ATTACK" "$COUNT" "$ATTACK_STATUS" >"$RUN_DIR/run.json"
printf '%s\t%s\t%d\n' "$(date -u +%FT%TZ)" "$RUN_ID" "$ATTACK_STATUS" >>"$RUN_OUT/runs.tsv"
trap - EXIT INT TERM
(( ATTACK_STATUS == 0 )) || fail "공격 runner가 실패했습니다: status=$ATTACK_STATUS"
echo "완료됨: attack=$ATTACK normal=$COUNT/$COUNT du_restarted=false output=$RUN_DIR"
