gnb_du_id: 7
f1ap: { addrs: __CU_PRIVATE_IP__, bind_addrs: __DU_PRIVATE_IP__ }
f1u:  { socket: [ { bind_addr: __DU_PRIVATE_IP__ } ] }

ru_sdr:
  device_driver: zmq
  device_args: tx_port=tcp://127.0.0.1:2000,rx_port=tcp://127.0.0.1:2001,base_srate=23.04e6
  srate: 23.04
  tx_gain: -12
  rx_gain: 0

cell_cfg:
  dl_arfcn: 632628
  band: 78
  channel_bandwidth_MHz: 20
  common_scs: 30
  plmn: "00101"
  tac: 7
  pusch: { dmrs_additional_position: 2 }
  prach:
    total_nof_ra_preambles: 64
    nof_ssb_per_ro: 1
    nof_cb_preambles_per_ssb: 64

cells:
  - pci: 8
    sector_id: 7
    prach: { prach_root_sequence_index: 7 }

log:
  filename: /tmp/odu.log
  all_level: debug
  phy_level: info
  fapi_level: debug
  hex_max_size: 32
  e2ap_level: debug

e2:
  enable_du_e2: true
  addrs: __CU_PRIVATE_IP__
  bind_addrs: __DU_PRIVATE_IP__
  port: 36421
  e2sm_kpm_enabled: true
