# p5 실측 구성. CU/DU 주소는 배포 환경에 맞게 바꾼다.
f1ap: { addrs: 172.31.5.10, bind_addrs: 172.31.5.11 }
f1u:  { socket: [ { bind_addr: 172.31.5.11 } ] }

ru_sdr:
  device_driver: zmq
  device_args: tx_port0=tcp://127.0.0.1:4556,rx_port0=tcp://127.0.0.1:4557,tx_port1=tcp://127.0.0.1:4558,rx_port1=tcp://127.0.0.1:4559,base_srate=23.04e6
  srate: 23.04
  tx_gain: -12
  rx_gain: 0

cell_cfg:
  dl_arfcn: 632628
  band: 78
  channel_bandwidth_MHz: 20
  common_scs: 30
  plmn: "00101"
  tac: 7
  pusch: { dmrs_additional_position: 2 }
  prach:
    total_nof_ra_preambles: 64
    nof_ssb_per_ro: 1
    nof_cb_preambles_per_ssb: 64

cells:
  - pci: 1
    sector_id: 0
    prach: { prach_root_sequence_index: 0 }
  - pci: 2
    sector_id: 1
    prach: { prach_root_sequence_index: 32 }

log:
  filename: /tmp/odu2.log
  all_level: debug
  phy_level: info
  fapi_level: debug
  hex_max_size: 32
  e2ap_level: debug

e2:
  enable_du_e2: true
  addrs: 172.31.5.10
  bind_addrs: 172.31.5.11
  port: 36421
  e2sm_kpm_enabled: true
