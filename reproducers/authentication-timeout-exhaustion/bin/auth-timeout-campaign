#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONF=${AUTH_TIMEOUT_CONF:-$ROOT/conf/auth-timeout.conf}
[[ ! -L $CONF ]] || { echo "설정 파일은 심볼릭 링크일 수 없습니다: $CONF" >&2; exit 2; }
[[ ! -f $CONF ]] || . "$CONF"
RUN_ROOT=${AUTH_TIMEOUT_RUN_ROOT:-$ROOT/runs}
CAMPAIGN=
ENABLE=0
while getopts "e:n:h" option; do
  case $option in
    e) ENABLE=$OPTARG ;;
    n) CAMPAIGN=$OPTARG ;;
    h) echo "사용법: $0 -n CAMPAIGN_ID -e 1"; exit 0 ;;
    *) exit 2 ;;
  esac
done
[[ $ENABLE == 1 ]] || { echo "3세트 캠페인은 명시적 -e 1이 필요합니다" >&2; exit 2; }
[[ $CAMPAIGN =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,80}$ ]] || { echo "안전한 CAMPAIGN_ID가 필요합니다" >&2; exit 2; }

for index in 1 2 3; do
  "$ROOT/bin/auth-timeout-run" control -n "$CAMPAIGN-control-$index" -e 0
  LIMIT=$(python3 - "$RUN_ROOT/$CAMPAIGN-control-$index/service.jsonl" <<'PY'
import json, pathlib, sys
rows = [json.loads(line) for line in pathlib.Path(sys.argv[1]).read_text().splitlines()]
elapsed = [row.get("elapsed_ms") for row in rows]
if not elapsed or any(type(value) is not int or value < 0 for value in elapsed):
    raise SystemExit("control 서비스 지연 표본이 잘못됐습니다")
print(max(10_000, max(elapsed) * 3))
PY
  )
  "$ROOT/bin/auth-timeout-run" attack -n "$CAMPAIGN-attack-$index" -e 1 -t "$LIMIT"
done
"$ROOT/bin/auth-timeout-campaign-verify" "$RUN_ROOT" "$CAMPAIGN"
