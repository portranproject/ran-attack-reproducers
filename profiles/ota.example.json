{
  "schema": "ran-reproducer.profile.v1",
  "id": "ota",
  "backend": "ota",
  "configured": false,
  "lab_only": true,
  "run_root": "/var/lib/ran-reproducer/runs",
  "environment": {
    "OAI_BASE": "/srv/OAI",
    "DETECTOR_BIN": "/srv/detection/build/detector",
    "DETECTOR_CONFIG": "/srv/detection/config/detector.json"
  },
  "credentials_file": "/root/.config/ran-reproducer/ota.env",
  "detector": {
    "binary": "/srv/detection/build/detector",
    "config": "/srv/detection/config/detector.json",
    "repository": "https://github.com/portranproject/detection",
    "commit": "766f5569d0ddb425c14bf210a31c38ac60eceef9"
  },
  "telemetry": {
    "binary": "/srv/telemetry/build/portran",
    "period_ms": 100,
    "repository": "https://github.com/portranproject/telemetry",
    "commit": "7550153a58a993942303bd3d4a6cd635b664468b"
  },
  "limits": {"max_duration_s": 180, "max_ues": 8, "max_tx_gain_db": 0},
  "target_allowlist": ["replace-with-shielded-lab-target"],
  "rf": {
    "shielding_confirmed": false,
    "clock_source": "replace-with-reviewed-clock-source",
    "devices": [
      {"role": "attacker-ue", "serial": "replace-with-sdr-serial"},
      {"role": "o-du", "serial": "replace-with-sdr-serial"}
    ]
  }
}
