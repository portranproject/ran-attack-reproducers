+static uint64_t auth_timeout_gate_open_ms;
+static uint64_t auth_timeout_gate_poll_ms;
+static pthread_mutex_t auth_timeout_gate_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static uint64_t auth_timeout_monotonic_ms(void)
+{
+  struct timespec now;
+  clock_gettime(CLOCK_MONOTONIC, &now);
+  return (uint64_t)now.tv_sec * 1000U + (uint64_t)now.tv_nsec / 1000000U;
+}
+
+static unsigned auth_timeout_same_cell_ms(const char *name, unsigned maximum)
+{
+  const char *value = getenv(name);
+  if (!value || value[0] == '\0')
+    return 0;
+  char *end = NULL;
+  const long milliseconds = strtol(value, &end, 10);
+  return end && end[0] == '\0' && milliseconds >= 0 && (unsigned long)milliseconds <= maximum
+             ? (unsigned)milliseconds
+             : 0;
+}
+
+static bool auth_timeout_same_cell_ra_allowed(int ue)
+{
+  const char *path = getenv("OAI_AUTH_TIMEOUT_GATE_FILE");
+  if (!path || path[0] == '\0' || ue < 0 || ue >= MAX_NUM_NR_UE_INST)
+    return false;
+  const uint64_t now = auth_timeout_monotonic_ms();
+  verifyMutex(pthread_mutex_lock(&auth_timeout_gate_mutex));
+  if (auth_timeout_gate_open_ms == 0 && now - auth_timeout_gate_poll_ms >= 20) {
+    auth_timeout_gate_poll_ms = now;
+    FILE *gate = fopen(path, "r");
+    if (gate) {
+      char mode[6];
+      const bool open = fread(mode, 1, sizeof(mode), gate) == sizeof(mode)
+                        && memcmp(mode, "attack", sizeof(mode)) == 0;
+      fclose(gate);
+      if (open)
+        auth_timeout_gate_open_ms = now;
+    }
+  }
+  const uint64_t opened_ms = auth_timeout_gate_open_ms;
+  verifyMutex(pthread_mutex_unlock(&auth_timeout_gate_mutex));
+  if (opened_ms == 0)
+    return false;
+  const unsigned base_ms = auth_timeout_same_cell_ms("OAI_AUTH_TIMEOUT_GATE_BASE_MS", 1000);
+  const unsigned step_ms = auth_timeout_same_cell_ms("OAI_AUTH_TIMEOUT_GATE_STEP_MS", 1000);
+  const unsigned target_ms = base_ms + (unsigned)ue * step_ms;
+  if (now - opened_ms < target_ms)
+    return false;
+  LOG_I(NR_MAC,
+        "AUTH_TIMEOUT_RA_GATE event=released ue=%d waited_ms=%llu target_ms=%u\n",
+        ue,
+        (unsigned long long)(now - opened_ms),
+        target_ms);
+  return true;
+}
