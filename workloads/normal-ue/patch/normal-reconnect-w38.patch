--- a/executables/nr-uesoftmodem.c
+++ b/executables/nr-uesoftmodem.c
@@ -10,6 +10,7 @@
 #include <signal.h>
 #include <errno.h>
 #include <string.h>
+#include <sys/eventfd.h>
 
 #include "T.h"
 #include "common/oai_version.h"
@@ -269,6 +270,37 @@ static void trigger_deregistration(int sig)
   }
 }
 
+static int normal_reconnect_event_fd = -1;
+
+static void request_normal_reconnect(void)
+{
+  for (int ue_inst = 0; ue_inst < NB_UE_INST; ue_inst++) {
+    MessageDef *msg = itti_alloc_new_message(TASK_NAS_NRUE, ue_inst, NAS_DEREGISTRATION_REQ);
+    NAS_DEREGISTRATION_REQ(msg).cause = AS_AUTHENTICATION_FAILURE;
+    itti_send_msg_to_task(TASK_NAS_NRUE, ue_inst, msg);
+  }
+}
+
+static void *normal_reconnect_worker(void *arg)
+{
+  (void)arg;
+  uint64_t requests;
+  while (read(normal_reconnect_event_fd, &requests, sizeof(requests)) == sizeof(requests)) {
+    while (requests-- > 0)
+      request_normal_reconnect();
+  }
+  return NULL;
+}
+
+static void trigger_normal_reconnect(int sig)
+{
+  (void)sig;
+  const int saved_errno = errno;
+  const uint64_t request = 1;
+  __attribute__((unused)) ssize_t unused = write(normal_reconnect_event_fd, &request, sizeof(request));
+  errno = saved_errno;
+}
+
 void *nrue_ru_start_thread(void *arg)
 {
   (void)arg;
@@ -496,6 +528,14 @@ int main(int argc, char **argv)
   // wait for end of program
   printf("Entering ITTI signals handler\n");
   printf("TYPE <CTRL-C> TO TERMINATE\n");
+  normal_reconnect_event_fd = eventfd(0, EFD_CLOEXEC);
+  AssertFatal(normal_reconnect_event_fd >= 0, "eventfd failed: %s\n", strerror(errno));
+  pthread_t normal_reconnect_thread;
+  int reconnect_rc = pthread_create(&normal_reconnect_thread, NULL, normal_reconnect_worker, NULL);
+  AssertFatal(reconnect_rc == 0, "pthread_create failed: %s\n", strerror(reconnect_rc));
+  pthread_detach(normal_reconnect_thread);
+  signal(SIGUSR1, trigger_normal_reconnect);
+  LOG_I(PHY, "NORMAL_UE_RECOVERY signal=SIGUSR1 enabled=true\n");
   itti_wait_tasks_end(trigger_deregistration);
   LOG_W(NR_PHY, "Returned from ITTI signal handler\n");
   oai_exit = 1;
