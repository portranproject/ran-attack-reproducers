                                               const uint16_t rx_slss_id);
 
 void nr_rrc_set_mac_queue(instance_t instance, notifiedFIFO_t *mac_input_nf);
+
+/* ---------------------------------------------------------------------------
+ * RRC signaling storm reproducer, A-type (UE side only).
+ *
+ * Reproduces "initial access not completed": the UE receives Msg4 (RRCSetup),
+ * lets MAC send the HARQ ACK, never generates RRCSetupComplete, and asks for a
+ * new RRCSetupRequest after a configurable interval. Used to validate the
+ * team's detection/mitigation loop on an isolated testbed. The gNB is never
+ * modified.
+ *
+ * Knobs come from the "rss" config prefix, e.g.
+ *   --rss.enable 1 --rss.interval_ms 100 --rss.max_duration_s 30 \
+ *   --rss.run_id A-2026w38-001 --rss.log_file /tmp/rss_attempts.jsonl
+ * Implementation and the knob table live in rrc_timers_and_constants.c.
+ * -------------------------------------------------------------------------*/
+bool nr_rss_enabled(void);
+bool nr_rss_complete_this_attempt(void);
+bool nr_rss_honor_reject(void);
+int nr_rss_reject_backoff_ms(void);
+unsigned nr_rss_next_seq(void);
+void nr_rss_arm_retry(NR_UE_RRC_INST_t *rrc, int delay_ms);
+void nr_rss_log(const char *event, const char *fmt, ...) __attribute__((format(printf, 2, 3)));
+
 /** @}*/
 #endif
 
diff --git a/openair2/RRC/NR_UE/rrc_timers_and_constants.c b/openair2/RRC/NR_UE/rrc_timers_and_constants.c
index 0addfe5..616bee3 100644
--- a/openair2/RRC/NR_UE/rrc_timers_and_constants.c
+++ b/openair2/RRC/NR_UE/rrc_timers_and_constants.c
@@ -4,6 +4,200 @@
 
 #include "openair2/RRC/NR_UE/rrc_proto.h"
 #include "executables/softmodem-common.h"
+#include "common/config/config_userapi.h"
+#include "LAYER2/NR_MAC_UE/mac_proto.h"
+#include <stdarg.h>
+#include <stdio.h>
+#include <time.h>
+
+/* ---------------------------------------------------------------------------
+ * RRC signaling storm reproducer, A-type (UE side only). See rrc_proto.h.
+ *
+ * Scope rules kept deliberately narrow:
+ *  - nothing here changes gNB behaviour or any 3GPP timer value;
+ *  - with --rss.enable 0 (default) every function below is inert, so the same
+ *    binary is also the regression-test binary for normal attach;
+ *  - max_duration_s is an in-process kill switch: when it fires the UE goes
+ *    back to completing RRC setup normally.
+ * -------------------------------------------------------------------------*/
+#define RSS_CFG_PREFIX "rss"
+
+typedef struct {
+  int enable;
+  int interval_ms;
+  int reject_backoff_ms;
+  int honor_reject;
+  int completion_pct;
+  int max_duration_s;
+  int ack_gate;
+  char *run_id;
+  char *log_file;
+} rss_cfg_t;
+
+static rss_cfg_t rss_cfg;
+
+/* clang-format off */
+#define RSS_PARAMS_DESC { \
+  {"enable",            "1 = A-type: receive Msg4, skip RRCSetupComplete, retry\n",      0, .iptr=&rss_cfg.enable,            .defintval=0,                        TYPE_INT,    0}, \
+  {"interval_ms",       "delay between a skipped Msg5 and the next RRCSetupRequest\n",   0, .iptr=&rss_cfg.interval_ms,       .defintval=100,                      TYPE_INT,    0}, \
+  {"reject_backoff_ms", "delay after RRCReject when the gNB sent no waitTime\n",         0, .iptr=&rss_cfg.reject_backoff_ms, .defintval=1000,                     TYPE_INT,    0}, \
+  {"honor_reject",      "1 = obey RRCReject waitTime/backoff, 0 = retry at once\n",      0, .iptr=&rss_cfg.honor_reject,      .defintval=1,                        TYPE_INT,    0}, \
+  {"completion_pct",    "percent of attempts completed normally (0 = pure A-type)\n",    0, .iptr=&rss_cfg.completion_pct,    .defintval=0,                        TYPE_INT,    0}, \
+  {"max_duration_s",    "kill switch: stop the reproducer after this many seconds\n",    0, .iptr=&rss_cfg.max_duration_s,    .defintval=60,                       TYPE_INT,    0}, \
+  {"ack_gate",          "1 = never restart RA while the Msg4 HARQ ACK PUCCH is pending\n", 0, .iptr=&rss_cfg.ack_gate,        .defintval=1,                        TYPE_INT,    0}, \
+  {"run_id",            "run identifier written into every JSONL record\n",              0, .strptr=&rss_cfg.run_id,          .defstrval="rss-run",                TYPE_STRING, 0}, \
+  {"log_file",          "per-attempt JSONL ground truth for the detection team\n",       0, .strptr=&rss_cfg.log_file,        .defstrval="/tmp/rss_attempts.jsonl", TYPE_STRING, 0}, \
+}
+/* clang-format on */
+
+static bool rss_cfg_done;
+static bool rss_killed;
+static uint64_t rss_t0_ns;
+static unsigned rss_seq;
+static unsigned rss_completed;
+static FILE *rss_log_fd;
+
+static uint64_t rss_now_ns(void)
+{
+  struct timespec ts;
+  clock_gettime(CLOCK_REALTIME, &ts);
+  return (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec;
+}
+
+static const rss_cfg_t *rss_get_cfg(void)
+{
+  if (!rss_cfg_done) {
+    paramdef_t params[] = RSS_PARAMS_DESC;
+    config_get(config_get_if(), params, sizeofArray(params), RSS_CFG_PREFIX);
+    rss_cfg_done = true;
+    /* RRC timers are ticked once per radio frame, so 10 ms is the resolution */
+    if (rss_cfg.interval_ms < 10)
+      rss_cfg.interval_ms = 10;
+    if (rss_cfg.reject_backoff_ms < 10)
+      rss_cfg.reject_backoff_ms = 10;
+    rss_cfg.completion_pct = rss_cfg.completion_pct < 0 ? 0 : (rss_cfg.completion_pct > 100 ? 100 : rss_cfg.completion_pct);
+    if (rss_cfg.enable) {
+      LOG_W(NR_RRC,
+            "[RSS] A-type reproducer ENABLED (isolated testbed only): interval=%d ms completion=%d%% "
+            "honor_reject=%d ack_gate=%d max_duration=%d s run_id=%s log=%s\n",
+            rss_cfg.interval_ms,
+            rss_cfg.completion_pct,
+            rss_cfg.honor_reject,
+            rss_cfg.ack_gate,
+            rss_cfg.max_duration_s,
+            rss_cfg.run_id,
+            rss_cfg.log_file);
+    }
+  }
+  return &rss_cfg;
+}
+
+bool nr_rss_enabled(void)
+{
+  return rss_get_cfg()->enable != 0 && !rss_killed;
+}
+
+bool nr_rss_honor_reject(void)
+{
+  return rss_get_cfg()->honor_reject != 0;
+}
+
+int nr_rss_reject_backoff_ms(void)
+{
+  return rss_get_cfg()->reject_backoff_ms;
+}
+
+void nr_rss_log(const char *event, const char *fmt, ...)
+{
+  const rss_cfg_t *cfg = rss_get_cfg();
+  if (!cfg->enable || !cfg->log_file || !cfg->log_file[0])
+    return;
+  if (!rss_log_fd) {
+    rss_log_fd = fopen(cfg->log_file, "a");
+    if (!rss_log_fd) {
+      LOG_E(NR_RRC, "[RSS] cannot open %s for writing\n", cfg->log_file);
+      return;
+    }
+  }
+  fprintf(rss_log_fd,
+          "{\"type\":\"event\",\"run_id\":\"%s\",\"seq\":%u,\"t_ns\":%llu,\"event\":\"%s\"",
+          cfg->run_id ? cfg->run_id : "",
+          rss_seq,
+          (unsigned long long)rss_now_ns(),
+          event);
+  if (fmt && fmt[0]) {
+    va_list ap;
+    va_start(ap, fmt);
+    fputc(',', rss_log_fd);
+    vfprintf(rss_log_fd, fmt, ap);
+    va_end(ap);
+  }
+  fprintf(rss_log_fd, "}\n");
+  fflush(rss_log_fd);
+}
+
+unsigned nr_rss_next_seq(void)
+{
+  if (rss_t0_ns == 0)
+    rss_t0_ns = rss_now_ns();
+  return ++rss_seq;
+}
+
+/* Deterministic stride instead of a coin flip: the realised completion ratio is
+   exact and the same run is replayable for the detection team. */
+bool nr_rss_complete_this_attempt(void)
+{
+  const rss_cfg_t *cfg = rss_get_cfg();
+  if (cfg->completion_pct <= 0)
+    return false;
+  if (cfg->completion_pct >= 100)
+    return true;
+  unsigned due = (rss_seq * (unsigned)cfg->completion_pct) / 100;
+  if (due > rss_completed) {
+    rss_completed = due;
+    return true;
+  }
+  return false;
+}
+
+void nr_rss_arm_retry(NR_UE_RRC_INST_t *rrc, int delay_ms)
+{
+  const rss_cfg_t *cfg = rss_get_cfg();
+  NR_timer_t *t = &rrc->timers_and_constants.rss_retry_timer;
+  nr_timer_setup(t, delay_ms > 0 ? (uint32_t)delay_ms : (uint32_t)cfg->interval_ms, 10);
+  nr_timer_start(t);
+}
+
+static void rss_handle_retry_timer(NR_UE_RRC_INST_t *rrc)
+{
+  NR_timer_t *t = &rrc->timers_and_constants.rss_retry_timer;
+  if (!nr_timer_tick(t))
+    return;
+  if (!nr_rss_enabled())
+    return;
+  const rss_cfg_t *cfg = rss_get_cfg();
+  if (cfg->max_duration_s > 0 && rss_t0_ns != 0
+      && rss_now_ns() - rss_t0_ns > (uint64_t)cfg->max_duration_s * 1000000000ULL) {
+    rss_killed = true;
+    LOG_W(NR_RRC, "[RSS] max_duration_s=%d reached: reproducer disabled, normal attach resumes\n", cfg->max_duration_s);
+    nr_rss_log("kill_switch", NULL);
+    return;
+  }
+  /* Keep the Msg4 HARQ ACK. Restarting RA calls reset_ra(), whose memset clears
+     the PUCCH prepared by prepare_msg4_msgb_feedback(); without the ACK the gNB
+     drops the contention early and nothing accumulates. */
+  if (cfg->ack_gate) {
+    const NR_UE_MAC_INST_t *mac = get_mac_inst(rrc->ue_id);
+    if (mac && mac->ra.ra_pucch) {
+      nr_rss_log("ack_pending_postpone", NULL);
+      nr_timer_setup(t, 10, 10);
+      nr_timer_start(t);
+      return;
+    }
+  }
+  nr_rss_log("retrigger", NULL);
+  handle_t300_expiry(rrc);
+}
 
