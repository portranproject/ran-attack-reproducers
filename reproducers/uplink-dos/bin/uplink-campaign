#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONF=${UPLINK_CONF:-$ROOT/conf/uplink.conf}
[[ ! -L $CONF ]] || { echo "설정 파일은 심볼릭 링크일 수 없습니다: $CONF" >&2; exit 2; }
[[ ! -f $CONF ]] || . "$CONF"
RUN_ROOT=${UPLINK_RUN_ROOT:-$ROOT/runs}
CAMPAIGN=
ENABLE=0
while getopts "e:n:h" option; do
  case $option in
    e) ENABLE=$OPTARG ;;
    n) CAMPAIGN=$OPTARG ;;
    h) echo "사용법: $0 -n CAMPAIGN_ID -e 1"; exit 0 ;;
    *) exit 2 ;;
  esac
done
[[ $ENABLE == 1 ]] || { echo "3세트 캠페인은 명시적 -e 1이 필요합니다" >&2; exit 2; }
[[ $CAMPAIGN =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,80}$ ]] || { echo "안전한 CAMPAIGN_ID가 필요합니다" >&2; exit 2; }

for set_index in 1 2 3; do
  "$ROOT/bin/uplink-run" control -n "$CAMPAIGN-control-$set_index" -e 0
  "$ROOT/bin/uplink-run" emulation -n "$CAMPAIGN-emulation-$set_index" -e 1
done
python3 "$ROOT/analysis/verify_campaign.py" "$RUN_ROOT" "$CAMPAIGN"
