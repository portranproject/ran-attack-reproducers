+        const uint64_t t0 = rss_probe_t0[pu] ? rss_probe_t0[pu] : pnow;
+        nr_rss_log(pu, "probe_connected", "\"tries\":%u,\"ms\":%llu",
+                   rss_probe_tries[pu], (unsigned long long)((pnow - t0) / 1000000ULL));
+      }
+      nr_timer_setup(t, 10, 10);
+      nr_timer_start(t);
+      return;
+    }
+    if (rss_probe_done[pu]) {
+      /* Lost the connection again: that is itself a denial observation. */
+      nr_rss_log(pu, "probe_lost", "\"tries\":%u", rss_probe_tries[pu]);
+      rss_probe_done[pu] = false;
+    }
+    if (rss_probe_t0[pu] == 0)
+      rss_probe_t0[pu] = pnow;
+    if (rss_probe_next_ns[pu] != 0 && pnow < rss_probe_next_ns[pu]) {
+      nr_timer_setup(t, 10, 10);
+      nr_timer_start(t);
+      return;
+    }
+    rss_probe_next_ns[pu] = pnow + 500000000ULL; /* retry about twice a second */
+    rss_probe_tries[pu]++;
