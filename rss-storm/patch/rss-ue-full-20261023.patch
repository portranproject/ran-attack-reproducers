+/* ---- RA pipelining helpers (RRC signaling storm reproducer, UE only) ----
+ *
+ * ra_parallel == 1 reproduces upstream exactly: one slot, every helper is a
+ * no-op. Above 1, an instance may hold several procedures at once, which is
+ * what raises the arrival rate at the gNB: the measured per-instance cycle is
+ * ~69 ms and 76% of it is spent waiting for Msg4 with nothing else in flight.
+ *
+ * A free slot is one whose state is SUCCEEDED or FAILED (FAILED is what calloc
+ * plus the initialiser leaves, and no code assigns it), so "free" never
+ * collides with nrRA_UE_IDLE, which means "armed, start pending". */
+bool rss_ra_slot_free(const RA_config_t *ra)
+{
+  return ra->ra_state == nrRA_SUCCEEDED || ra->ra_state == nrRA_FAILED;
+}
+
+int rss_ra_alloc(NR_UE_MAC_INST_t *mac)
+{
+  if (mac->ra_parallel <= 1)
+    return 0;
+  for (int i = 0; i < mac->ra_parallel && i < NR_UE_MAX_PARALLEL_RA; i++)
+    if (rss_ra_slot_free(&mac->ra_pool[i]))
+      return i;
+  return -1;
+}
+
+/* Two live procedures must never share a preamble index: the gNB answers one
+ * preamble with one RAR carrying that RAPID and mints one TC-RNTI, so a
+ * collision makes the RAR ambiguous and both slots would adopt the same
+ * TC-RNTI. The loser's contention resolution then tears down the context the
+ * winner owns. All 64 indices are in use on this cell, so with at most 4 live
+ * slots a redraw almost always succeeds on the first try. */
+bool rss_preamble_taken(const NR_UE_MAC_INST_t *mac, int idx, const RA_config_t *self)
+{
+  if (mac->ra_parallel <= 1)
+    return false;
+  for (int i = 0; i < mac->ra_parallel && i < NR_UE_MAX_PARALLEL_RA; i++) {
+    const RA_config_t *o = &mac->ra_pool[i];
+    if (o == self || rss_ra_slot_free(o))
+      continue;
+    if (o->ra_PreambleIndex == idx)
+      return true;
+  }
+  return false;
+}
+
+/* Find the slot that owns an inbound Msg4, by the contention resolution ID it
+ * echoes back. This is the better key at Msg4 time: the gNB returns the 48-bit
+ * value the UE itself put in Msg3, so the owner is identifiable before the
+ * TC-RNTI has been adopted by any slot. */
+int rss_ra_by_contres(NR_UE_MAC_INST_t *mac, const uint8_t *cont_res)
+{
+  if (mac->ra_parallel <= 1)
+    return 0;
+  for (int i = 0; i < mac->ra_parallel && i < NR_UE_MAX_PARALLEL_RA; i++) {
+    const RA_config_t *o = &mac->ra_pool[i];
+    if (rss_ra_slot_free(o))
+      continue;
+    if (memcmp(o->cont_res_id, cont_res, 6) == 0)
+      return i;
+  }
+  return -1;
+}
+
+/* Find the slot that owns an inbound RAR, by the RAPID it carries. */
+int rss_ra_by_rapid(NR_UE_MAC_INST_t *mac, int rapid)
+{
+  if (mac->ra_parallel <= 1)
+    return 0;
+  for (int i = 0; i < mac->ra_parallel && i < NR_UE_MAX_PARALLEL_RA; i++) {
+    const RA_config_t *o = &mac->ra_pool[i];
+    if (!rss_ra_slot_free(o) && o->ra_PreambleIndex == rapid)
+      return i;
+  }
+  return -1;
+}
