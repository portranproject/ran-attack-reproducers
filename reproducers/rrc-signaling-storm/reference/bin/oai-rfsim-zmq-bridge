#!/usr/bin/env python3
"""OAI rfsim UE -> 같은 셀 ZMQ 브리지.

원본 OAI UE는 rfsim(TCP, int16 complex)만 말하고 우리 DU는 ZMQ(complex float)만
말한다. 이 프로세스는 원본 바이너리를 고치지 않고 두 RF 인터페이스만 변환한다.
공격 로직·메시지 내용은 건드리지 않는다.

변환은 numpy로 한다. 순수 파이썬 샘플 루프는 23.04 Msps를 따라가지 못해 UE가
프레임을 놓친다(2026-11-20 p1 실측).
"""
import os
import socket
import struct
import sys
import threading
import time

import numpy as np
import zmq

TCP_HOST = os.environ.get("BRIDGE_TCP_HOST", "127.0.0.1")
TCP_PORT = int(os.environ.get("BRIDGE_TCP_PORT", "4043"))
UL_BIND = os.environ.get("BRIDGE_UL_BIND", "tcp://127.0.0.1:4557")
DL_CONNECT = os.environ.get("BRIDGE_DL_CONNECT", "tcp://127.0.0.1:4556")
DL_RATE = float(os.environ.get("BRIDGE_DL_RATE", "0"))
C16_SCALE = float(os.environ.get("BRIDGE_C16_SCALE", "32767.0"))
DEFAULT_UL_SAMPLES = int(os.environ.get("BRIDGE_UL_BLOCK_SAMPLES", "11520"))
HEADER = struct.Struct("<IIQII")  # size, nbAnt, timestamp, option_value, option_flag
C16 = np.dtype("<i2")
CF = np.dtype("<f4")
latest = bytearray(DEFAULT_UL_SAMPLES * 8)
DL_SOCK = None
latest_lock = threading.Lock()
stop = threading.Event()


def recv_exact(sock, n):
    buf = bytearray()
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            return None
        buf += chunk
    return bytes(buf)


_UL_FLOAT = np.empty(DEFAULT_UL_SAMPLES * 2, dtype=np.float32)
_DL_CLIP = np.empty(DEFAULT_UL_SAMPLES * 2, dtype=np.float32)
_DL_INT = np.empty(DEFAULT_UL_SAMPLES * 2, dtype=np.int16)


def _sized(buffer, size):
    if buffer.size < size:
        return np.empty(size, dtype=buffer.dtype)
    return buffer[:size]


def c16_to_cf(data):
    # 상향: int16 -> float32. 스케일은 곱셈 한 번으로 끝낸다(23.04 Msps 유지).
    source = np.frombuffer(data, dtype=C16)
    out = _sized(_UL_FLOAT, source.size)
    np.multiply(source, 1.0 / C16_SCALE, out=out, dtype=np.float32)
    return out.tobytes()


def cf_to_c16(data):
    # 하향: float32 -> int16. 클리핑과 스케일을 분리해 임시 배열을 재사용한다.
    source = np.frombuffer(data, dtype=CF)
    clipped = _sized(_DL_CLIP, source.size)
    out = _sized(_DL_INT, source.size)
    np.clip(source, -1.0, 1.0, out=clipped)
    np.multiply(clipped, C16_SCALE, out=out, casting="unsafe")
    return out.tobytes()


def ul_loop(sock, ctx):
    rep = ctx.socket(zmq.REP)
    rep.bind(UL_BIND)
    sys.stderr.write(f"bridge: ul bound {UL_BIND}\n")
    sys.stderr.flush()
    try:
        while not stop.is_set():
            rep.recv()
            with latest_lock:
                payload = bytes(latest)
            rep.send(payload)
    finally:
        rep.close(0)


def dl_loop(ctx):
    req = ctx.socket(zmq.REQ)
    req.setsockopt(zmq.LINGER, 0)
    req.connect(DL_CONNECT)
    sys.stderr.write(f"bridge: dl connected {DL_CONNECT}\n")
    sys.stderr.flush()
    ts = 0
    sent = 0
    requests = 0
    started = time.time()
    clock = time.time()
    try:
        while not stop.is_set():
            req.send(b"\x00")
            data = req.recv()
            requests += 1
            n = len(data) // 8
            if n == 0:
                continue
            payload = cf_to_c16(data)
            DL_SOCK.sendall(HEADER.pack(n, 1, ts, 0, 0) + payload)
            ts += n
            sent += n
            # gNB ZMQ는 스스로 실시간 페이스를 갖지 않는다. RF 장치 역할을 하는
            # 브리지가 23.04 Msps로 샘플 시계를 공급해야 UE가 프레임을 놓치지 않는다.
            now = time.time()
            if DL_RATE > 0:
                ahead = (ts / DL_RATE) - (now - clock)
                if ahead > 0:
                    time.sleep(min(ahead, 0.05))
            if now - started >= 5.0:
                sys.stderr.write(
                    f"bridge: dl_samples={sent} rate={sent / (now - started) / 1e6:.2f}Msps "
                    f"block={n} elapsed={now - started:.1f}s\n")
                sys.stderr.flush()
                sent = 0
                started = now
    finally:
        req.close(0)


def main():
    ctx = zmq.Context.instance()
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind((TCP_HOST, TCP_PORT))
    srv.listen(1)
    sys.stderr.write(f"bridge: listening {TCP_HOST}:{TCP_PORT} dl={DL_CONNECT} ul={UL_BIND}\n")
    sys.stderr.flush()
    # odu의 rx ZMQ는 기동 직후 peer가 없으면 세션이 실패한 채 남는다.
    # UE 연결을 기다리지 않고 먼저 UL REP를 열어 DU가 바로 붙게 한다.
    threading.Thread(target=ul_loop, args=(None, ctx), daemon=True).start()
    sock, _ = srv.accept()
    sys.stderr.write("bridge: accepted\n")
    sys.stderr.flush()
    sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
    global DL_SOCK
    DL_SOCK = sock
    # OAI rfsim client waits for the server's first block before it starts.
    sock.sendall(HEADER.pack(1, 1, 0, 0, 0) + b"\x00" * 4)
    threading.Thread(target=dl_loop, args=(ctx,), daemon=True).start()
    try:
        while not stop.is_set():
            hdr = recv_exact(sock, HEADER.size)
            if hdr is None:
                break
            size, nbant, ts, _ov, _of = HEADER.unpack(hdr)
            if not globals().get("_ul_logged"):
                sys.stderr.write(f"bridge: first ul block size={size} ant={nbant} ts={ts}\n")
                sys.stderr.flush()
                globals()["_ul_logged"] = True
            body = recv_exact(sock, size * nbant * 4)
            if body is None:
                break
            with latest_lock:
                converted = c16_to_cf(body)
                chunk = converted[-len(latest):]
                latest[:] = chunk.rjust(len(latest), b"\x00")
    except (ConnectionResetError, BrokenPipeError):
        pass
    finally:
        stop.set()
        sock.close()
        srv.close()
        ctx.term()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
