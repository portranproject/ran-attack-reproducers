#!/usr/bin/env bash
# 실제 UE 경로가 아닌 탐지 엔진 회귀시험용 합성 fixture를 생성·재생한다.
set -euo pipefail
umask 077

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONF=${UPLINK_CONF:-$ROOT/conf/uplink.conf}
[[ ! -L $CONF ]] || { echo "설정 파일은 심볼릭 링크일 수 없습니다: $CONF" >&2; exit 2; }
[[ ! -f $CONF ]] || . "$CONF"

MODE=${1:-}
[[ $MODE != control && $MODE != emulation ]] || shift
ENABLE=0
RUN_ID=
while getopts "e:n:h" option; do
  case $option in
    e) ENABLE=$OPTARG ;;
    n) RUN_ID=$OPTARG ;;
    h) echo "사용법: $0 control|emulation -n RUN_ID [-e 0|1]"; exit 0 ;;
    *) exit 2 ;;
  esac
done

RUN_ROOT=${UPLINK_FIXTURE_RUN_ROOT:-$ROOT/runs-fixture}
DETECTOR_BIN=${DETECTOR_BIN:-}
DETECTOR_CONFIG=${DETECTOR_CONFIG:-}

fail() { echo "uplink-credential-flood-fixture-run: $*" >&2; exit 2; }
[[ $MODE == control || $MODE == emulation ]] || fail "mode는 control 또는 emulation이어야 합니다"
[[ $ENABLE == 0 || $ENABLE == 1 ]] || fail "-e는 0 또는 1이어야 합니다"
[[ $MODE == control && $ENABLE == 0 || $MODE == emulation && $ENABLE == 1 ]] \
  || fail "control은 -e 0, emulation은 명시적 -e 1이 필요합니다"
[[ $RUN_ID =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,80}$ ]] || fail "안전한 RUN_ID가 필요합니다"
for file in "$DETECTOR_BIN" "$DETECTOR_CONFIG"; do
  [[ -f $file && ! -L $file ]] || fail "탐지 엔진 일반 파일이 필요합니다: $file"
done
[[ -x $DETECTOR_BIN ]] || fail "DETECTOR_BIN은 실행 가능해야 합니다"
[[ ! -L $RUN_ROOT ]] || fail "run root는 심볼릭 링크일 수 없습니다"
mkdir -p -m 700 "$RUN_ROOT"
OUT=$RUN_ROOT/$RUN_ID
mkdir -m 700 "$OUT" || fail "기존 실행 결과는 덮어쓰지 않습니다: $OUT"

python3 "$ROOT/analysis/generate_l3_21_replay.py" "$MODE" "$RUN_ID" "$OUT"
export RUN_ID MODE ENABLE
python3 - "$OUT/run.json" "$OUT/detector-input.jsonl" <<'PY'
import hashlib, json, os, pathlib, sys
output, replay = map(pathlib.Path, sys.argv[1:])
value = {
    "schema":"uplink-dos.registration-failure-emulation.v1", "run_id":os.environ["RUN_ID"], "mode":os.environ["MODE"],
    "registration_failure_flood_emulated":os.environ["ENABLE"] == "1", "rf_overshadowing_observed":False,
    "live_protocol_path_observed":False, "reference_p5_reject_count":10, "reference_p5_reject_span_ms":4500,
    "reference_p5_f1_pcap_sha256":"f3222e81d0cef1904159e724ead95e831a8aefa847761069e8cbdbcc264609e6",
    "detector_input_sha256":hashlib.sha256(replay.read_bytes()).hexdigest(),
}
output.write_text(json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n")
PY
python3 "$ROOT/analysis/verify_l3_21.py" "$OUT" "$DETECTOR_BIN" "$DETECTOR_CONFIG"
python3 "$ROOT/analysis/verify_registration_failure_run.py" "$OUT"
