#!/usr/bin/env bash
# p5 ZMQ lifecycle/evidence hooks used by blind-p5-phase.
set -euo pipefail
umask 077

ACTION=${1:-}
P5_CU_HOST=${P5_CU_HOST:-}
P5_SSH_KEY=${P5_SSH_KEY:-}
P5_KNOWN_HOSTS=${P5_KNOWN_HOSTS:-}
P5_EVIDENCE_PY=${P5_EVIDENCE_PY:-}
P5_DU_BIN=${P5_DU_BIN:-}
P5_DU_CFG=${P5_DU_CFG:-}
P5_DU_LOG=${SAME_CELL_DU_LOG:-${P5_DU_LOG:-/tmp/odu.log}}
P5_DU_BOOT_LOG=${P5_DU_BOOT_LOG:-/tmp/blind-dos-odu.boot.log}
P5_DU_PID_FILE=${P5_DU_PID_FILE:-/tmp/blind-dos-odu.pid}
P5_CU_LOG=${P5_CU_LOG:-/tmp/ocu.log}
P5_CORE_CONTAINER=${P5_CORE_CONTAINER:-open5gs_5gc}
P5_VICTIM_TUN=${P5_VICTIM_TUN:-oaitun_ue1p1}
P5_PING_TARGET=${P5_PING_TARGET:-10.45.1.1}
P5_EXTERNAL_RAN=${P5_EXTERNAL_RAN:-0}

fail() { echo "blind-p5-hook: $*" >&2; exit 1; }
need_file() { [[ -f $2 && ! -L $2 ]] || fail "$1 must be a regular non-symlink file"; }
need_dir() { [[ -d $2 && ! -L $2 ]] || fail "$1 must be a real directory"; }
safe_run_id() { [[ ${BLIND_RUN_ID:-} =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$ ]]; }

ssh_args=(-o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new)
if [[ -n $P5_SSH_KEY ]]; then ssh_args+=(-i "$P5_SSH_KEY"); fi
if [[ -n $P5_KNOWN_HOSTS ]]; then ssh_args+=(-o "UserKnownHostsFile=$P5_KNOWN_HOSTS"); fi

cu() {
  [[ -n $P5_CU_HOST ]] || fail "P5_CU_HOST is required"
  local quoted
  printf -v quoted '%q' "$1"
  ssh "${ssh_args[@]}" "$P5_CU_HOST" "sudo bash -lc $quoted"
}

state_dir() {
  local value=$1
  need_dir "state directory" "$value"
  printf '%s\n' "$value"
}

fetch_amf_raw() {
  local state since
  state=$(state_dir "${BLIND_LOG_SLICE_STATE_DIR:-}")
  need_file "log start timestamp" "$state/start.utc"
  since=$(<"$state/start.utc")
  [[ $since =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T ]] || fail "invalid log start timestamp"
  cu "docker logs --timestamps --since '$since' '$P5_CORE_CONTAINER' 2>&1" \
    >"$state/amf.raw"
  [[ -s $state/amf.raw ]] || fail "AMF current-run slice is empty"
  export BLIND_AMF_RAW_LOG=$state/amf.raw
}

stop_capture() {
  local state=$1 name=$2 pid_file=$state/$2.pid pid remote
  [[ -f $pid_file && ! -L $pid_file ]] || return 0
  pid=$(<"$pid_file")
  [[ $pid =~ ^[1-9][0-9]*$ ]] || fail "invalid $name capture pid"
  remote="/tmp/blind-${BLIND_RUN_ID}-${name}.pcap"
  cu "kill -INT '$pid' 2>/dev/null || true; for _ in \$(seq 1 50); do kill -0 '$pid' 2>/dev/null || break; sleep 0.1; done; ! kill -0 '$pid' 2>/dev/null; chmod 600 '$remote'; test -s '$remote'"
}

case $ACTION in
  process-clear)
    [[ $P5_EXTERNAL_RAN == 1 ]] \
      || ! pgrep -x nr-uesoftmodem >/dev/null \
      || fail "an OAI UE is already running"
    ;;
  du-stop)
    if [[ -f $P5_DU_PID_FILE && ! -L $P5_DU_PID_FILE ]]; then
      pid=$(<"$P5_DU_PID_FILE")
      if [[ $pid =~ ^[1-9][0-9]*$ ]]; then
        kill -TERM "$pid" 2>/dev/null || true
        for _ in $(seq 1 30); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
        kill -KILL "$pid" 2>/dev/null || true
      fi
      unlink "$P5_DU_PID_FILE" 2>/dev/null || true
    fi
    pkill -TERM -x odu 2>/dev/null || true
    for _ in $(seq 1 30); do pgrep -x odu >/dev/null || break; sleep 0.1; done
    ! pgrep -x odu >/dev/null || fail "DU did not stop"
    ;;
  du-restart)
    need_file "P5_DU_BIN" "$P5_DU_BIN"
    need_file "P5_DU_CFG" "$P5_DU_CFG"
    [[ -x $P5_DU_BIN ]] || fail "P5_DU_BIN must be executable"
    unlink "$P5_DU_LOG" 2>/dev/null || true
    unlink "$P5_DU_BOOT_LOG" 2>/dev/null || true
    unlink "$P5_DU_PID_FILE" 2>/dev/null || true
    setsid stdbuf -oL -eL "$P5_DU_BIN" -c "$P5_DU_CFG" \
      >"$P5_DU_BOOT_LOG" 2>&1 </dev/null &
    printf '%s\n' "$!" >"$P5_DU_PID_FILE"
    ;;
  du-ready)
    if [[ $P5_EXTERNAL_RAN == 1 ]]; then
      pgrep -x odu >/dev/null || fail "DU process is not alive"
    else
      need_file "DU pid file" "$P5_DU_PID_FILE"
      pid=$(<"$P5_DU_PID_FILE")
      [[ $pid =~ ^[1-9][0-9]*$ ]] && kill -0 "$pid" 2>/dev/null \
        || fail "DU process is not alive"
    fi
    grep -Eqi 'F1 Setup procedure successful|E2 Setup procedure successful' "$P5_DU_LOG" \
      || fail "DU is not F1/E2 ready"
    ;;
  endpoint-ready)
    [[ ${BLIND_CHILD_PID:-} =~ ^[1-9][0-9]*$ ]] \
      && kill -0 "$BLIND_CHILD_PID" 2>/dev/null || fail "UE process is not alive"
    ss -ltnp | grep -F "pid=$BLIND_CHILD_PID," >/dev/null \
      || fail "UE ZMQ endpoint is not listening yet"
    ;;
  registration)
    need_file "victim log" "${BLIND_VICTIM_LOG_PATH:-}"
    grep -q 'Received Registration Accept' "$BLIND_VICTIM_LOG_PATH"
    ;;
  tun)
    ip link show dev "$P5_VICTIM_TUN" >/dev/null 2>&1
    ;;
  ping)
    ping -I "$P5_VICTIM_TUN" -c 1 -W 1 "$P5_PING_TARGET" >/dev/null 2>&1
    ;;
  log-start)
    state=$(state_dir "${BLIND_LOG_SLICE_STATE_DIR:-}")
    cu "date -u +%Y-%m-%dT%H:%M:%S.%NZ" >"$state/start.utc"
    cu "stat -c %s '$P5_CU_LOG'" >"$state/cu.offset"
    stat -c %s "$P5_DU_LOG" >"$state/du.offset"
    ;;
  snapshot)
    need_file "P5_EVIDENCE_PY" "$P5_EVIDENCE_PY"
    fetch_amf_raw
    python3 "$P5_EVIDENCE_PY" snapshot
    ;;
  log-stop)
    need_file "P5_EVIDENCE_PY" "$P5_EVIDENCE_PY"
    state=$(state_dir "${BLIND_LOG_SLICE_STATE_DIR:-}")
    fetch_amf_raw
    cu_offset=$(<"$state/cu.offset")
    du_offset=$(<"$state/du.offset")
    [[ $cu_offset =~ ^[0-9]+$ && $du_offset =~ ^[0-9]+$ ]] || fail "invalid log offset"
    cu "tail -c +$((cu_offset + 1)) '$P5_CU_LOG'" >"$state/cu.raw"
    tail -c +$((du_offset + 1)) "$P5_DU_LOG" >"$state/du.raw"
    python3 "$P5_EVIDENCE_PY" normalize \
      --amf-raw "$state/amf.raw" --cu-raw "$state/cu.raw" --du-raw "$state/du.raw" \
      --amf-output "$BLIND_AMF_LOG_PATH" --cu-output "$BLIND_CU_LOG_PATH" \
      --du-output "$BLIND_DU_LOG_PATH"
    ;;
  capture-start)
    safe_run_id || fail "invalid BLIND_RUN_ID"
    state=$(state_dir "${BLIND_CAPTURE_STATE_DIR:-}")
    for name in ngap f1ap; do
      port=38412; [[ $name == f1ap ]] && port=38472
      remote="/tmp/blind-${BLIND_RUN_ID}-${name}.pcap"
      log="/tmp/blind-${BLIND_RUN_ID}-${name}.tcpdump.log"
      pid=$(cu "test ! -e '$remote'; nohup setsid tcpdump -i any -U -s 0 -w '$remote' 'sctp port $port' >'$log' 2>&1 </dev/null & echo \$!")
      [[ $pid =~ ^[1-9][0-9]*$ ]] || fail "cannot start $name capture"
      printf '%s\n' "$pid" >"$state/$name.pid"
      cu "kill -0 '$pid'"
    done
    ;;
  capture-stop)
    safe_run_id || fail "invalid BLIND_RUN_ID"
    state=$(state_dir "${BLIND_CAPTURE_STATE_DIR:-}")
    stop_capture "$state" ngap
    stop_capture "$state" f1ap
    cu "cat '/tmp/blind-${BLIND_RUN_ID}-ngap.pcap'" >"$BLIND_NGAP_PCAP_PATH"
    cu "cat '/tmp/blind-${BLIND_RUN_ID}-f1ap.pcap'" >"$BLIND_F1AP_PCAP_PATH"
    cu "unlink '/tmp/blind-${BLIND_RUN_ID}-ngap.pcap'; unlink '/tmp/blind-${BLIND_RUN_ID}-f1ap.pcap'; unlink '/tmp/blind-${BLIND_RUN_ID}-ngap.tcpdump.log' 2>/dev/null || true; unlink '/tmp/blind-${BLIND_RUN_ID}-f1ap.tcpdump.log' 2>/dev/null || true"
    ;;
  network-events)
    need_file "P5_EVIDENCE_PY" "$P5_EVIDENCE_PY"
    python3 "$P5_EVIDENCE_PY" network-events \
      --before "$BLIND_RUN_DIR/target_snapshot_before.json"
    ;;
  *)
    fail "usage: $0 {process-clear|du-stop|du-restart|du-ready|endpoint-ready|registration|tun|ping|log-start|snapshot|log-stop|capture-start|capture-stop|network-events}"
    ;;
esac
