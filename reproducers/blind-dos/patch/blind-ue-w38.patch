+#define BLIND_PARAMS_DESC { \
+  {"enable", "1 = reuse one current 5G-S-TMSI in an isolated testbed\n", 0, .iptr=&blind_cfg.enable, .defintval=0, TYPE_INT, 0}, \
+  {"amf_region_id", "AMF Region ID used to reconstruct the victim 5G-GUTI\n", 0, .iptr=&blind_cfg.amf_region_id, .defintval=-1, TYPE_INT, 0}, \
+  {"recovery_mode", "1 = keep a victim UE process alive after Registration Reject for lab recovery\n", 0, .iptr=&blind_cfg.recovery_mode, .defintval=0, TYPE_INT, 0}, \
+  {"tun_suffix", "1 = include the PDU session ID in the UE TUN name\n", 0, .iptr=&blind_cfg.tun_suffix, .defintval=0, TYPE_INT, 0}, \
+  {"target_5g_s_tmsi", "exact 48-bit target as 0x followed by 12 hex digits\n", 0, .strptr=&blind_cfg.target_text, .defstrval=NULL, TYPE_STRING, 0}, \
+  {"target_file", "absolute path atomically created with the exact target when the one-shot may start\n", 0, .strptr=&blind_cfg.target_file, .defstrval=NULL, TYPE_STRING, 0}, \
+  {"target_wait_s", "finite target-file wait in seconds\n", 0, .iptr=&blind_cfg.target_wait_s, .defintval=120, TYPE_INT, 0}, \
+  {"run_id", "safe run identifier written to every event\n", 0, .strptr=&blind_cfg.run_id, .defstrval=NULL, TYPE_STRING, 0}, \
