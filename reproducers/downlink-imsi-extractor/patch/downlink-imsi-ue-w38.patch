+static bool emulate_downlink_imsi_extractor(nr_ue_nas_t *nas, as_nas_info_t *initialNasMsg)
+{
+  if (!downlink_imsi_enabled("OAI_DOWNLINK_IMSI_EMULATE"))
+    return false;
+  AssertFatal(nas->UE_id >= 0 && nas->UE_id < MAX_NUM_NR_UE_INST, "invalid UE id %ld\n", nas->UE_id);
+  bool repeated = atomic_exchange(&downlink_imsi_identity_sent[nas->UE_id], true);
+  if (!repeated)
+    generateIdentityResponse(nas, initialNasMsg, FGS_MOBILE_IDENTITY_SUCI);
+  LOG_W(NAS,
+        "DOWNLINK_IMSI_EXTRACTOR event=%s ue=%ld identity_type=suci protection_scheme=%d "
+        "identity_response_submitted=%s identity_response_substitution_emulated=true "
+        "dl_overshadowing_observed=false\n",
+        repeated ? "authentication_request_retransmission_ignored" : "identity_response_substituted",
+        nas->UE_id,
+        nas->uicc->protection_scheme,
+        !repeated && initialNasMsg->length > 0 ? "true" : "false");
+  return true;
+}
+
+static void trace_downlink_imsi_control(const nr_ue_nas_t *nas, const as_nas_info_t *initialNasMsg)
+{
+  if (downlink_imsi_enabled("OAI_DOWNLINK_IMSI_TRACE"))
+    LOG_I(NAS,
+          "DOWNLINK_IMSI_EXTRACTOR event=authentication_response_submitted ue=%ld response_submitted=%s "
+          "identity_response_substitution_emulated=false dl_overshadowing_observed=false\n",
+          nas->UE_id,
+          initialNasMsg->length > 0 ? "true" : "false");
+}
