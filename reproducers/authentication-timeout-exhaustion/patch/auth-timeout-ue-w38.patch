+static bool auth_timeout_enabled(const char *name)
+{
+  const char *enabled = getenv(name);
+  return enabled && strcmp(enabled, "1") == 0;
+}
+
+static bool auth_timeout_withholding_enabled(void)
+{
+  if (auth_timeout_enabled("OAI_AUTH_TIMEOUT_WITHHOLD"))
+    return true;
+  const char *arm_file = getenv("OAI_AUTH_TIMEOUT_ARM_FILE");
+  return arm_file && arm_file[0] && access(arm_file, F_OK) == 0;
+}
+
+static bool withhold_authentication_response(int ue)
+{
+  if (!auth_timeout_withholding_enabled())
+    return false;
+  AssertFatal(ue >= 0 && ue < MAX_NUM_NR_UE_INST, "invalid UE id %d\n", ue);
+  bool repeated = atomic_exchange(&auth_timeout_seen[ue], true);
+  LOG_W(NAS,
+        "AUTH_TIMEOUT_EXHAUSTION event=authentication_request_withheld ue=%d "
+        "response_submitted=false retransmission=%s\n",
+        ue,
+        repeated ? "true" : "false");
+  return true;
+}
+
+static void trace_authentication_response(int ue)
+{
+  if (auth_timeout_enabled("OAI_AUTH_TIMEOUT_TRACE"))
+    LOG_I(NAS,
+          "AUTH_TIMEOUT_EXHAUSTION event=authentication_response_submitted ue=%d "
+          "response_submitted=true\n",
+          ue);
+}
 
