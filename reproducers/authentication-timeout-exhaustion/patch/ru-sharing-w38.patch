+    openair0_device_t *sdev = &openair0_dev[UE->rf_map.card];
+    nr_rf_card_config_freq(scfg, ul_carrier, dl_carrier, freq_offset);
+    if (UE->Mod_id == 0)
+      sdev->trx_set_freq_func(sdev, scfg);
+    return;
+  }
   int current_cell_id = nrue_rus[UE->rf_map.card].used_by_cell;
   NR_DL_FRAME_PARMS *fp0 = &nrue_cell_fp[current_cell_id];
   uint64_t dl_carrier_distance =
@@ -430,6 +870,8 @@ int nrue_ru_adjust_rx_gain(PHY_VARS_NR_UE *UE, int gain_change)
 
 int nrue_ru_read(PHY_VARS_NR_UE *UE, openair0_timestamp_t *ptimestamp, void **buff, int nsamps, int num_antennas)
 {
+  if (rss_share.active)
+    return rss_shared_read(UE, ptimestamp, buff, nsamps, num_antennas);
   openair0_device_t *dev = &openair0_dev[UE->rf_map.card];
   openair0_timestamp_t tmp_timestamp;
   int ret = dev->trx_read_func(dev, &tmp_timestamp, buff, nsamps, num_antennas);
@@ -470,6 +912,8 @@ int nrue_ru_read(PHY_VARS_NR_UE *UE, openair0_timestamp_t *ptimestamp, void **bu
 
 int nrue_ru_write(PHY_VARS_NR_UE *UE, openair0_timestamp_t timestamp, void **buff, int nsamps, int num_antennas, int flags)
 {
+  if (rss_share.active)
+    return rss_shared_write(UE, timestamp, buff, nsamps, num_antennas, flags);
   openair0_device_t *dev = &openair0_dev[UE->rf_map.card];
   int ret = dev->trx_write_func(dev, timestamp + dev->firstTS, buff, nsamps, num_antennas, flags);
 
@@ -500,6 +944,10 @@ int nrue_ru_write(PHY_VARS_NR_UE *UE, openair0_timestamp_t timestamp, void **buf
 
 int nrue_ru_write_reorder(PHY_VARS_NR_UE *UE, openair0_timestamp_t timestamp, void **txp, int nsamps, int nbAnt, int flags)
 {
+  /* The reorder context lives in the device and assumes a single writer.
+     With shared RU the summing path already serialises the device write. */
+  if (rss_share.active)
+    return rss_shared_write(UE, timestamp, txp, nsamps, nbAnt, flags);
   openair0_device_t *device = &openair0_dev[UE->rf_map.card];
   return openair0_write_reorder_common(nrue_ru_write, UE, device, timestamp, txp, nsamps, nbAnt, flags);
 }
diff --git a/executables/nr-ue-ru.h b/executables/nr-ue-ru.h
index 7d0836c..ab1b10f 100644
--- a/executables/nr-ue-ru.h
+++ b/executables/nr-ue-ru.h
@@ -31,4 +31,11 @@ int nrue_ru_write(PHY_VARS_NR_UE *UE, openair0_timestamp_t timestamp, void **buf
 int nrue_ru_write_reorder(PHY_VARS_NR_UE *UE, openair0_timestamp_t timestamp, void **txp, int nsamps, int nbAnt, int flags);
