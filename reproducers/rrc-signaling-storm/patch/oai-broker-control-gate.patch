+static bool rss_broker_attack_enabled(void)
+{
+  const char *path = getenv("RSS_BROKER_CONTROL_FILE");
+  if (!path || path[0] == '\0')
+    return true;
+
+  FILE *control = fopen(path, "r");
+  if (!control)
+    return false;
+  char mode[6];
+  const bool enabled = fread(mode, 1, sizeof(mode), control) == sizeof(mode)
+                       && memcmp(mode, "attack", sizeof(mode)) == 0;
+  fclose(control);
+  return enabled;
+}
+
 bool nr_rss_probe_withheld(int ue)
 {
   if (!nr_rss_is_probe(ue))
     return false;
+  if (!rss_broker_attack_enabled())
+    return true;
   const uint64_t delay_ms = rss_probe_delay_ms(ue, rss_get_cfg()->probe_delay_ms);
   if (delay_ms == 0)
     return false;
