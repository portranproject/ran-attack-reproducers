diff --git a/executables/nr-ue-ru.c b/executables/nr-ue-ru.c
index 95346ae..28b2c64 100644
--- a/executables/nr-ue-ru.c
+++ b/executables/nr-ue-ru.c
@@ -91,6 +91,253 @@ static nrUE_RU_params_t *nrue_rus;
 openair0_config_t openair0_cfg_g[MAX_CARDS] = {};
 static openair0_device_t openair0_dev[MAX_CARDS] = {};
 
+/* ---------------------------------------------------------------------------
+ * RU sharing between UE instances (RRC signaling storm reproducer, UE only).
+ *
+ * Upstream refuses this in nr-uesoftmodem.c: "cells map 1:1 to RUs and RU
+ * sharing is not implemented". The testbed DU exposes exactly one ZMQ port
+ * pair, so putting several attacker UEs on the same cell needs that rule
+ * relaxed.
+ *
+ * An external ZMQ broker was rejected: it would copy 23.04 MS/s * 8 B per
+ * direction a second time on a path that already runs about 6x slower than
+ * real time (see testbed-checklist.md 12.3). Sharing inside the process keeps
+ * the number of ZMQ round trips per slot unchanged: one UE fetches each slot
+ * and the others receive a copy, and the uplink of all UEs is summed into a
+ * single device write. The gNB is never modified.
+ * -------------------------------------------------------------------------*/
+#define RSS_SHARE_MAX_ANT 4
+#define RSS_SHARE_WAIT_MS 100
+
+typedef struct {
+  bool active;
+  int n_ue;
+  pthread_mutex_t mtx;
+  pthread_cond_t cv;
+  /* downlink: one reader fills a ring, every UE has its own cursor.
+     A round-based copy was wrong: UEs do not always ask for the same chunk
+     size (syncInFrame() asks for its own unit), and handing back another UE's
+     sample count tripped "unitTransfer == res" in nr-ue.c:714 on the box
+     2026-10-20. Per-UE cursors give each UE exactly what it asked for, in
+     stream order. */
+  bool rd_fetching;
+  uint64_t rd_prod;                       /* absolute samples produced */
+  uint64_t rd_cons[MAX_NUM_NR_UE_INST];   /* absolute samples consumed per UE */
+  bool rd_joined[MAX_NUM_NR_UE_INST];     /* UE has taken part at least once */
+  openair0_timestamp_t rd_ts0;            /* device ts of absolute sample 0 */
+  bool rd_ts0_set;
+  c16_t *rd_ring[RSS_SHARE_MAX_ANT];
+  uint64_t rd_ring_sz;                    /* power of two */
+  /* uplink: accumulate every UE, then one device write */
+  uint64_t wr_round;
+  int wr_joined;
+  openair0_timestamp_t wr_ts;
+  int wr_nsamps;
+  int wr_nant;
+  int wr_flags;
+  int32_t *wr_acc[RSS_SHARE_MAX_ANT];
+  c16_t *wr_out[RSS_SHARE_MAX_ANT];
+  int wr_cap;
+} rss_ru_share_t;
+
+static rss_ru_share_t rss_share = {.mtx = PTHREAD_MUTEX_INITIALIZER, .cv = PTHREAD_COND_INITIALIZER};
+
+bool nrue_ru_sharing_enabled(void)
+{
+  return NB_UE_INST > 1;
+}
+
+void nrue_ru_sharing_init(void)
+{
+  if (!nrue_ru_sharing_enabled())
+    return;
+  rss_share.active = true;
+  rss_share.n_ue = NB_UE_INST;
+  /* cursors start lazily: each UE joins the stream at the current head */
+  LOG_W(HW, "[RSS] RU sharing enabled: %d UE instances on one radio\n", rss_share.n_ue);
+}
+
+/* Bounded wait: a UE that stops producing must degrade the run, not hang it. */
+static void rss_share_wait(void)
+{
+  struct timespec ts;
+  clock_gettime(CLOCK_REALTIME, &ts);
+  ts.tv_nsec += RSS_SHARE_WAIT_MS * 1000000L;
+  if (ts.tv_nsec >= 1000000000L) {
+    ts.tv_sec += 1;
+    ts.tv_nsec -= 1000000000L;
+  }
+  pthread_cond_timedwait(&rss_share.cv, &rss_share.mtx, &ts);
+}
+
+#define RSS_RING_SAMPLES (1u << 21) /* ~2M samples/antenna, 8 MB as c16_t */
+
+/* Lowest cursor among UEs that have started consuming. Caller holds the mutex. */
+static uint64_t rss_min_cons(const rss_ru_share_t *s)
+{
+  uint64_t m = s->rd_prod;
+  bool any = false;
+  for (int i = 0; i < MAX_NUM_NR_UE_INST; i++) {
+    if (!s->rd_joined[i])
+      continue;
+    any = true;
+    if (s->rd_cons[i] < m)
+      m = s->rd_cons[i];
+  }
+  return any ? m : s->rd_prod;
+}
+
+static int rss_shared_read(PHY_VARS_NR_UE *UE, openair0_timestamp_t *ptimestamp, void **buff, int nsamps, int nant)
+{
+  rss_ru_share_t *s = &rss_share;
+  const int id = UE->Mod_id;
+  AssertFatal(nant <= RSS_SHARE_MAX_ANT, "RU sharing supports at most %d antennas\n", RSS_SHARE_MAX_ANT);
+  AssertFatal(id >= 0 && id < MAX_NUM_NR_UE_INST, "bad UE instance %d\n", id);
+  AssertFatal((uint64_t)nsamps < RSS_RING_SAMPLES / 2, "read of %d samples exceeds the shared ring\n", nsamps);
+
+  pthread_mutex_lock(&s->mtx);
+  if (s->rd_ring_sz == 0) {
+    for (int a = 0; a < RSS_SHARE_MAX_ANT; a++)
+      s->rd_ring[a] = calloc_or_fail(RSS_RING_SAMPLES, sizeof(c16_t));
+    s->rd_ring_sz = RSS_RING_SAMPLES;
+  }
+  if (!s->rd_joined[id]) {
+    /* join at the current head so a late UE does not replay history */
+    s->rd_cons[id] = s->rd_prod;
+    s->rd_joined[id] = true;
+  }
+
+  while (s->rd_prod - s->rd_cons[id] < (uint64_t)nsamps) {
+    /* room is bounded by the slowest consumer, so nobody loses samples */
+    uint64_t room = s->rd_ring_sz - (s->rd_prod - rss_min_cons(s));
+    if (!s->rd_fetching && room >= (uint64_t)nsamps) {
+      s->rd_fetching = true;
+      uint64_t head = s->rd_prod;
+      int want = nsamps;
+      /* never wrap inside one device read */
+      uint64_t off = head & (s->rd_ring_sz - 1);
+      if (off + (uint64_t)want > s->rd_ring_sz)
+        want = (int)(s->rd_ring_sz - off);
+      void *tgt[RSS_SHARE_MAX_ANT];
+      for (int a = 0; a < nant; a++)
+        tgt[a] = s->rd_ring[a] + off;
+      pthread_mutex_unlock(&s->mtx);
+      openair0_device_t *dev = &openair0_dev[UE->rf_map.card];
+      openair0_timestamp_t tmp = 0;
+      int got = dev->trx_read_func(dev, &tmp, tgt, want, nant);
+      pthread_mutex_lock(&s->mtx);
+      if (!dev->firstTS_initialized) {
+        dev->firstTS = tmp;
+        dev->firstTS_initialized = true;
+      }
+      if (!s->rd_ts0_set) {
+        s->rd_ts0 = tmp - dev->firstTS; /* ts of absolute sample 0 */
+        s->rd_ts0_set = true;
+      }
+      if (got > 0)
+        s->rd_prod += (uint64_t)got;
+      s->rd_fetching = false;
+      pthread_cond_broadcast(&s->cv);
+    } else {
+      rss_share_wait();
+    }
+  }
+
+  uint64_t off = s->rd_cons[id] & (s->rd_ring_sz - 1);
+  int first = (int)((off + (uint64_t)nsamps > s->rd_ring_sz) ? (s->rd_ring_sz - off) : (uint64_t)nsamps);
+  for (int a = 0; a < nant; a++) {
+    c16_t *dst = (c16_t *)buff[a];
+    memcpy(dst, s->rd_ring[a] + off, (size_t)first * sizeof(c16_t));
+    if (first < nsamps)
+      memcpy(dst + first, s->rd_ring[a], (size_t)(nsamps - first) * sizeof(c16_t));
+  }
+  *ptimestamp = s->rd_ts0 + (openair0_timestamp_t)s->rd_cons[id];
+  s->rd_cons[id] += (uint64_t)nsamps;
+  pthread_cond_broadcast(&s->cv);
+  pthread_mutex_unlock(&s->mtx);
+  return nsamps;
+}
+
+/* Push the open uplink batch to the radio. Caller holds the mutex. */
+static void rss_flush_locked(PHY_VARS_NR_UE *UE)
+{
+  rss_ru_share_t *s = &rss_share;
+  if (s->wr_joined == 0)
+    return;
+  for (int a = 0; a < s->wr_nant; a++) {
+    const int32_t *acc = s->wr_acc[a];
+    c16_t *out = s->wr_out[a];
+    for (int i = 0; i < s->wr_nsamps; i++) {
+      int32_t re = acc[2 * i];
+      int32_t im = acc[2 * i + 1];
+      out[i].r = re > INT16_MAX ? INT16_MAX : (re < INT16_MIN ? INT16_MIN : (int16_t)re);
+      out[i].i = im > INT16_MAX ? INT16_MAX : (im < INT16_MIN ? INT16_MIN : (int16_t)im);
+    }
+  }
+  openair0_device_t *dev = &openair0_dev[UE->rf_map.card];
+  void *tgt[RSS_SHARE_MAX_ANT];
+  for (int a = 0; a < s->wr_nant; a++)
+    tgt[a] = s->wr_out[a];
+  dev->trx_write_func(dev, s->wr_ts + dev->firstTS, tgt, s->wr_nsamps, s->wr_nant, s->wr_flags);
+  s->wr_joined = 0;
+  s->wr_round++;
+  pthread_cond_broadcast(&s->cv);
+}
+
+/* Sum the uplink of every sharing UE into one device write.
+ *
+ * A batch is keyed by (timestamp, nsamps, nant); without that key the batches
+ * mixed across slots as soon as more than two UEs ran. The function always
+ * returns nsamps because the device write is aggregated, so the per-caller
+ * contract is "your samples were accepted". */
+static int rss_shared_write(PHY_VARS_NR_UE *UE, openair0_timestamp_t timestamp, void **buff, int nsamps, int nant, int flags)
+{
+  rss_ru_share_t *s = &rss_share;
+  AssertFatal(nant <= RSS_SHARE_MAX_ANT, "RU sharing supports at most %d antennas\n", RSS_SHARE_MAX_ANT);
+
+  pthread_mutex_lock(&s->mtx);
+  if (s->wr_cap < nsamps) {
+    rss_flush_locked(UE); /* old buffers are about to go away */
+    for (int a = 0; a < RSS_SHARE_MAX_ANT; a++) {
+      free(s->wr_acc[a]);
+      free(s->wr_out[a]);
+      s->wr_acc[a] = calloc_or_fail(2 * nsamps, sizeof(int32_t));
+      s->wr_out[a] = calloc_or_fail(nsamps, sizeof(c16_t));
+    }
+    s->wr_cap = nsamps;
+  }
+
+  /* a write that does not belong to the open batch closes it first */
+  if (s->wr_joined > 0 && (s->wr_ts != timestamp || s->wr_nsamps != nsamps || s->wr_nant != nant))
+    rss_flush_locked(UE);
+
+  if (s->wr_joined == 0) {
+    for (int a = 0; a < nant; a++)
+      memset(s->wr_acc[a], 0, 2 * (size_t)nsamps * sizeof(int32_t));
+    s->wr_ts = timestamp;
+    s->wr_nsamps = nsamps;
+    s->wr_nant = nant;
+    s->wr_flags = flags;
+  }
+
+  for (int a = 0; a < nant; a++) {
+    const c16_t *src = (const c16_t *)buff[a];
+    int32_t *acc = s->wr_acc[a];
+    for (int i = 0; i < nsamps; i++) {
+      acc[2 * i] += src[i].r;
+      acc[2 * i + 1] += src[i].i;
+    }
+  }
+  s->wr_joined++;
+
+  if (s->wr_joined >= s->n_ue)
+    rss_flush_locked(UE);
+
+  pthread_mutex_unlock(&s->mtx);
+  return nsamps;
+}
+
