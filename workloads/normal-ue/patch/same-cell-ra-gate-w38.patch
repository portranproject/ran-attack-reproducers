+static bool same_cell_ra_gate_open(void)
+{
+  const char *path = getenv("OAI_SAME_CELL_GATE_FILE");
+  if (!path || path[0] == '\0')
+    return true;
+  FILE *gate = fopen(path, "r");
+  if (!gate)
+    return false;
+  char mode[6];
+  const bool open = fread(mode, 1, sizeof(mode), gate) == sizeof(mode)
+                    && memcmp(mode, "attack", sizeof(mode)) == 0;
+  fclose(gate);
+  return open;
+}
+
+static void wait_same_cell_ra_gate(void)
+{
+  while (!same_cell_ra_gate_open())
+    usleep(100000);
+}
