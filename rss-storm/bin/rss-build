#!/usr/bin/env bash
# rss-build — apply the UE-side patch to an OAI tree and build the attacker UE.
#
# Run this on the host that will run the attacker UE. It never touches the gNB.
# Refuses local changes; review and preserve them before applying another patch.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONF="${RSS_CONF:-$HERE/conf/rss.conf}"
if [[ -f "$CONF" ]]; then
  # A broken line in the conf file (bad quoting, a stray command) would
  # otherwise abort the script with no message at all, because `set -e` sees
  # the failed source. Say what happened instead.
  # shellcheck source=/dev/null
  . "$CONF" || { echo "cannot load $CONF — a line in it failed. Check quoting, e.g. GNB_RESTART_CMD='/path/script start'" >&2; exit 1; }
fi

OAI=${OAI:-/root/OAI}
PATCH=${PATCH:-$HERE/patch/rss-ue-curated.patch}
DCI_FIX="$HERE/patch/oai-stale-rnti-dci.patch"
ACK_RNTI_FIX="$HERE/patch/oai-msg4-ack-rnti.patch"
BRANCH=${BRANCH:-rss-ue-a-type}
BUILD="$OAI/cmake_targets/ran_build/build"
BIN="$BUILD/nr-uesoftmodem"
# radio/zmq/zmq_radio.cpp builds into a separate shared library that the UE
# loads at runtime (--device.name oai_zmqdevif), so it needs its own target.
# Building only nr-uesoftmodem silently leaves the old device in place.
DEVLIB="$BUILD/liboai_zmqdevif.so"
EXPECT_COMMIT=${EXPECT_COMMIT:-1c2f4d3c2e68181cdef9f426d161163147ad4b77}

git -C "$OAI" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
  || { echo "not an OAI git tree: $OAI" >&2; exit 1; }
[[ -f $PATCH ]] || { echo "patch not found: $PATCH" >&2; exit 1; }
[[ -f $DCI_FIX ]] || { echo "OAI stale-RNTI DCI fix not found: $DCI_FIX" >&2; exit 1; }
[[ -f $ACK_RNTI_FIX ]] || { echo "OAI Msg4 ACK RNTI fix not found: $ACK_RNTI_FIX" >&2; exit 1; }
[[ -d $BUILD ]] || { echo "no build dir $BUILD — build stock OAI once first" >&2; exit 1; }

TREE_STATE=$(git -C "$OAI" status --porcelain --untracked-files=all --ignore-submodules=none) \
  || { echo "cannot check local changes in $OAI — nothing changed" >&2; exit 1; }
if [[ -n $TREE_STATE ]]; then
  echo "local changes or untracked files in $OAI — review and preserve them first; nothing changed" >&2
  exit 1
fi

echo "== tree state"
HEAD=$(git -C "$OAI" rev-parse HEAD)
echo "   HEAD        $HEAD"
echo "   describe    $(git -C "$OAI" describe --tags --always 2>/dev/null || echo -)"
if [[ $HEAD != "$EXPECT_COMMIT" ]]; then
  echo "   !! this patch was made against $EXPECT_COMMIT (OAI 2026.w38)."
  echo "      It may not apply to $HEAD; review source compatibility."
fi

if git -C "$OAI" rev-parse --verify --quiet "$BRANCH" >/dev/null; then
  git -C "$OAI" checkout "$BRANCH"
else
  git -C "$OAI" checkout -b "$BRANCH"
fi

# Check the ordered patch stack without changing the real worktree or index.
PATCH_INDEX_DIR=$(mktemp -d)
PATCH_INDEX="$PATCH_INDEX_DIR/index"
trap 'rm -f -- "$PATCH_INDEX"; rmdir -- "$PATCH_INDEX_DIR"' EXIT
GIT_INDEX_FILE="$PATCH_INDEX" git -C "$OAI" read-tree HEAD
for patch_file in "$PATCH" "$DCI_FIX" "$ACK_RNTI_FIX"; do
  GIT_INDEX_FILE="$PATCH_INDEX" git -C "$OAI" apply --cached "$patch_file" \
    || { echo "RSS patch set does not apply cleanly — nothing patched" >&2; exit 1; }
done
rm -f -- "$PATCH_INDEX"
rmdir -- "$PATCH_INDEX_DIR"
trap - EXIT

# keep a way back
if [[ -f $BIN && ! -f $BIN.orig ]]; then cp -p "$BIN" "$BIN.orig"; echo "   saved $BIN.orig"; fi
if [[ -f $DEVLIB && ! -f $DEVLIB.orig ]]; then cp -p "$DEVLIB" "$DEVLIB.orig"; echo "   saved $DEVLIB.orig"; fi

echo "== applying $PATCH"
git -C "$OAI" apply "$PATCH"
echo "== applying $DCI_FIX"
git -C "$OAI" apply "$DCI_FIX"
echo "== applying $ACK_RNTI_FIX"
git -C "$OAI" apply "$ACK_RNTI_FIX"
git -C "$OAI" --no-pager diff --stat | tail -12

for t in nr-uesoftmodem oai_zmqdevif zmq_radio_static; do
  echo "== building $t"
  cmake --build "$BUILD" --target "$t" -- -j"$(nproc)"
done

echo "== knob check (the knobs must be in the artifact that carries them)"
fail=0
check() { # file, needle
  local n; n=$(strings "$1" 2>/dev/null | grep -c "$2" || true)
  printf '   %-26s %-26s %s\n' "$(basename "$1")" "$2" "$n"
  [[ $n -gt 0 ]] || fail=1
}
check "$BIN" target_occupancy
check "$BIN" msg4_wait
check "$BIN" phase_ms
check "$BIN" msg3_tx
check "$BIN" msg4_ack
check "$BIN" msg4_ack_withheld
check "$BIN" msg4_ack_scheduled
check "$BIN" msg5_submitted
check "$BIN" probe_ues
check "$BIN" probe_delay_ms
check "$BIN" probe_ra_only
check "$BIN" probe_interval_ms
check "$BIN" rss_reject_reset_skipped
check "$BIN" RSS_SHARE_LOCKSTEP
check "$BIN" RSS_SHARE_NUE
check "$DEVLIB" RSS_ZMQ_TX_WAIT_US
secret_log=$(strings "$BIN" 2>/dev/null | grep -c 'UICC simulation: IMSI=' || true)
printf '   %-26s %-26s %s\n' "$(basename "$BIN")" "subscriber-secret-log" "$secret_log"
vector_log=$(strings "$BIN" 2>/dev/null | grep -c 'milenage output ik:' || true)
printf '   %-26s %-26s %s\n' "$(basename "$BIN")" "auth-vector-log" "$vector_log"
(( secret_log == 0 && vector_log == 0 )) || fail=1
if (( fail )); then
  echo "   !! a knob is missing or the binary can log subscriber/auth material. Do not trust this build." >&2
  exit 1
fi
echo "== done. The attack is OFF unless you pass -e 1."
