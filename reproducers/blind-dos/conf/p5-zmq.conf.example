# p5 ZMQ example for bin/blind-campaign. Copy outside Git and review every path.
# Attack remains off unless blind-campaign is invoked with both -e 1 and -R N.
ENABLE=0
MATCHED_REPETITIONS=3
INFRA_RETRY_LIMIT=1

BLIND_RUN_ROOT=/root/blind-dos-runs
BLIND_LOCK_FILE=/tmp/blind-dos.lock
PHASE_TIMEOUT_S=300
VERIFY_TIMEOUT_S=60
OBSERVATION_S=12
RECOVERY_TIMEOUT_S=30
ATTACKER_GATE_TIMEOUT_S=240
BASELINE_PING_COUNT=20
LOSS_CONSECUTIVE_PINGS=5
RECOVERY_PING_COUNT=20

PHASE_CMD='exec /root/blind-dos-tool/bin/blind-p5-phase'
VERIFY_CMD='exec python3 /root/blind-dos-tool/analysis/export_labels.py "$BLIND_RUN_DIR" "$BLIND_HOOK_RESULT"'
ARTIFACT_SCANNER=/root/ran-attack-reproducers/reproducers/rrc-signaling-storm/analysis/check_sensitive_artifacts.py
EVIDENCE_TOOL=/root/blind-dos-tool/analysis/evidence_manifest.py

# Replace these with the reviewed G0 inventory and generated profile fingerprints.
CLOCK_SYNC_METHOD=chrony
CLOCK_OFFSET_NS=0
CLOCK_UNCERTAINTY_NS=1000000
MAX_CLOCK_UNCERTAINTY_NS=10000000
CLOCK_EVIDENCE_SHA256=
LAB_INVENTORY_SHA256=
VICTIM_PROFILE_FINGERPRINT=
ATTACKER_PROFILE_FINGERPRINT=

OAI_BLIND_BIN=/root/OAI-blind-dos-w38/cmake_targets/ran_build/build/nr-uesoftmodem
VICTIM_UE_CFG=/root/blind-dos-secrets-v2/victim.conf
ATTACKER_UE_CFG=/root/blind-dos-secrets-v2/attacker.conf
UECAP=/root/OAI-blind-dos-w38/targets/PROJECTS/GENERIC-NR-5GC/CONF/uecap_ports1.xml
VICTIM_ID=victim-v
AMF_REGION_ID=2
BAND=78
DL_FREQ=3489420000
NUMEROLOGY=1
PRB=51
DEVICE=oai_zmqdevif
VICTIM_TX_ENDPOINT=tcp://127.0.0.1:4557
VICTIM_RX_ENDPOINT=tcp://127.0.0.1:4556
ATTACKER_TX_ENDPOINT=tcp://127.0.0.1:4559
ATTACKER_RX_ENDPOINT=tcp://127.0.0.1:4558

P5_HOOK=/root/blind-dos-tool/bin/blind-p5-hook
P5_CU_HOST=ubuntu@172.31.5.10
P5_SSH_KEY=/root/blind-dos-secrets-v2/p5-key.pem
P5_KNOWN_HOSTS=/root/blind-dos-secrets-v2/known_hosts
P5_EVIDENCE_PY=/root/blind-dos-tool/tools/p5_evidence.py
P5_DU_BIN=/root/OCUDU/build/apps/du/odu
P5_DU_CFG=/root/blind-dos-secrets/du-2cell-zmq.yaml
P5_DU_LOG=/tmp/odu2.log
P5_DU_BOOT_LOG=/tmp/blind-dos-odu.boot.log
P5_DU_PID_FILE=/tmp/blind-dos-odu.pid
P5_CU_LOG=/tmp/ocu.log
P5_CORE_CONTAINER=open5gs_5gc
P5_VICTIM_TUN=oaitun_ue1p1
P5_PING_TARGET=10.45.1.1
export P5_HOOK P5_CU_HOST P5_SSH_KEY P5_KNOWN_HOSTS P5_EVIDENCE_PY
export P5_DU_BIN P5_DU_CFG P5_DU_LOG P5_DU_BOOT_LOG P5_DU_PID_FILE
export P5_CU_LOG P5_CORE_CONTAINER P5_VICTIM_TUN P5_PING_TARGET

PROCESS_CLEAR_CMD='exec "$P5_HOOK" process-clear'
DU_STOP_CMD='exec "$P5_HOOK" du-stop'
DU_RESTART_CMD='exec "$P5_HOOK" du-restart'
DU_READY_CMD='exec "$P5_HOOK" du-ready'
VICTIM_ENDPOINT_READY_CMD='exec "$P5_HOOK" endpoint-ready'
ATTACKER_ENDPOINT_READY_CMD='exec "$P5_HOOK" endpoint-ready'
VICTIM_REGISTRATION_CMD='exec "$P5_HOOK" registration'
VICTIM_TUN_CMD='exec "$P5_HOOK" tun'
VICTIM_PING_CMD='exec "$P5_HOOK" ping'
CU_TARGET_SNAPSHOT_CMD='exec "$P5_HOOK" snapshot'
CU_LOG_SLICE_START_CMD='exec "$P5_HOOK" log-start'
CU_LOG_SLICE_STOP_CMD='exec "$P5_HOOK" log-stop'
CU_CAPTURE_START_CMD='exec "$P5_HOOK" capture-start'
CU_CAPTURE_STOP_CMD='exec "$P5_HOOK" capture-stop'
CU_NETWORK_EVENTS_CMD='exec "$P5_HOOK" network-events'
