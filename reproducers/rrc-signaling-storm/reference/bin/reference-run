#!/usr/bin/env bash
# 원본 OAI rfsim UE를 같은-셀 broker 슬롯에 붙이는 실행 래퍼.
# 원본 바이너리와 공격 로직은 수정하지 않고, RF만 TCP rfsim <-> ZMQ로 변환한다.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUN_ID=${2:-ref-run}
DURATION_S=${REFERENCE_DURATION_S:-120}
BRIDGE="$ROOT/bin/oai-rfsim-zmq-bridge"
DEFAULT_BIN=/root/ref/oai-5g-rrc-storm-92980ce/cmake_targets/ran_build/build/nr-uesoftmodem
BIN=${REFERENCE_UE_BIN:-$DEFAULT_BIN}
CFG=${REFERENCE_UE_CFG:-/root/p1-secrets/ref-01.conf}
BRIDGE_TCP_PORT=${BRIDGE_TCP_PORT:-4043}
case ${1:-} in
  control|attack) ;;
  *) echo "사용법: $0 control|attack RUN_ID" >&2; exit 2 ;;
esac
[[ -f $BIN && -x $BIN ]] || { echo "reference UE 바이너리가 없습니다: $BIN" >&2; exit 2; }
[[ -f $CFG && ! -L $CFG ]] || { echo "reference UE 설정이 없습니다: $CFG" >&2; exit 2; }
[[ -f $BRIDGE && -x $BRIDGE ]] || { echo "rfsim 브리지가 없습니다: $BRIDGE" >&2; exit 2; }
export BRIDGE_TCP_PORT
python3 "$BRIDGE" >/tmp/reference-bridge.log 2>&1 &
BRIDGE_PID=$!
cleanup() { kill -INT -- "-$UE_PID" 2>/dev/null || true; sleep .5; kill -KILL -- "-$UE_PID" 2>/dev/null || true; kill "$BRIDGE_PID" 2>/dev/null || true; }
UE_PID=
trap cleanup EXIT INT TERM
sleep 1
setsid "$BIN" -O "$CFG" --rfsim --rfsimulator.serveraddr 127.0.0.1 \
  --rfsimulator.serverport "$BRIDGE_TCP_PORT" --band 78 -C 3489420000 \
  --numerology 1 -r 51 -E --ue-fo-compensation \
  >/tmp/reference-ue.log 2>&1 &
UE_PID=$!
wait "$UE_PID" 2>/dev/null || true
