+   ceiling needs 44.9/s, i.e. +7%. Giving each instance a disjoint slice removes
+   cross-instance collisions. 0 or 1 = off (upstream behaviour). */
+static int rss_preamble_partition(void)
+{
+  static int cached = -1;
+  if (cached < 0) {
+    const char *env = getenv("RSS_PREAMBLE_PART");
+    cached = env ? atoi(env) : 0;
+    if (cached < 0)
